{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tatrman.org/schemas/annotation-record/v1",
  "title": "AU annotation record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "document",
    "documentSha",
    "annotations"
  ],
  "properties": {
    "document": {
      "type": "string"
    },
    "documentSha": {
      "type": "string"
    },
    "annotations": {
      "type": "array",
      "items": {
        "oneOf": [
          {
            "$ref": "#/$defs/Section"
          },
          {
            "$ref": "#/$defs/Sentence"
          },
          {
            "$ref": "#/$defs/Mention"
          },
          {
            "$ref": "#/$defs/Coref"
          },
          {
            "$ref": "#/$defs/Role"
          },
          {
            "$ref": "#/$defs/Parameter"
          },
          {
            "$ref": "#/$defs/Person"
          },
          {
            "$ref": "#/$defs/Block"
          },
          {
            "$ref": "#/$defs/Link"
          },
          {
            "$ref": "#/$defs/Inexpressible"
          },
          {
            "$ref": "#/$defs/Verdict"
          }
        ]
      }
    }
  },
  "$defs": {
    "Section": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "id",
        "span",
        "title"
      ],
      "properties": {
        "type": {
          "const": "Section"
        },
        "id": {
          "type": "string"
        },
        "span": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 0
          },
          "minItems": 2,
          "maxItems": 2
        },
        "producer": {
          "type": "string"
        },
        "derivedFrom": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "title": {
          "type": "string"
        }
      }
    },
    "Sentence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "id",
        "span",
        "text"
      ],
      "properties": {
        "type": {
          "const": "Sentence"
        },
        "id": {
          "type": "string"
        },
        "span": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 0
          },
          "minItems": 2,
          "maxItems": 2
        },
        "producer": {
          "type": "string"
        },
        "derivedFrom": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "text": {
          "type": "string"
        }
      }
    },
    "Mention": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "id",
        "span",
        "objectRef",
        "lexiconMatch",
        "confidence"
      ],
      "properties": {
        "type": {
          "const": "Mention"
        },
        "id": {
          "type": "string"
        },
        "span": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 0
          },
          "minItems": 2,
          "maxItems": 2
        },
        "producer": {
          "type": "string"
        },
        "derivedFrom": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "objectRef": {
          "type": "string"
        },
        "lexiconMatch": {
          "type": "string"
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      }
    },
    "Coref": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "id",
        "span",
        "mention"
      ],
      "properties": {
        "type": {
          "const": "Coref"
        },
        "id": {
          "type": "string"
        },
        "span": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 0
          },
          "minItems": 2,
          "maxItems": 2
        },
        "producer": {
          "type": "string"
        },
        "derivedFrom": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "mention": {
          "type": "string"
        }
      }
    },
    "Role": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "id",
        "span",
        "role"
      ],
      "properties": {
        "type": {
          "const": "Role"
        },
        "id": {
          "type": "string"
        },
        "span": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 0
          },
          "minItems": 2,
          "maxItems": 2
        },
        "producer": {
          "type": "string"
        },
        "derivedFrom": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "role": {
          "type": "string"
        },
        "container": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "Parameter": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "id",
        "span",
        "name",
        "value",
        "valueType"
      ],
      "properties": {
        "type": {
          "const": "Parameter"
        },
        "id": {
          "type": "string"
        },
        "span": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 0
          },
          "minItems": 2,
          "maxItems": 2
        },
        "producer": {
          "type": "string"
        },
        "derivedFrom": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "name": {
          "type": "string"
        },
        "value": {
          "type": "string"
        },
        "valueType": {
          "type": "string"
        },
        "unit": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "Person": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "id",
        "span",
        "role"
      ],
      "properties": {
        "type": {
          "const": "Person"
        },
        "id": {
          "type": "string"
        },
        "span": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 0
          },
          "minItems": 2,
          "maxItems": 2
        },
        "producer": {
          "type": "string"
        },
        "derivedFrom": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "role": {
          "type": "string"
        }
      }
    },
    "Block": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "id",
        "span",
        "nodes"
      ],
      "properties": {
        "type": {
          "const": "Block"
        },
        "id": {
          "type": "string"
        },
        "span": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 0
          },
          "minItems": 2,
          "maxItems": 2
        },
        "producer": {
          "type": "string"
        },
        "derivedFrom": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "nodes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "Link": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "id",
        "span",
        "block",
        "sentences"
      ],
      "properties": {
        "type": {
          "const": "Link"
        },
        "id": {
          "type": "string"
        },
        "span": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 0
          },
          "minItems": 2,
          "maxItems": 2
        },
        "producer": {
          "type": "string"
        },
        "derivedFrom": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "block": {
          "type": "string"
        },
        "sentences": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "Inexpressible": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "id",
        "span",
        "why",
        "escapes"
      ],
      "properties": {
        "type": {
          "const": "Inexpressible"
        },
        "id": {
          "type": "string"
        },
        "span": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 0
          },
          "minItems": 2,
          "maxItems": 2
        },
        "producer": {
          "type": "string"
        },
        "derivedFrom": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "why": {
          "type": "string"
        },
        "escapes": {
          "type": "array",
          "items": {
            "enum": [
              "builtin",
              "foreign",
              "call",
              "turn",
              "restatement"
            ]
          }
        }
      }
    },
    "Verdict": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "id",
        "span",
        "target",
        "accepted"
      ],
      "properties": {
        "type": {
          "const": "Verdict"
        },
        "id": {
          "type": "string"
        },
        "span": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 0
          },
          "minItems": 2,
          "maxItems": 2
        },
        "producer": {
          "type": "string"
        },
        "derivedFrom": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "target": {
          "type": "string"
        },
        "accepted": {
          "type": "boolean"
        }
      }
    }
  }
}
