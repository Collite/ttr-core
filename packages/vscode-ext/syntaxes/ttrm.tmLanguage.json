{
  "name": "TTR",
  "fileTypes": [
    "ttr"
  ],
  "scopeName": "source.ttrm",
  "patterns": [
    {
      "include": "#comments"
    },
    {
      "include": "#embedded-blocks"
    },
    {
      "include": "#strings"
    },
    {
      "include": "#numbers"
    },
    {
      "include": "#def-kind"
    },
    {
      "include": "#keywords"
    },
    {
      "include": "#literals"
    },
    {
      "include": "#operators"
    }
  ],
  "repository": {
    "embedded-blocks": {
      "patterns": [
        {
          "name": "string.quoted.fenced.pl.ttrm",
          "begin": "(\"\"\")(pl)(?=[ \\t]*\\r?$)",
          "end": "\"\"\"",
          "beginCaptures": {
            "1": {
              "name": "punctuation.definition.string.begin.ttrm"
            },
            "2": {
              "name": "entity.name.tag.language.ttrm"
            }
          },
          "endCaptures": {
            "0": {
              "name": "punctuation.definition.string.end.ttrm"
            }
          },
          "contentName": "meta.embedded.block.pl.ttrm",
          "patterns": [
            {
              "include": "#pl-expression"
            }
          ]
        },
        {
          "begin": "\\b(definition|members|filter)\\s*(:)?\\s*(\"\"\")(?![a-zA-Z][a-zA-Z0-9-]*[ \\t]*\\r?$)",
          "end": "\"\"\"",
          "beginCaptures": {
            "1": {
              "name": "keyword.other.property.ttrm"
            },
            "2": {
              "name": "punctuation.separator.ttrm"
            },
            "3": {
              "name": "string.quoted.fenced.pl.ttrm punctuation.definition.string.begin.ttrm"
            }
          },
          "endCaptures": {
            "0": {
              "name": "string.quoted.fenced.pl.ttrm punctuation.definition.string.end.ttrm"
            }
          },
          "contentName": "meta.embedded.block.pl.ttrm",
          "patterns": [
            {
              "include": "#pl-expression"
            }
          ]
        },
        {
          "begin": "\\b(definition|members|filter)\\s*(:)?\\s*(\")(?!\"\")",
          "end": "\"",
          "beginCaptures": {
            "1": {
              "name": "keyword.other.property.ttrm"
            },
            "2": {
              "name": "punctuation.separator.ttrm"
            },
            "3": {
              "name": "string.quoted.double.ttrm punctuation.definition.string.begin.ttrm"
            }
          },
          "endCaptures": {
            "0": {
              "name": "string.quoted.double.ttrm punctuation.definition.string.end.ttrm"
            }
          },
          "contentName": "meta.embedded.line.pl.ttrm",
          "patterns": [
            {
              "name": "constant.character.escape.ttrm",
              "match": "\\\\."
            },
            {
              "include": "#pl-expression"
            }
          ]
        }
      ]
    },
    "pl-expression": {
      "patterns": [
        {
          "name": "string.quoted.single.ttrm",
          "begin": "'",
          "end": "'"
        },
        {
          "name": "constant.numeric.ttrm",
          "match": "\\b[0-9]+(\\.[0-9]+)?([eE][+-]?[0-9]+)?\\b"
        },
        {
          "name": "keyword.operator.word.ttrm",
          "match": "\\b(group|by|in|and|or|not|is|between|cast|as|distinct)\\b"
        },
        {
          "name": "keyword.control.conditional.ttrm",
          "match": "\\b(case|when|then|else|end)\\b"
        },
        {
          "name": "constant.language.ttrm",
          "match": "\\b(null|true|false)\\b"
        },
        {
          "name": "keyword.operator.ttrm",
          "match": "<=|>=|<>|!=|=|<|>|\\+|-|\\*|/|%"
        }
      ]
    },
    "def-kind": {
      "patterns": [
        {
          "match": "\\b(def)\\s+(kind)\\b",
          "captures": {
            "1": {
              "name": "keyword.control.def.ttrm"
            },
            "2": {
              "name": "keyword.other.kind.ttrm"
            }
          }
        }
      ]
    },
    "comments": {
      "patterns": [
        {
          "name": "comment.line.double-slash.ttrm",
          "match": "//.*$"
        },
        {
          "name": "comment.block.ttrm",
          "begin": "/\\*",
          "end": "\\*/"
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.triple.ttrm",
          "begin": "\"\"\"",
          "end": "\"\"\""
        },
        {
          "name": "string.quoted.double.ttrm",
          "begin": "\"",
          "end": "\"(?=[^\\\\])",
          "patterns": [
            {
              "name": "constant.character.escape.ttrm",
              "match": "\\\\."
            }
          ]
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.ttrm",
          "match": "-?[0-9]+(\\.[0-9]+)?([eE][+-]?[0-9]+)?"
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "include": "#keyword_control_def_ttrm"
        },
        {
          "include": "#keyword_control_package_ttrm"
        },
        {
          "include": "#keyword_control_import_ttrm"
        },
        {
          "include": "#keyword_declaration_graph_ttrm"
        },
        {
          "include": "#keyword_other_packages_ttrm"
        },
        {
          "include": "#keyword_other_entities_ttrm"
        },
        {
          "include": "#keyword_other_schema_ttrm"
        },
        {
          "include": "#keyword_other_kind_ttrm"
        },
        {
          "include": "#keyword_other_property_ttrm"
        },
        {
          "include": "#keyword_operator_word_ttrm"
        }
      ]
    },
    "literals": {
      "patterns": [
        {
          "include": "#support_type_primitive_ttrm"
        },
        {
          "include": "#constant_language_ttrm"
        },
        {
          "include": "#constant_language_indextype_ttrm"
        },
        {
          "include": "#constant_language_constrainttype_ttrm"
        },
        {
          "include": "#constant_language_querylang_ttrm"
        }
      ]
    },
    "keyword_control_def_ttrm": {
      "patterns": [
        {
          "name": "keyword.control.def.ttrm",
          "match": "\\b(def|schema|model|locale)\\b"
        }
      ]
    },
    "keyword_control_package_ttrm": {
      "patterns": [
        {
          "name": "keyword.control.package.ttrm",
          "match": "\\b(package)\\b"
        }
      ]
    },
    "keyword_control_import_ttrm": {
      "patterns": [
        {
          "name": "keyword.control.import.ttrm",
          "match": "\\b(import)\\b"
        }
      ]
    },
    "keyword_declaration_graph_ttrm": {
      "patterns": [
        {
          "name": "keyword.declaration.graph.ttrm",
          "match": "\\b(graph)\\b"
        }
      ]
    },
    "keyword_other_packages_ttrm": {
      "patterns": [
        {
          "name": "keyword.other.packages.ttrm",
          "match": "\\b(packages)\\b"
        }
      ]
    },
    "keyword_other_entities_ttrm": {
      "patterns": [
        {
          "name": "keyword.other.entities.ttrm",
          "match": "\\b(entities)\\b"
        }
      ]
    },
    "keyword_other_schema_ttrm": {
      "patterns": [
        {
          "name": "keyword.other.schema.ttrm",
          "match": "\\b(db|er|binding|cnc|md|query|world|automation|cn|lexicon)\\b"
        }
      ]
    },
    "keyword_other_kind_ttrm": {
      "patterns": [
        {
          "name": "keyword.other.kind.ttrm",
          "match": "\\b(project|area|map|table|view|column|index|constraint|fk|procedure|entity|attribute|relation|er2db_entity|er2db_attribute|er2db_relation|role|er2cnc_role|drill_map|domain|dimension|hierarchy|measure|cubelet|md2db_cubelet|md2db_domain|md2db_map|md2er_cubelet|engine|executor|storage|parameter|action|service|approval|program|recipe|identity|deployment|process|step|event|phase|quality|relation_type|cn2md_kind|cn2md_role|cn2md_quality|cn2md_event|cn2er_kind|cn2er_role|cn2er_event|cn2er_quality|cn2er_phase|cn2db_concept|term|pattern|example)\\b"
        }
      ]
    },
    "keyword_other_property_ttrm": {
      "patterns": [
        {
          "name": "keyword.other.property.ttrm",
          "match": "\\b(objects|layout|args|display|override|restrict|members|publish|kind|calc|key|hierarchies|levels|via|class|aggregation|validBy|grain|measures|shape|journaling|allocation|source|extends|hosts|staging|steps|transitions|transition|states|set|resolve|delivery|concept|involves|period|grounds|definition|value_space|extent|basis|default|sense_priority|description|tags|version|primaryKey|columns|indices|constraints|attributes|parameters|resultColumns|definitionSql|type|optional|isKey|searchable|indexed|labelPlural|nameAttribute|codeAttribute|aliases|cardinality|join|target|whereFilter|language|sourceText|length|precision|label|name|direction|displayLabel|valueLabels|roles|search|semantics|keywords|patterns|descriptions|examples|fuzzy|method|for|forms|match|from|to)\\b"
        }
      ]
    },
    "keyword_operator_word_ttrm": {
      "patterns": [
        {
          "name": "keyword.operator.word.ttrm",
          "match": "\\b(as)\\b"
        }
      ]
    },
    "support_type_primitive_ttrm": {
      "patterns": [
        {
          "name": "support.type.primitive.ttrm",
          "match": "\\b(text|int|float|bool|datetime|string|boolean|number|integer|double|object|list|char|varchar|decimal|date|timestamp)\\b"
        }
      ]
    },
    "constant_language_ttrm": {
      "patterns": [
        {
          "name": "constant.language.ttrm",
          "match": "\\b(null|true|false)\\b"
        }
      ]
    },
    "constant_language_indextype_ttrm": {
      "patterns": [
        {
          "name": "constant.language.indextype.ttrm",
          "match": "\\b(primary|secondary|ordered|btree|fulltext)\\b"
        }
      ]
    },
    "constant_language_constrainttype_ttrm": {
      "patterns": [
        {
          "name": "constant.language.constrainttype.ttrm",
          "match": "\\b(unique|notNull)\\b"
        }
      ]
    },
    "constant_language_querylang_ttrm": {
      "patterns": [
        {
          "name": "constant.language.querylang.ttrm",
          "match": "\\b(SQL|TRANSFORMATION_DSL|DATAFRAME_DSL|REL_NODE)\\b"
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "name": "punctuation.separator.ttrm",
          "match": "="
        },
        {
          "name": "punctuation.separator.ttrm",
          "match": ":"
        },
        {
          "name": "punctuation.separator.ttrm",
          "match": ","
        },
        {
          "name": "punctuation.separator.ttrm",
          "match": "\\."
        },
        {
          "name": "punctuation.section.braces.ttrm",
          "match": "\\{"
        },
        {
          "name": "punctuation.section.braces.ttrm",
          "match": "\\}"
        },
        {
          "name": "punctuation.section.brackets.ttrm",
          "match": "\\["
        },
        {
          "name": "punctuation.section.brackets.ttrm",
          "match": "\\]"
        },
        {
          "name": "punctuation.section.parens.ttrm",
          "match": "\\("
        },
        {
          "name": "punctuation.section.parens.ttrm",
          "match": "\\)"
        }
      ]
    }
  }
}