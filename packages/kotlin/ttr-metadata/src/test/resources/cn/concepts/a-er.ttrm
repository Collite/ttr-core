// CN-P2 S2.5 — the er face conformance fixtures 75 (`75-cn-concepts.ttrm`) and 76 (`76-cn-bindings.ttrm`) target,
// loaded beside them as one package, so their groundings resolve and the typed model can be read row by row
// (`CnModelSpec`). Invented Hartland-style names.
package hartland.concepts
model er

def entity party    { attributes: [ def attribute party_id { type: int, isKey: true } ] }
def entity customer { attributes: [ def attribute customer_id { type: int, isKey: true } ] }
def entity item {
    attributes: [
        def attribute item_id  { type: int, isKey: true },
        def attribute category { type: text }
    ]
}
def entity category_code { attributes: [ def attribute code { type: text, isKey: true } ] }
def entity category_closure {
    attributes: [
        def attribute ancestor_code   { type: text, isKey: true },
        def attribute descendant_code { type: text, isKey: true }
    ]
}
def entity channel_sales {
    attributes: [
        def attribute sale_id   { type: int, isKey: true },
        def attribute channel   { type: text },
        def attribute sold_date { type: date }
    ]
}
def entity inventory {
    attributes: [
        def attribute item_id          { type: int, isKey: true },
        def attribute warehouse        { type: int, isKey: true },
        def attribute quantity_on_hand { type: decimal }
    ]
}
def entity invoice { attributes: [ def attribute invoice_id { type: int, isKey: true } ] }
def entity order {
    attributes: [
        def attribute order_id       { type: int, isKey: true },
        def attribute state          { type: text },
        def attribute placed_date    { type: date },
        def attribute delivered_date { type: date }
    ]
}
def query placed_orders {
    sourceText: """sql
SELECT order_id FROM order WHERE state = 'placed'
"""
}
def entity placed_order {
    binding: { target: { query: er.query.placed_orders } },
    attributes: [ def attribute order_id { type: int, isKey: true } ]
}
def entity warehouse { attributes: [ def attribute warehouse_id { type: int, isKey: true } ] }
def entity region    { attributes: [ def attribute region_id { type: int, isKey: true } ] }
def entity stock_transfer {
    attributes: [
        def attribute transfer_id { type: int, isKey: true },
        def attribute item_id     { type: int },
        def attribute from_id     { type: int },
        def attribute to_id       { type: int },
        def attribute shipped_at  { type: date }
    ]
}
def relation rel_transfer_item    { from: er.entity.stock_transfer, to: er.entity.item }
def relation rel_transfer_from    { from: er.entity.stock_transfer, to: er.entity.warehouse }
def relation rel_transfer_to      { from: er.entity.stock_transfer, to: er.entity.warehouse }
def relation rel_warehouse_region { from: er.entity.warehouse, to: er.entity.region }
def relation rel_order_customer   { from: er.entity.order, to: er.entity.party }
