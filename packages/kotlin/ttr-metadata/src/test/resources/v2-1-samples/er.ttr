package samples.v2_1
import samples.v2_1.db.*

model er schema entity
// ---- item: entity-level mapping with mixed inline-column forms ----
def entity item { description: """Products (TPC-DS item) and their properties.""",
    displayLabel: { en: "Item", cs: "Produkt" },
    nameAttribute: product_name,
    codeAttribute: item_id,
    binding: {
        target: { table: db.dbo.item },
        columns: {
            sk:           i_item_sk,
            item_id:      { target: i_item_id },
            product_name: { target: { column: i_product_name } },
            category_id:  i_category_id,
            class_id:     i_class_id
        }
    },
    attributes: [
        def attribute sk           { type: int, isKey: true, description: "Unique item identifier" },
        def attribute item_id      { type: text, optional: true, description: "Unique item code" },
        def attribute product_name { type: text, optional: true, description: "Product name" },
        def attribute category_id  { type: int, optional: true, description: "Link to the parent category" },
        def attribute class_id     { type: int, optional: true, description: "Link to the parent class" }
    ]
}

// ---- category: attribute-level inline mappings (no entity-level mapping block) ----
def entity category { description: """Product categories.""",
    displayLabel: { en: "Category", cs: "Kategorie" },
    nameAttribute: category_name,
    attributes: [
        def attribute sk             { type: int, isKey: true, binding: i_category_id },
        def attribute category_code  { type: text, optional: true, binding: i_category_code },
        def attribute category_name  { type: text, optional: true, binding: { target: { column: i_category } } }
    ]
}

// ---- item_class: NO inline mappings — covered by explicit def er2db_* in map.ttr ----
def entity item_class { description: """Product classes within a category.""",
    nameAttribute: class_name,
    attributes: [
        def attribute sk           { type: int, isKey: true },
        def attribute class_code   { type: text, optional: true },
        def attribute class_name   { type: text, optional: true },
        def attribute category_id  { type: int, optional: true }
    ]
}

// ---- market: no inline mappings ----
def entity market { description: """Store markets.""",
    codeAttribute: market_code,
    attributes: [
        def attribute sk { type: int, isKey: true },
        def attribute market_code { type: text, optional: true },
        def attribute market_name { type: text, optional: true },
        def attribute division_id { type: int, optional: true }
    ]
}

// ---- division: no inline mappings ----
def entity division { description: """Divisions the markets belong to.""",
    nameAttribute: division_name,
    codeAttribute: division_code,
    attributes: [
        def attribute sk { type: int, isKey: true },
        def attribute division_code { type: text, optional: true },
        def attribute division_name { type: text, optional: true }
    ]
}

// ---- store: no inline mappings ----
def entity store { description: """Stores and their properties.""",
    nameAttribute: store_name,
    attributes: [
        def attribute sk { type: int, isKey: true },
        def attribute store_id { type: text, optional: true },
        def attribute store_name { type: text, optional: true },
        def attribute market_id { type: int, optional: true }
    ]
}

// ---- relations: item_in_category and item_in_class have inline mapping; others are explicit ----

// item -> category: bare-id FK form
def relation item_in_category { description: "An item belongs to its parent category",
    from: er.entity.item, to: er.entity.category,
    cardinality: { from: "0..*", to: "0..1" },
    join: [{ from: er.entity.item.category_id, to: er.entity.category.sk }],
    binding: db.dbo.fk_item_category
}

// item -> item_class: wrapped FK form
def relation item_in_class { description: "An item belongs to its parent class",
    from: er.entity.item, to: er.entity.item_class,
    cardinality: { from: "0..*", to: "1" },
    join: [{ from: er.entity.item.class_id, to: er.entity.item_class.sk }],
    binding: { fk: db.dbo.fk_item_class }
}

// item_class -> category: no inline mapping (explicit in map.ttr)
def relation class_in_category { description: "A class belongs to its parent category",
    from: er.entity.item_class, to: er.entity.category,
    cardinality: { from: "0..*", to: "1" },
    join: [{ from: er.entity.item_class.category_id, to: er.entity.category.sk }]
}

// market -> division: no inline mapping
def relation market_in_division { description: "A market belongs to a division",
    from: er.entity.market, to: er.entity.division,
    cardinality: { from: "1..*", to: "1" },
    join: [{ from: er.entity.market.division_id, to: er.entity.division.sk }]
}

// store -> market: no inline mapping
def relation store_in_market { description: "A store serves a market",
    from: er.entity.store, to: er.entity.market,
    cardinality: { from: "*", to: "1..*" },
    join: [{ from: er.entity.store.market_id, to: er.entity.market.sk }]
}