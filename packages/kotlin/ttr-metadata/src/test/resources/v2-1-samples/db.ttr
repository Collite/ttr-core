model db schema dbo
// A small slice of the Hartland demo database (TPC-DS shaped). `item` keeps its TPC-DS columns;
// its category and class, which TPC-DS denormalises onto `item`, are normalised out into
// `item_category` / `item_class`, and the store's market and division likewise into
// `store_market` / `store_division` — two small hierarchies: item -> class -> category and
// store -> market -> division.

def table item { description: "Products (TPC-DS item) and their properties",
    primaryKey: ["i_item_sk"],
    columns: [
        def column i_item_sk { type: int, isKey: true, description: "Unique item identifier" },
        def column i_item_id { type: text, optional: true, indexed: true, description: "Unique item code" },
        def column i_product_name { type: text, optional: true, description: "Product name" },
        def column i_category_id { type: int, optional: true, indexed: true, description: "FK to the parent category" },
        def column i_class_id { type: int, optional: true, indexed: true, description: "FK to the parent class" },
        def column i_manufact_id { type: int, optional: true, description: "Manufacturer identifier" }
    ],
    indices: [
        def index ix_item_id { columns: ["i_item_id"] },
        def index ix_item_category_class { columns: ["i_category_id", "i_class_id"] }
    ],
    constraints: [
        def constraint uq_item_id { type: unique, columns: ["i_item_id"] }
    ]
}

def table item_category { description: "Product categories",
    primaryKey: ["i_category_id"],
    columns: [
        def column i_category_id { type: int, isKey: true, description: "Unique category identifier" },
        def column i_category_code { type: text, optional: true, indexed: true, description: "Unique category code" },
        def column i_category { type: text, optional: true, description: "Category name" }
    ],
    indices: [
        def index ix_item_category_code { columns: ["i_category_code"] }
    ],
    constraints: [
        def constraint uq_item_category_code { type: unique, columns: ["i_category_code"] }
    ]
}

def table item_class { description: "Product classes within a category",
    primaryKey: ["i_class_id"],
    columns: [
        def column i_class_id { type: int, isKey: true, description: "Unique class identifier" },
        def column i_class_code { type: text, optional: true, indexed: true, description: "Unique class code" },
        def column i_class { type: text, optional: true, description: "Class name" },
        def column i_category_id { type: int, optional: true, indexed: true, description: "FK to the parent category" }
    ],
    indices: [
        def index ix_item_class_code { columns: ["i_class_code"] }
    ]
}

def table store_market { description: "Store markets",
    primaryKey: ["s_market_id"],
    columns: [
        def column s_market_id { type: int, isKey: true, description: "Unique market identifier" },
        def column s_market_code { type: text, optional: true, indexed: true, description: "Unique market code" },
        def column s_market_desc { type: text, optional: true, description: "Market name" },
        def column s_division_id { type: int, optional: true, indexed: true, description: "FK to the division" }
    ],
    indices: [
        def index ix_store_market_code { columns: ["s_market_code"] }
    ],
    constraints: [
        def constraint uq_store_market_code { type: unique, columns: ["s_market_code"] }
    ]
}

def table store_division { description: "Divisions the markets belong to",
    primaryKey: ["s_division_id"],
    columns: [
        def column s_division_id { type: int, isKey: true, description: "Unique division identifier" },
        def column s_division_code { type: text, optional: true, indexed: true, description: "Unique division code" },
        def column s_division_name { type: text, optional: true, description: "Division name" }
    ],
    indices: [
        def index ix_store_division_code { columns: ["s_division_code"] }
    ]
}

def table store { description: "Stores (TPC-DS store) and their properties",
    primaryKey: ["s_store_sk"],
    columns: [
        def column s_store_sk { type: int, isKey: true, description: "Unique store identifier" },
        def column s_store_id { type: text, optional: true, indexed: true, description: "Store code" },
        def column s_store_name { type: text, optional: true, description: "Store name" },
        def column s_market_id { type: int, optional: true, indexed: true, description: "FK to the market" }
    ],
    indices: [
        def index ix_store_id { columns: ["s_store_id"] }
    ],
    constraints: [
        def constraint uq_store_id { type: unique, columns: ["s_store_id"] }
    ]
}

def fk fk_item_category { description: "An item references its parent category",
    from: [db.dbo.item.i_category_id], to: [db.dbo.item_category.i_category_id]
}

def fk fk_item_class { description: "An item references its parent class",
    from: [db.dbo.item.i_class_id], to: [db.dbo.item_class.i_class_id]
}

def fk fk_class_category { description: "A class references its parent category",
    from: [db.dbo.item_class.i_category_id], to: [db.dbo.item_category.i_category_id]
}

def fk fk_market_division { description: "A market references its division",
    from: [db.dbo.store_market.s_division_id], to: [db.dbo.store_division.s_division_id]
}

def fk fk_store_market { description: "A store references its market",
    from: [db.dbo.store.s_market_id], to: [db.dbo.store_market.s_market_id]
}
