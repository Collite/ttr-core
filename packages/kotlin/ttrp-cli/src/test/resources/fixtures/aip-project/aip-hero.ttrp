// AG-P0 aip-hero: a two-check order-release program over a host-GENERATED model (query-bound + table-bound
// entities) against the `aip` (sql-text) world. The model is a slice of the Hartland demo database
// (TPC-DS): a marketplace order (`catalog_orders`, query-bound through its row filter) with its lines
// (`catalog_sales`), checked against the weekly stock of one distribution centre (`inventory`).
// Exercises every sql-text seam: logical rename over physical columns, an inline (`__filter` query)
// source, runtime params, a relation join in its logical spelling, select/calc, and semi / anti /
// cross joins.
uses world "hartland.worlds.platform"
import hartland.obchod.*

param objednávka_id: int
param centrum:       int = 1
param stav_k:        int

container objednávka(out hlavička, out řádky) target erp {
    o = load(objednávka) -> filter(číslo_objednávky = objednávka_id and centrum_podpory = 1)
    hlavička = o -> select(číslo_objednávky, id_zákazníka, datum_prodeje)
    r = load(řádek_objednávky)
    ro = join(left: r, right: o, type: inner, on: relation řádek_objednávka)
    řádky = ro -> select(číslo_objednávky, id_produktu, množství, cena)
}

container sklad(in řádky, out výpadky) target erp {
    zásoba = load(stav_zásoby) -> filter(id_centra = centrum and datum_stavu = stav_k)
    j = join(left: řádky, right: zásoba, type: left, on: left.id_produktu = right.id_produktu)
    d = j -> calc { disponibilní = coalesce(na_skladě, 0) }
    výpadky = d -> filter(disponibilní < množství) -> select(číslo_objednávky, id_produktu, množství, disponibilní)
}

container skladem(in řádky, out vedené, out nevedené) target erp {
    z = load(stav_zásoby)
    vedené   = join(left: řádky, right: z, type: semi, on: left.id_produktu = right.id_produktu)
    nevedené = join(left: řádky, right: z, type: anti, on: left.id_produktu = right.id_produktu)
}

container verdikt(in hlavička, in výpadky, out uvolnit) target erp {
    n = výpadky -> aggregate { n_výpadků = count(id_produktu) }
    v = join(left: hlavička, right: n, type: cross)
    uvolnit = filter(v, n_výpadků = 0)
}

objednávka.řádky    -> sklad.řádky
objednávka.řádky    -> skladem.řádky
objednávka.hlavička -> verdikt.hlavička
sklad.výpadky       -> verdikt.výpadky

verdikt.uvolnit  -> display(uvolnit)
sklad.výpadky    -> display(výpadky)
skladem.nevedené -> display(nevedené)
skladem.vedené   -> display(vedené)
