model binding
def cn2er_event   sale_g      { event: cn.Sale, target: er.entity.sale, period: { at: er.entity.sale.sold_on }, participants: { customer: [er.relation.rel_sale_customer], shipment: [er.relation.rel_shipment_sale] } }
