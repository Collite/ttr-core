// A `program` header beside a recipe: the header is TTRP-PRS-002 (TTR-P has no program header, S12);
// the recipe itself still parses; the header beside a recipe is also TTRP-REC-000 (AU-core-P1).
program release
uses world "hartland.worlds.demo"

recipe {
    key: order.order_number
    candidates placed(out orders) target erp """sql
        SELECT o.order_number FROM er.entity.order o
    """
}
