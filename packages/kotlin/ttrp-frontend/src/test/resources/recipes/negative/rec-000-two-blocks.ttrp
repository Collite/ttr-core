// Two recipe blocks in one document. It PARSES (two RecipeDecls); the second is TTRP-REC-000 ("one recipe
// per file") — a parse-time check (AU-core-P1), since a second recipe stops the compile.
uses world "hartland.worlds.demo"

recipe {
    key: order.order_number
    candidates a(out orders) target erp """sql
        SELECT o.order_number FROM er.entity.order o
    """
}

recipe {
    key: order.order_number
    candidates b(out orders) target erp """sql
        SELECT o.order_number FROM er.entity.order o
    """
}
