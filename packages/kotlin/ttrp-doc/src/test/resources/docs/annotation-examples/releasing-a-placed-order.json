      ],
      "title": "Releasing a placed order"
    },
    {
      "type": "Sentence",
      "id": "s_656",
      "span": [
        656,
        721
      ],
      "text": "Every placed order is checked before it is released for shipping."
    },
    {
      "type": "Sentence",
      "id": "s_971",
      "span": [
        971,
        1056
      ],
      "text": "Every line must be covered by current stock at the fulfilling center, with no outage."
    },
    {
      "type": "Sentence",
      "id": "s_1924",
      "span": [
        1924,
        1996
      ],
      "text": "The price must match the customer or channel price within the tolerance."
    },
    {
      "type": "Sentence",
      "id": "s_3171",
      "span": [
        3171,
        3228
      ],
      "text": "The customer must have no open invoice past its due date."
    },
    {
      "type": "Sentence",
      "id": "s_3503",
      "span": [
        3503,
        3598
      ],
      "text": "Hold for Sales when stock or prices fail; hold for AR when receivables fail. Otherwise release."
    },
