ot;recipe&quot;:&quot;release_order&quot;,&quot;route&quot;:&quot;hold_sales&quot;,&quot;flow&quot;:&quot;n_c689e3d71fdd2461cb1e&quot;,&quot;gateway&quot;:&quot;n_76fab166d3eed9b21a76&quot;,&quot;entry&quot;:&quot;n_0001d4efdf8046dd271d&quot;,&quot;task&quot;:&quot;n_edb1850318637a37b3ca&quot;},{&quot;recipe&quot;:&quot;release_order&quot;,&quot;route&quot;:&quot;hold_ar&quot;,&quot;flow&quot;:&quot;n_d70540f0c275f21f6894&quot;,&quot;gateway&quot;:&quot;n_76fab166d3eed9b21a76&quot;,&quot;entry&quot;:&quot;n_274b24e9b329767e7ae2&quot;,&quot;task&quot;:&quot;n_f9eaca6dafd8d7419fbd&quot;},{&quot;recipe&quot;:&quot;release_order&quot;,&quot;route&quot;:&quot;release_confirmed&quot;,&quot;flow&quot;:&quot;n_0eff7a11eca6f2ae698d&quot;,&quot;gateway&quot;:&quot;n_76fab166d3eed9b21a76&quot;,&quot;entry&quot;:&quot;n_d488b8041225b57e6e41&quot;,&quot;task&quot;:&quot;n_fc201d85bfebf5c4e987&quot;},{&quot;recipe&quot;:&quot;release_order&quot;,&quot;route&quot;:&quot;release&quot;,&quot;flow&quot;:&quot;n_aaa171c42f4fc93e2f3d&quot;,&quot;gateway&quot;:&quot;n_76fab166d3eed9b21a76&quot;,&quot;entry&quot;:&quot;n_8704da6c269681eb0d60&quot;,&quot;task&quot;:&quot;n_3458ceb18150acb9fe32&quot;}],&quot;scheduleTimezone&quot;:&quot;Europe/Prague&quot;}</ttr:contract>
    </bpmn:extensionElements>
    <bpmn:startEvent id="n_d48235c42437e4d72965" name="scheduled start">
      <bpmn:outgoing>n_a08a47c21d9b564cb2a9</bpmn:outgoing>
      <bpmn:timerEventDefinition>
        <bpmn:timeCycle>={next:min((for d in (for n in [-1,0,1,2,3,4,5,6,7,8] return today() + n * duration(&quot;P1D&quot;)) return date and time(string(d) + &quot;T06:00:00@Europe/Prague&quot;))[item &gt; now()]), seconds:next.time offset/duration(&quot;PT1S&quot;), hours:floor(abs(seconds)/3600), minutes:modulo(floor(abs(seconds)/60),60), hh:(if hours &lt; 10 then &quot;0&quot; else &quot;&quot;)+string(hours), mm:(if minutes &lt; 10 then &quot;0&quot; else &quot;&quot;)+string(minutes), offset:(if seconds &lt; 0 then &quot;-&quot; else &quot;+&quot;)+hh+&quot;:&quot;+mm, cycle:&quot;R/&quot; + substring(string(next),1,19) + offset + &quot;[Europe/Prague]/P1D&quot;}.cycle</bpmn:timeCycle>
      </bpmn:timerEventDefinition>
    </bpmn:startEvent>
