          <bpmn:incoming>n_9293be84212b224d6d52</bpmn:incoming>
        </bpmn:endEvent>
        <bpmn:intermediateCatchEvent id="n_6a6be4fa65ddb52f0f9e" name="honour Retry-After">
          <bpmn:incoming>n_76ba23db65dfc08e7f8f</bpmn:incoming>
          <bpmn:incoming>n_3f71f08cb0a7d6023a94</bpmn:incoming>
          <bpmn:outgoing>n_6deb5af63f4e25593759</bpmn:outgoing>
          <bpmn:timerEventDefinition>
            <bpmn:timeDuration>=&quot;PT&quot; + string(ttrHandleRetryAfter) + &quot;S&quot;</bpmn:timeDuration>
          </bpmn:timerEventDefinition>
        </bpmn:intermediateCatchEvent>
        <bpmn:serviceTask id="n_df0cb8fe953ac278f4e3" name="handle status">
          <bpmn:extensionElements>
