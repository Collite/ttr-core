    <bpmn:subProcess id="n_37cd645b0f8512494beb" name="Run batch">
      <bpmn:extensionElements>
        <zeebe:ioMapping>
          <zeebe:input source="=if ttrExecutionId != null then ttrExecutionId else uuid()" target="ttrExecutionId" />
          <zeebe:input source="=string(date and time(now(), &quot;Z&quot;))" target="ttrStepAt" />
          <zeebe:input source="={&quot;deployment&quot;:&quot;release_bpmn&quot;,&quot;port&quot;:{&quot;none&quot;:true},&quot;origin&quot;:&quot;engine&quot;,&quot;dryRun&quot;:true,&quot;recipeFingerprint&quot;:&quot;sha256:text&quot;,&quot;recipeValuesFingerprint&quot;:&quot;sha256:values&quot;,&quot;idempotencyKey&quot;:ttrExecutionId}" target="ttrOpenBody" />
          <zeebe:output source="=ttrOpen.runId" target="ttrPreviousRunId" />
          <zeebe:output source="=ttrOpen.runId" target="ttrAnchor" />
        </zeebe:ioMapping>
      </bpmn:extensionElements>
