              <zeebe:ioMapping>
                <zeebe:input source="=TTR_AUTOMATION_URL + &quot;/automation/runs/&quot; + ttrRunId + &quot;/actions/release/perform&quot;" target="url" />
                <zeebe:input source="POST" target="method" />
                <zeebe:input source="bearer" target="authentication.type" />
                <zeebe:input source="{{secrets.TTR_CONN_AUTOMATION}}" target="authentication.token" />
                <zeebe:input source="={&quot;keys&quot;:[ttrRow.order_number]}" target="body" />
              </zeebe:ioMapping>
              <zeebe:taskHeaders>
                <zeebe:header key="resultExpression" value="={ttrPerformed:response.body,ttrPerformedCode:response.status,ttrPerformedHeaders:response.headers,ttrPerformedRetryAfter:{header:if get value(response.headers,&quot;retry-after&quot;) != null then get value(response.headers,&quot;retry-after&quot;) else get value(response.headers,&quot;Retry-After&quot;), seconds:number(header), delay:if seconds != null and seconds &gt; 0 then seconds else if header != null then {parts:split(header,&quot; &quot;),month:index of([&quot;Jan&quot;,&quot;Feb&quot;,&quot;Mar&quot;,&quot;Apr&quot;,&quot;May&quot;,&quot;Jun&quot;,&quot;Jul&quot;,&quot;Aug&quot;,&quot;Sep&quot;,&quot;Oct&quot;,&quot;Nov&quot;,&quot;Dec&quot;],parts[3])[1],iso:if count(parts) = 6 and month != null and parts[6] = &quot;GMT&quot; then parts[4]+&quot;-&quot;+(if month &lt; 10 then &quot;0&quot; else &quot;&quot;)+string(month)+&quot;-&quot;+parts[2]+&quot;T&quot;+parts[5]+&quot;Z&quot; else null,instant:if iso != null then date and time(iso) else null,delay:if instant != null then max([1,ceiling((instant-now())/duration(&quot;PT1S&quot;))]) else 15}.delay else 15}.delay}" />
                <zeebe:header key="errorExpression" value="=if error.code = &quot;409&quot; then bpmnError(&quot;TTR_STALE&quot;, &quot;run API fingerprint refused&quot;) else if number(error.code) &gt;= 400 and number(error.code) &lt; 500 and not(list contains([&quot;408&quot;,&quot;429&quot;],error.code)) then bpmnError(&quot;TTR_REFUSED&quot;, &quot;run API HTTP &quot; + error.code) else if list contains([&quot;408&quot;,&quot;429&quot;],error.code) or number(error.code) &gt;= 500 then jobError(&quot;run API HTTP &quot; + error.code, {}, job.retries - 1, duration(&quot;PT&quot; + string({header:if get value(error.variables.response.headers,&quot;retry-after&quot;) != null then get value(error.variables.response.headers,&quot;retry-after&quot;) else get value(error.variables.response.headers,&quot;Retry-After&quot;), seconds:number(header), delay:if seconds != null and seconds &gt; 0 then seconds else if header != null then {parts:split(header,&quot; &quot;),month:index of([&quot;Jan&quot;,&quot;Feb&quot;,&quot;Mar&quot;,&quot;Apr&quot;,&quot;May&quot;,&quot;Jun&quot;,&quot;Jul&quot;,&quot;Aug&quot;,&quot;Sep&quot;,&quot;Oct&quot;,&quot;Nov&quot;,&quot;Dec&quot;],parts[3])[1],iso:if count(parts) = 6 and month != null and parts[6] = &quot;GMT&quot; then parts[4]+&quot;-&quot;+(if month &lt; 10 then &quot;0&quot; else &quot;&quot;)+string(month)+&quot;-&quot;+parts[2]+&quot;T&quot;+parts[5]+&quot;Z&quot; else null,instant:if iso != null then date and time(iso) else null,delay:if instant != null then max([1,ceiling((instant-now())/duration(&quot;PT1S&quot;))]) else 15}.delay else 15}.delay) + &quot;S&quot;)) else null" />
                <zeebe:header key="retryBackoff" value="PT15S" />
              </zeebe:taskHeaders>
            </bpmn:extensionElements>
