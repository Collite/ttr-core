      </bpmn:exclusiveGateway>
      <bpmn:subProcess id="n_09d33ddea76534274e5e" name="await other execution">
        <bpmn:extensionElements>
          <camunda:inputOutput>
            <camunda:inputParameter name="ttrHandleRetryAfter">${ttrOpenRetryAfter}</camunda:inputParameter>
