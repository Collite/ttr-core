      </bpmn:endEvent>
      <bpmn:serviceTask camunda:asyncBefore="true" id="n_d626ade7d8b9e41c9575" name="open">
        <bpmn:extensionElements>
          <camunda:connector>
            <camunda:connectorId>http-connector</camunda:connectorId>
            <camunda:inputOutput>
              <camunda:inputParameter name="method">POST</camunda:inputParameter>
              <camunda:inputParameter name="url">${TTR_CONN_AUTOMATION.url.concat(&quot;/automation/recipes/release_order/runs&quot;)}</camunda:inputParameter>
              <camunda:inputParameter name="headers">
                <camunda:map>
                  <camunda:entry key="Authorization">${'Bearer '.concat(TTR_CONN_AUTOMATION.token)}</camunda:entry>
                  <camunda:entry key="Content-Type">application/json</camunda:entry>
                </camunda:map>
              </camunda:inputParameter>
              <camunda:inputParameter name="payload">${(ttrOpenBody).toString()}</camunda:inputParameter>
              <camunda:outputParameter name="ttrOpen">${S(response)}</camunda:outputParameter>
              <camunda:outputParameter name="ttrOpenCode">${statusCode}</camunda:outputParameter>
              <camunda:outputParameter name="ttrOpenHeaders">${headers}</camunda:outputParameter>
              <camunda:outputParameter name="ttrOpenRetryAfter">
                <camunda:script scriptFormat="groovy">def value = headers['retry-after'] ?: headers['Retry-After']&#10;try {&#10;    def seconds = new BigDecimal(value.toString())&#10;    return seconds &gt; 0 ? seconds : 15&#10;} catch (Exception ignored) {&#10;    try {&#10;        def instant = java.time.ZonedDateTime.parse(value.toString(), java.time.format.DateTimeFormatter.RFC_1123_DATE_TIME).toInstant()&#10;        return Math.max(1L, (long) Math.ceil(java.time.Duration.between(java.time.Instant.now(), instant).toMillis() / 1000.0))&#10;    } catch (Exception absent) { return 15 }&#10;}</camunda:script>
              </camunda:outputParameter>
            </camunda:inputOutput>
          </camunda:connector>
          <camunda:failedJobRetryTimeCycle>R3/PT15S</camunda:failedJobRetryTimeCycle>
        </bpmn:extensionElements>
        <bpmn:incoming>n_8d44ea1fe3f5eaeac452</bpmn:incoming>
        <bpmn:outgoing>n_2a14a1f1ac153576ac8a</bpmn:outgoing>
      </bpmn:serviceTask>
