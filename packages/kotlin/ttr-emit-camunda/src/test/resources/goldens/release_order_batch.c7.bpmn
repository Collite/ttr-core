  <bpmn:process id="morning_release" isExecutable="true" name="morning_release">
    <bpmn:extensionElements>
      <ttr:contract>{&quot;schemaVersion&quot;:1,&quot;target&quot;:&quot;camunda_7&quot;,&quot;deployment&quot;:&quot;release_bpmn&quot;,&quot;recipes&quot;:[&quot;release_order&quot;],&quot;calls&quot;:[{&quot;task&quot;:&quot;n_d626ade7d8b9e41c9575&quot;,&quot;name&quot;:&quot;open&quot;,&quot;method&quot;:&quot;POST&quot;,&quot;path&quot;:&quot;/automation/recipes/release_order/runs&quot;,&quot;recipe&quot;:&quot;release_order&quot;,&quot;program&quot;:&quot;morning_release&quot;,&quot;mode&quot;:&quot;batch&quot;,&quot;arguments&quot;:{}},{&quot;task&quot;:&quot;n_df0cb8fe953ac278f4e3&quot;,&quot;name&quot;:&quot;status&quot;,&quot;method&quot;:&quot;GET&quot;,&quot;path&quot;:&quot;/automation/runs/{id}&quot;,&quot;recipe&quot;:&quot;release_order&quot;,&quot;program&quot;:&quot;morning_release&quot;,&quot;mode&quot;:&quot;batch&quot;,&quot;arguments&quot;:{}},{&quot;task&quot;:&quot;n_2283248ac9d1670fcccd&quot;,&quot;name&quot;:&quot;open&quot;,&quot;method&quot;:&quot;POST&quot;,&quot;path&quot;:&quot;/automation/recipes/release_order/runs&quot;,&quot;recipe&quot;:&quot;release_order&quot;,&quot;program&quot;:&quot;morning_release&quot;,&quot;mode&quot;:&quot;batch&quot;,&quot;arguments&quot;:{}},{&quot;task&quot;:&quot;n_7281ae840e332ec36afe&quot;,&quot;name&quot;:&quot;part&quot;,&quot;method&quot;:&quot;POST&quot;,&quot;path&quot;:&quot;/automation/runs/{id}/parts/candidates&quot;,&quot;recipe&quot;:&quot;release_order&quot;,&quot;program&quot;:&quot;morning_release&quot;,&quot;mode&quot;:&quot;batch&quot;,&quot;arguments&quot;:{&quot;part&quot;:&quot;candidates&quot;}},{&quot;task&quot;:&quot;n_050a6626f4bc412a3b8c&quot;,&quot;name&quot;:&quot;part&quot;,&quot;method&quot;:&quot;POST&quot;,&quot;path&quot;:&quot;/automation/runs/{id}/parts/shortfall&quot;,&quot;recipe&quot;:&quot;release_order&quot;,&quot;program&quot;:&quot;morning_release&quot;,&quot;mode&quot;:&quot;batch&quot;,&quot;arguments&quot;:{&quot;part&quot;:&quot;shortfall&quot;}},{&quot;tas