    <bpmn:subProcess id="n_37cd645b0f8512494beb" name="Run batch">
      <bpmn:extensionElements>
        <camunda:inputOutput>
          <camunda:inputParameter name="ttrExecutionId">${execution.processInstanceId}</camunda:inputParameter>
          <camunda:inputParameter name="ttrStepAt">${dateTime().toString()}</camunda:inputParameter>
          <camunda:inputParameter name="ttrOpenBody">${S('{}').prop(&quot;deployment&quot;,&quot;release_bpmn&quot;).prop(&quot;port&quot;,S('{}').prop(&quot;none&quot;,true)).prop(&quot;origin&quot;,&quot;engine&quot;).prop(&quot;dryRun&quot;,true).prop(&quot;recipeFingerprint&quot;,&quot;sha256:text&quot;).prop(&quot;recipeValuesFingerprint&quot;,&quot;sha256:values&quot;).prop(&quot;idempotencyKey&quot;,execution.processInstanceId)}</camunda:inputParameter>
          <camunda:outputParameter name="ttrPreviousRunId">${ttrOpen.prop(&quot;runId&quot;).stringValue()}</camunda:outputParameter>
          <camunda:outputParameter name="ttrAnchor">${ttrOpen.prop(&quot;runId&quot;).stringValue()}</camunda:outputParameter>
        </camunda:inputOutput>
