        <bpmn:serviceTask camunda:asyncBefore="true" id="n_df0cb8fe953ac278f4e3" name="handle status">
          <bpmn:extensionElements>
            <camunda:connector>
              <camunda:connectorId>http-connector</camunda:connectorId>
              <camunda:inputOutput>
                <camunda:inputParameter name="method">GET</camunda:inputParameter>
                <camunda:inputParameter name="url">${TTR_CONN_AUTOMATION.url.concat(&quot;/automation/runs/&quot;).concat(ttrOpen.prop(&quot;runId&quot;).stringValue()).concat(&quot;&quot;)}</camunda:inputParameter>
                <camunda:inputParameter name="headers">
                  <camunda:map>
                    <camunda:entry key="Authorization">${'Bearer '.concat(TTR_CONN_AUTOMATION.token)}</camunda:entry>
                    <camunda:entry key="Content-Type">application/json</camunda:entry>
                  </camunda:map>
                </camunda:inputParameter>
                <camunda:outputParameter name="ttrHandle">${S(response)}</camunda:outputParameter>
                <camunda:outputParameter name="ttrHandleCode">${statusCode}</camunda:outputParameter>
                <camunda:outputParameter name="ttrHandleHeaders">${headers}</camunda:outputParameter>
                <camunda:outputParameter name="ttrHandleRetryAfter">
                  <camunda:script scriptFormat="groovy">def value = headers['retry-after'] ?: headers['Retry-After']&#10;try {&#10;    def seconds = new BigDecimal(value.toString())&#10;    return seconds &gt; 0 ? seconds : 15&#10;} catch (Exception ignored) {&#10;    try {&#10;        def instant = java.time.ZonedDateTime.parse(value.toString(), java.time.format.DateTimeFormatter.RFC_1123_DATE_TIME).toInstant()&#10;        return Math.max(1L, (long) Math.ceil(java.time.Duration.between(java.time.Instant.now(), instant).toMillis() / 1000.0))&#10;    } catch (Exception absent) { return 15 }&#10;}</camunda:script>
                </camunda:outputParameter>
              </camunda:inputOutput>
            </camunda:connector>
            <camunda:failedJobRetryTimeCycle>R3/PT15S</camunda:failedJobRetryTimeCycle>
          </bpmn:extensionElements>
          <bpmn:incoming>n_6deb5af63f4e25593759</bpmn:incoming>
          <bpmn:outgoing>n_beb8a473425b603a1eb6</bpmn:outgoing>
        </bpmn:serviceTask>
        <bpmn:exclusiveGateway default="n_3f71f08cb0a7d6023a94" id="n_158eb0ce7b2c613f906b" name="handle terminal">
          <bpmn:incoming>n_beb8a473425b603a1eb6</bpmn:incoming>
          <bpmn:outgoing>n_9293be84212b224d6d52</bpmn:outgoing>
          <bpmn:outgoing>n_3f71f08cb0a7d6023a94</bpmn:outgoing>
