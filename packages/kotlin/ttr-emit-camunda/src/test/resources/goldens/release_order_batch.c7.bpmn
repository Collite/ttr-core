ot;recipe&quot;:&quot;release_order&quot;,&quot;route&quot;:&quot;hold_sales&quot;,&quot;flow&quot;:&quot;n_0fd68b2c5e254aff8121&quot;,&quot;gateway&quot;:&quot;n_76fab166d3eed9b21a76&quot;,&quot;task&quot;:&quot;n_ae8b8a23ede856b5831d&quot;},{&quot;recipe&quot;:&quot;release_order&quot;,&quot;route&quot;:&quot;hold_ar&quot;,&quot;flow&quot;:&quot;n_9c81184ac17e80cc8e49&quot;,&quot;gateway&quot;:&quot;n_76fab166d3eed9b21a76&quot;,&quot;task&quot;:&quot;n_0c673f48f14766abb9b4&quot;},{&quot;recipe&quot;:&quot;release_order&quot;,&quot;route&quot;:&quot;release_confirmed&quot;,&quot;flow&quot;:&quot;n_f24504f0911a868b493b&quot;,&quot;gateway&quot;:&quot;n_76fab166d3eed9b21a76&quot;,&quot;task&quot;:&quot;n_817d7925248df5ef6e9b&quot;},{&quot;recipe&quot;:&quot;release_order&quot;,&quot;route&quot;:&quot;release&quot;,&quot;flow&quot;:&quot;n_840444b8dd364212674d&quot;,&quot;gateway&quot;:&quot;n_76fab166d3eed9b21a76&quot;,&quot;task&quot;:&quot;n_a4d5a14b9d649a5921eb&quot;}],&quot;scheduleTimezone&quot;:&quot;Europe/Prague&quot;}</ttr:contract>
