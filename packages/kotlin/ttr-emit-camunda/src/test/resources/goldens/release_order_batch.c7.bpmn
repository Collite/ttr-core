          <bpmn:incoming>n_9293be84212b224d6d52</bpmn:incoming>
        </bpmn:endEvent>
        <bpmn:intermediateCatchEvent id="n_6a6be4fa65ddb52f0f9e" name="honour Retry-After">
          <bpmn:incoming>n_76ba23db65dfc08e7f8f</bpmn:incoming>
