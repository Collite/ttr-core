            <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=if ttrPage.rows instance of list then ttrPage.rowCount = ttrExpectedRows and count(ttrPage.rows) &gt; 0 and count(ttrPage.rows) + ttrPageState.offset &lt;= ttrExpectedRows else false</bpmn:conditionExpression>
