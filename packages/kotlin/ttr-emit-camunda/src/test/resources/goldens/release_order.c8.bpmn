          <bpmn:incoming>n_70f0ab7aeeccd464ba00</bpmn:incoming>
        </bpmn:endEvent>
        <bpmn:intermediateCatchEvent id="n_fe72f75b3fe15463f992" name="honour Retry-After">
          <bpmn:incoming>n_8bc37bf9757282b8bcea</bpmn:incoming>
          <bpmn:incoming>n_8f9492e23c0c8c7f4bad</bpmn:incoming>
          <bpmn:outgoing>n_80d913f21bfcf7d5b39e</bpmn:outgoing>
          <bpmn:timerEventDefinition>
            <bpmn:timeDuration>=&quot;PT&quot; + string(ttrHandleRetryAfter) + &quot;S&quot;</bpmn:timeDuration>
          </bpmn:timerEventDefinition>
        </bpmn:intermediateCatchEvent>
        <bpmn:serviceTask id="n_c4ec94b7181d57836764" name="handle status">
          <bpmn:extensionElements>
            <zeebe:taskDefinition retries="3" type="io.camunda:http-json:1" />
            <zeebe:ioMapping>
              <zeebe:input source="=TTR_AUTOMATION_URL + &quot;/automation/runs/&quot; + ttrOpen.runId + &quot;&quot;" target="url" />
              <zeebe:input source="GET" target="method" />
              <zeebe:input source="bearer" target="authentication.type" />
              <zeebe:input source="{{secrets.TTR_CONN_AUTOMATION}}" target="authentication.token" />
