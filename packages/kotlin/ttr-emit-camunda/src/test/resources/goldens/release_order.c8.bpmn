    <bpmn:subProcess id="n_16a2990f2582a64c7f43" name="release_on_placement">
      <bpmn:extensionElements>
        <zeebe:ioMapping>
          <zeebe:input source="=if ttrInput.at != null then ttrInput.at else string(date and time(now(), &quot;Z&quot;))" target="ttrStepAt" />
          <zeebe:input source="={&quot;deployment&quot;:&quot;release_bpmn&quot;,&quot;port&quot;:context merge([{&quot;key&quot;:ttrInput.key},{at:ttrStepAt}]),&quot;origin&quot;:&quot;engine&quot;,&quot;dryRun&quot;:true,&quot;recipeFingerprint&quot;:&quot;sha256:text&quot;,&quot;recipeValuesFingerprint&quot;:&quot;sha256:values&quot;}" target="ttrOpenBody" />
          <zeebe:output source="=ttrOpen.runId" target="ttrPreviousRunId" />
          <zeebe:output source="=ttrOpen.runId" target="ttrAnchor" />
        </zeebe:ioMapping>
      </bpmn:extensionElements>
