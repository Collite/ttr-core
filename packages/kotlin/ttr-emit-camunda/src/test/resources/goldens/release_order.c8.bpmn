&quot;release_order&quot;,&quot;program&quot;:&quot;release_on_placement&quot;,&quot;mode&quot;:&quot;on_event&quot;,&quot;arguments&quot;:{}}],&quot;routes&quot;:[{&quot;recipe&quot;:&quot;release_order&quot;,&quot;route&quot;:&quot;hold_sales&quot;,&quot;flow&quot;:&quot;n_71db0ec5b265db8eaa8a&quot;,&quot;gateway&quot;:&quot;n_be14bcf3ef203eb1da49&quot;,&quot;entry&quot;:&quot;n_fc976e1ea8e2789ef645&quot;,&quot;task&quot;:&quot;n_052028bfe62ad65fa919&quot;},{&quot;recipe&quot;:&quot;release_order&quot;,&quot;route&quot;:&quot;hold_ar&quot;,&quot;flow&quot;:&quot;n_2c6263d6992844f6999e&quot;,&quot;gateway&quot;:&quot;n_be14bcf3ef203eb1da49&quot;,&quot;entry&quot;:&quot;n_a1260e6797efc6b3b218&quot;,&quot;task&quot;:&quot;n_1a2bfb5358da488d95a2&quot;},{&quot;recipe&quot;:&quot;release_order&quot;,&quot;route&quot;:&quot;release_confirmed&quot;,&quot;flow&quot;:&quot;n_128ae562a88bf29a0e30&quot;,&quot;gateway&quot;:&quot;n_be14bcf3ef203eb1da49&quot;,&quot;entry&quot;:&quot;n_8725c2e19a9902f35774&quot;,&quot;task&quot;:&quot;n_0cf853efb4281e2d7b87&quot;},{&quot;recipe&quot;:&quot;release_order&quot;,&quot;route&quot;:&quot;release&quot;,&quot;flow&quot;:&quot;n_f7572d245ccb843854f6&quot;,&quot;gateway&quot;:&quot;n_be14bcf3ef203eb1da49&quot;,&quot;entry&quot;:&quot;n_f8747763f66d3d8ffd3f&quot;,&quot;task&quot;:&quot;n_793a130591dc45f9af35&quot;}]}</ttr:contract>
