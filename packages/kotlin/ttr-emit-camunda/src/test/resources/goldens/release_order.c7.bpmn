        <bpmn:exclusiveGateway default="n_8f9492e23c0c8c7f4bad" id="n_fe3b000671bc26adaf0d" name="handle terminal">
          <bpmn:incoming>n_17fc2d11cc165b26aa36</bpmn:incoming>
          <bpmn:outgoing>n_70f0ab7aeeccd464ba00</bpmn:outgoing>
