    <bpmn:subProcess id="n_16a2990f2582a64c7f43" name="release_on_placement">
      <bpmn:extensionElements>
        <camunda:inputOutput>
          <camunda:inputParameter name="ttrStepAt">${ttrInput['at'] != null ? ttrInput['at'] : dateTime().toString()}</camunda:inputParameter>
          <camunda:inputParameter name="ttrOpenBody">${S('{}').prop(&quot;deployment&quot;,&quot;release_bpmn&quot;).prop(&quot;port&quot;,S('{}').prop(&quot;key&quot;,ttrInput['key']).prop('at', ttrStepAt)).prop(&quot;origin&quot;,&quot;engine&quot;).prop(&quot;dryRun&quot;,true).prop(&quot;recipeFingerprint&quot;,&quot;sha256:text&quot;).prop(&quot;recipeValuesFingerprint&quot;,&quot;sha256:values&quot;)}</camunda:inputParameter>
          <camunda:outputParameter name="ttrPreviousRunId">${ttrOpen.prop(&quot;runId&quot;).stringValue()}</camunda:outputParameter>
          <camunda:outputParameter name="ttrAnchor">${ttrOpen.prop(&quot;runId&quot;).stringValue()}</camunda:outputParameter>
        </camunda:inputOutput>
