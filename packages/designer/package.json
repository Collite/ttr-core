{
  "name": "@tatrman/designer-core",
  "version": "0.1.2",
  "private": false,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/package/types/index.d.ts",
      "import": "./dist/package/index.js"
    },
    "./extensions": {
      "types": "./dist/package/types/extensions.d.ts",
      "import": "./dist/package/extensions.js"
    },
    "./designer.css": "./dist/package/designer.css"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build && pnpm run build:library && tsc --emitDeclarationOnly && node ../../scripts/prepare-designer-package.mjs",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "test": "node ../../scripts/test-designer.mjs",
    "build:library": "DESIGNER_LIBRARY=1 vite build --config vite.library.config.ts"
  },
  "dependencies": {
    "@tatrman/canvas-core": "workspace:*",
    "@tatrman/deep-links": "workspace:*",
    "@tatrman/lsp": "workspace:*",
    "@tatrman/parser": "workspace:*",
    "@tatrman/perspectives": "workspace:*",
    "@tatrman/tokens": "workspace:*",
    "@xyflow/react": "^12.3.5",
    "apache-arrow": "^21.1.0",
    "vscode-jsonrpc": "^8.2.1",
    "vscode-languageserver-protocol": "^3.17.5",
    "vscode-languageserver-textdocument": "^1.0.12",
    "vscode-languageserver-types": "^3.17.5",
    "yaml": "2.9.1"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.0",
    "autoprefixer": "^10.4.0",
    "jsdom": "^29.1.1",
    "postcss": "^8.4.0",
    "tailwindcss": "^3.4.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vite": "^6.0.0",
    "vitest": "^4.1.6",
    "vscode-languageserver": "^9.0.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "main": "./dist/package/index.js",
  "types": "./dist/package/types/index.d.ts",
  "files": [
    "dist/package",
    "LICENSE",
    "NOTICE"
  ],
  "license": "Apache-2.0",
  "homepage": "https://github.com/Collite/ttr-core#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Collite/ttr-core.git",
    "directory": "packages/designer"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "sideEffects": [
    "**/*.css"
  ],
  "publishConfig": {
    "registry": "https://registry.npmjs.org",
    "access": "public"
  }
}
