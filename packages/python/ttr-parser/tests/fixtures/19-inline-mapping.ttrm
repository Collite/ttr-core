model er

def entity item {
    binding: {
        target: { table: db.dbo.item },
        columns: {
            sk: i_item_sk,
            item_id: { target: i_item_id },
            product_name: { target: { column: i_product_name } }
        }
    },
    attributes: [
        def attribute sk { type: int, isKey: true },
        def attribute item_id { type: text },
        def attribute product_name { type: text }
    ]
}
