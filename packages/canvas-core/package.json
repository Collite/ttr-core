{
  "name": "@tatrman/canvas-core",
  "version": "0.1.2",
  "private": false,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "scripts": {
    "build": "tsc && node ../../scripts/prepare-ts-package.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "lint": "eslint src"
  },
  "dependencies": {
    "elkjs": "^0.9.3"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  },
  "license": "Apache-2.0",
  "homepage": "https://github.com/Collite/ttr-core#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Collite/ttr-core.git",
    "directory": "packages/canvas-core"
  },
  "files": [
    "dist/package",
    "LICENSE",
    "NOTICE"
  ],
  "sideEffects": false,
  "publishConfig": {
    "registry": "https://registry.npmjs.org",
    "access": "public",
    "main": "./dist/package/index.js",
    "types": "./dist/package/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/package/index.d.ts",
        "import": "./dist/package/index.js"
      }
    }
  }
}
