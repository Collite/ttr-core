package billing.invoicing

model er

def relation item_in_category { description: "An item belongs to its parent category",
    from: er.entity.item, to: billing.products.er.entity.category,
    cardinality: { from: "0..*", to: "0..1" },
    join: [{ from: er.entity.item.category_id, to: billing.products.er.entity.category.sk }]
}