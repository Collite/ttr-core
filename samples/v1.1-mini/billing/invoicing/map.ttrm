package billing.invoicing

model binding

def er2db_entity item_map { entity: er.entity.item, target: { table: db.dbo.item } }
def er2db_entity category_map { entity: er.entity.category, target: { table: db.dbo.item_category } }
def er2db_entity item_class_map { entity: er.entity.item_class, target: { table: db.dbo.item_class } }
def er2db_entity market_map { entity: er.entity.market, target: { table: db.dbo.store_market } }
def er2db_entity division_map { entity: er.entity.division, target: { table: db.dbo.store_division } }
def er2db_entity store_map { entity: er.entity.store, target: { table: db.dbo.store } }

def er2db_attribute item.sk { attribute: er.entity.item.sk, target: { column: db.dbo.item.i_item_sk } }
def er2db_attribute item.item_id { attribute: er.entity.item.item_id, target: { column: db.dbo.item.i_item_id } }
def er2db_attribute item.product_name { attribute: er.entity.item.product_name, target: { column: db.dbo.item.i_product_name } }
def er2db_attribute item.category_id { attribute: er.entity.item.category_id, target: { column: db.dbo.item.i_category_id } }
def er2db_attribute item.class_id { attribute: er.entity.item.class_id, target: { column: db.dbo.item.i_class_id } }

def er2db_attribute category.sk { attribute: er.entity.category.sk, target: { column: db.dbo.item_category.i_category_id } }
def er2db_attribute category.category_code { attribute: er.entity.category.category_code, target: { column: db.dbo.item_category.i_category_code } }
def er2db_attribute category.category_name { attribute: er.entity.category.category_name, target: { column: db.dbo.item_category.i_category } }

def er2db_attribute item_class.sk { attribute: er.entity.item_class.sk, target: { column: db.dbo.item_class.i_class_id } }
def er2db_attribute item_class.category_id { attribute: er.entity.item_class.category_id, target: { column: db.dbo.item_class.i_category_id } }

def er2db_attribute market.sk { attribute: er.entity.market.sk, target: { column: db.dbo.store_market.s_market_id } }
def er2db_attribute market.division_id { attribute: er.entity.market.division_id, target: { column: db.dbo.store_market.s_division_id } }

def er2db_attribute division.sk { attribute: er.entity.division.sk, target: { column: db.dbo.store_division.s_division_id } }

def er2db_attribute store.sk { attribute: er.entity.store.sk, target: { column: db.dbo.store.s_store_sk } }
def er2db_attribute store.market_id { attribute: er.entity.store.market_id, target: { column: db.dbo.store.s_market_id } }