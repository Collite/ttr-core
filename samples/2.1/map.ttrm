package samples.v2_1

model binding

// item_class: no inline mapping — covered explicitly
def er2db_entity item_class { entity: er.entity.item_class, target: { table: db.dbo.table.item_class } }

// market: no inline mapping
def er2db_entity market { entity: er.entity.market, target: { table: db.dbo.table.store_market } }

// division: no inline mapping
def er2db_entity division { entity: er.entity.division, target: { table: db.dbo.table.store_division } }

// store: no inline mapping
def er2db_entity store { entity: er.entity.store, target: { table: db.dbo.table.store } }

// item_class attributes
def er2db_attribute item_class.sk { attribute: er.entity.item_class.sk, target: { column: db.dbo.table.item_class.i_class_id } }
def er2db_attribute item_class.category_id { attribute: er.entity.item_class.category_id, target: { column: db.dbo.table.item_class.i_category_id } }

// market attributes
def er2db_attribute market.sk { attribute: er.entity.market.sk, target: { column: db.dbo.table.store_market.s_market_id } }
def er2db_attribute market.division_id { attribute: er.entity.market.division_id, target: { column: db.dbo.table.store_market.s_division_id } }

// division attributes
def er2db_attribute division.sk { attribute: er.entity.division.sk, target: { column: db.dbo.table.store_division.s_division_id } }

// store attributes
def er2db_attribute store.sk { attribute: er.entity.store.sk, target: { column: db.dbo.table.store.s_store_sk } }
def er2db_attribute store.market_id { attribute: er.entity.store.market_id, target: { column: db.dbo.table.store.s_market_id } }

// item_class -> category relation (no inline mapping — explicit here)
def er2db_relation class_in_category { relation: er.entity.class_in_category, fk: db.dbo.fk.fk_class_category }

// market -> division (no inline mapping)
def er2db_relation market_in_division { relation: er.entity.market_in_division, fk: db.dbo.fk.fk_market_division }

// store -> market (no inline mapping)
def er2db_relation store_in_market { relation: er.entity.store_in_market, fk: db.dbo.fk.fk_store_market }
