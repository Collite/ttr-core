def entity store { description: """Stores (TPC-DS store), versioned by validity (s_rec_start_date / s_rec_end_date).
The store entity reads only the currently valid version of each record.
""", labelPlural: "Stores", aliases: ["shop", "outlet"],
    attributes: [
        def attribute sk { type: int, isKey: true, description: "Unique store identifier", },
        def attribute store_id { type: text, optional: true, description: "Unique store code", },
        def attribute store_name { type: text, optional: true, description: "Store name, the human-readable label", search { searchable method: TYPOS(1) }, },
        def attribute rec_start_date { type: date, optional: true, description: "Start of validity of this record version", },
        def attribute rec_end_date { type: date, optional: true, description: "End of validity of this record version (NULL = current)", },
        def attribute closed_date { type: int, optional: true, description: "Date the store closed", },
        def attribute number_employees { type: int, optional: true, description: "Number of employees", },
        def attribute floor_space { type: int, optional: true, description: "Selling floor space in square feet", },
        def attribute hours { type: text, optional: true, description: "Opening hours", },
        def attribute manager { type: text, optional: true, description: "Store manager", },
        def attribute market_id { type: int, optional: true, description: "Link to the store's market", },
        def attribute geography_class { type: text, optional: true, description: "Geography class of the location", },
        def attribute city { type: text, optional: true, description: "The city the store is located in", },
        def attribute county { type: text, optional: true, description: "The county the store is located in", },
        def attribute state { type: text, optional: true, description: "The state the store is located in", search { searchable method: EXACT }, },
        def attribute zip { type: text, optional: true, description: "ZIP code", },
        def attribute country { type: text, optional: true, description: "Country", },
        def attribute tax_precentage { type: float, optional: true, description: "Sales tax rate in percent", },
    ]
}

