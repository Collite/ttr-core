}

def relation rel_web_sales_ship_addr { description: "Shipping address of a web order", from: er.entity.web_sales, to: er.entity.customer_address, cardinality: { from: "0..*", to: "0..1" }, join: [{ from: er.entity.web_sales.ship_addr, to: er.entity.customer_address.sk }],
}

def relation rel_web_sales_ship_customer { description: "A web order is shipped to a customer", from: er.entity.web_sales, to: er.entity.customer, cardinality: { from: "0..*", to: "0..1" }, join: [{ from: er.entity.web_sales.ship_customer, to: er.entity.customer.sk }],
}

def relation rel_web_sales_ship_date { description: "A web order was shipped on a calendar day", from: er.entity.web_sales, to: er.entity.date_dim, cardinality: { from: "0..*", to: "0..1" }, join: [{ from: er.entity.web_sales.ship_date, to: er.entity.date_dim.sk }],
}

def relation rel_web_sales_ship_mode { description: "A web order ships with a ship mode", from: er.entity.web_sales, to: er.entity.ship_mode, cardinality: { from: "0..*", to: "0..1" }, join: [{ from: er.entity.web_sales.ship_mode, to: er.entity.ship_mode.sk }],
}

def relation rel_web_sales_time { description: "A web order was placed at a time of day", from: er.entity.web_sales, to: er.entity.time_dim, cardinality: { from: "0..*", to: "1" }, join: [{ from: er.entity.web_sales.sold_time, to: er.entity.time_dim.sk }],
}

def relation rel_web_sales_warehouse { description: "A web order is fulfilled by a distribution center", from: er.entity.web_sales, to: er.entity.warehouse, cardinality: { from: "0..*", to: "1" }, join: [{ from: er.entity.web_sales.warehouse, to: er.entity.warehouse.sk }],
}

def relation rel_web_sales_web_page { description: "A web order was placed on a web page", from: er.entity.web_sales, to: er.entity.web_page, cardinality: { from: "0..*", to: "0..1" }, join: [{ from: er.entity.web_sales.web_page, to: er.entity.web_page.sk }],
}

def relation rel_web_sales_web_site { description: "A web order was placed on a web site", from: er.entity.web_sales, to: er.entity.web_site, cardinality: { from: "0..*", to: "1" }, join: [{ from: er.entity.web_sales.web_site, to: er.entity.web_site.sk }],
}

def relation rel_web_site_close_date { description: "A web site was shut down on a calendar day", from: er.entity.web_site, to: er.entity.date_dim, cardinality: { from: "0..*", to: "0..1" }, join: [{ from: er.entity.web_site.close_date, to: er.entity.date_dim.sk }],
}

def relation rel_web_site_open_date { description: "A web site went live on a calendar day", from: er.entity.web_site, to: er.entity.date_dim, cardinality: { from: "0..*", to: "1" }, join: [{ from: er.entity.web_site.open_date, to: er.entity.date_dim.sk }],
}

def relation store_in_market { description: "A store serves a market", from: er.entity.store, to: er.entity.market, cardinality: { from: "0..*", to: "1" }, join: [{ from: er.entity.store.market_id, to: er.entity.market.sk }],
}
