def relation brand_by_manufacturer { description: "A brand is owned by a manufacturer", from: er.entity.brand, to: er.entity.manufacturer, cardinality: { from: "0..*", to: "1" }, join: [{ from: er.entity.brand.manufact_id, to: er.entity.manufacturer.sk }],
}

def relation brand_in_class { description: "A brand belongs to a class", from: er.entity.brand, to: er.entity.item_class, cardinality: { from: "0..*", to: "1" }, join: [{ from: er.entity.brand.class_id, to: er.entity.item_class.sk }],
}

def relation class_in_category { description: "A class belongs to its parent category", from: er.entity.item_class, to: er.entity.category, cardinality: { from: "0..*", to: "1" }, join: [{ from: er.entity.item_class.category_id, to: er.entity.category.sk }],
}

def relation division_in_company { description: "A division belongs to a company", from: er.entity.division, to: er.entity.company, cardinality: { from: "0..*", to: "1" }, join: [{ from: er.entity.division.company_id, to: er.entity.company.sk }],
}

def relation item_by_manufacturer { description: "An item is made by a manufacturer", from: er.entity.item, to: er.entity.manufacturer, cardinality: { from: "0..*", to: "1" }, join: [{ from: er.entity.item.manufact_id, to: er.entity.manufacturer.sk }],
}

def relation item_in_category { description: "An item belongs to its parent category", from: er.entity.item, to: er.entity.category, cardinality: { from: "0..*", to: "0..1" }, join: [{ from: er.entity.item.category_id, to: er.entity.category.sk }],
}

def relation item_in_class { description: "An item belongs to its parent class", from: er.entity.item, to: er.entity.item_class, cardinality: { from: "0..*", to: "1" }, join: [{ from: er.entity.item.class_id, to: er.entity.item_class.sk }],
}

def relation item_of_brand { description: "An item is sold under a brand", from: er.entity.item, to: er.entity.brand, cardinality: { from: "0..*", to: "1" }, join: [{ from: er.entity.item.brand_id, to: er.entity.brand.sk }],
}

def relation market_in_division { description: "A market belongs to a division", from: er.entity.market, to: er.entity.division, cardinality: { from: "0..*", to: "1" }, join: [{ from: er.entity.market.division_id, to: er.entity.division.sk }],
}

def relation rel_call_center_closed_date { description: "A seller support center closed on a calendar day", from: er.entity.call_center, to: er.entity.date_dim, cardinality: { from: "0..*", to: "0..1" }, join: [{ from: er.entity.call_center.closed_date, to: er.entity.date_dim.sk }],
}

def relation rel_call_center_open_date { description: "A seller support center opened on a calendar day", from: er.entity.call_center, to: er.entity.date_dim, cardinality: { from: "0..*", to: "1" }, join: [{ from: er.entity.call_center.open_date, to: er.entity.date_dim.sk }],
}

def relation rel_catalog_page_end_date { description: "A catalog is valid until a calendar day", from: er.entity.catalog_page, to: er.entity.date_dim, cardinality: { from: "0..*", to: "1" }, join: [{ from: er.entity.catalog_page.end_date, to: er.entity.date_dim.sk }],
}

def relation rel_catalog_page_start_date { description: "A catalog is valid from a calendar day", from: er.entity.catalog_page, to: er.entity.date_dim, cardinality: { from: "0..*", to: "1" }, join: [{ from: er.entity.catalog_page.start_date, to: er.entity.date_dim.sk }],
}

def relation rel_catalog_returns_addr { description: "Address a marketplace return came from", from: er.entity.catalog_returns, to: er.entity.customer_address, cardinality: { from: "0..*", to: "0..1" }, join: [{ from: er.entity.catalog_returns.returning_addr, to: er.entity.customer_address.sk }],
}

def relation rel_catalog_returns_callcenter { description: "A marketplace return was handled by a seller support center", from: er.entity.catalog_returns, to: er.entity.call_center, cardinality: { from: "0..*", to: "0..1" }, join: [{ from: er.entity.catalog_returns.call_center, to: er.entity.call_center.sk }],
}

def relation rel_catalog_returns_catalog_page { description: "Catalog page of the original marketplace order", from: er.entity.catalog_returns, to: er.entity.catalog_page, cardinality: { from: "0..*", to: "0..1" }, join: [{ from: er.entity.catalog_returns.catalog_page, to: er.entity.catalog_page.sk }],
}

def relation rel_catalog_returns_customer { description: "A marketplace return was made by a customer", from: er.entity.catalog_returns, to: er.entity.customer, cardinality: { from: "0..*", to: "0..1" }, join: [{ from: er.entity.catalog_returns.customer, to: er.entity.customer.sk }],
}

