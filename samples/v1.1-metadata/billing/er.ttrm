def entity store_returns { description: """Stores-channel returns (TPC-DS store_returns).
""", labelPlural: "Store Returns",
    attributes: [
        def attribute returned_date { type: int, optional: true, description: "Return date — FK to the calendar", },
        def attribute return_time { type: int, optional: true, description: "Return time of day — FK to the time dimension", },
        def attribute item { type: int, isKey: true, description: "Returned product", },
        def attribute customer { type: int, optional: true, description: "Returning customer", },
        def attribute cdemo { type: int, optional: true, description: "Customer demographics at the time of the return", },
        def attribute addr { type: int, optional: true, description: "Customer address at the time of the return", },
        def attribute store { type: int, optional: true, description: "Store accepting the return", },
        def attribute reason { type: int, optional: true, description: "Return reason", },
        def attribute ticket_number { type: int, isKey: true, description: "Original sales ticket number — pairs this return with its sale", },
        def attribute return_quantity { type: int, optional: true, description: "Units returned on this line", },
        def attribute return_amt { type: decimal, optional: true, description: "Refunded amount of the line, excluding tax", },
        def attribute return_tax { type: decimal, optional: true, description: "Tax on the refunded amount", },
        def attribute fee { type: decimal, optional: true, description: "Return handling fee", },
        def attribute refunded_cash { type: decimal, optional: true, description: "Amount refunded in cash", },
        def attribute store_credit { type: decimal, optional: true, description: "Amount refunded as store credit", },
        def attribute net_loss { type: decimal, optional: true, description: "Net loss of the return", },
    ]
}

def entity store_sales { description: """Stores-channel sales lines (TPC-DS store_sales).
One row = one line of a sales ticket; the line revenue is ss_ext_sales_price.
""", labelPlural: "Store Sales", aliases: ["store revenue", "in-store sales"],
    attributes: [
        def attribute sold_date { type: int, optional: true, description: "Sale date — FK to the calendar", },
        def attribute sold_time { type: int, optional: true, description: "Sale time of day — FK to the time dimension", },
        def attribute item { type: int, isKey: true, description: "Sold product", },
        def attribute customer { type: int, optional: true, description: "Buying customer", },
        def attribute cdemo { type: int, optional: true, description: "Customer demographics at the time of the sale", },
        def attribute hdemo { type: int, optional: true, description: "Household demographics at the time of the sale", },
        def attribute addr { type: int, optional: true, description: "Customer address at the time of the sale", },
        def attribute store { type: int, optional: true, description: "Selling store", },
        def attribute promo { type: int, optional: true, description: "Promotion applied to this line, if any", },
        def attribute ticket_number { type: int, isKey: true, description: "Sales ticket number; one ticket = one basket", },
        def attribute quantity { type: int, optional: true, description: "Units sold on this line", },
        def attribute list_price { type: decimal, optional: true, description: "List price per unit", },
        def attribute sales_price { type: decimal, optional: true, description: "Sales price per unit after discount", },
        def attribute ext_discount_amt { type: decimal, optional: true, description: "Total discount of the line", },
        def attribute ext_sales_price { type: decimal, optional: true, description: "Extended sales price of the line (unit price × quantity) — the revenue amount", },
        def attribute ext_tax { type: decimal, optional: true, description: "Tax of the line", },
        def attribute net_paid { type: decimal, optional: true, description: "Net amount paid, excluding tax", },
        def attribute net_profit { type: decimal, optional: true, description: "Net profit of the line", },
    ]
}

