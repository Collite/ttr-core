package billing

model er

// Logical layer over the Hartland TPC-DS slice, in Hartland's own er style: an entity per table,
// attributes named after the prefix-stripped physical columns.

def entity active_promotion { description: """Promotions with an active discount.
""",
    attributes: [
        def attribute sk { type: int, isKey: true, description: "Unique promotion identifier", },
        def attribute promo_id { type: text, optional: true, description: "Promotion code", },
        def attribute promo_name { type: text, optional: true, description: "Promotion name, the human-readable label", search { searchable: true }, },
        def attribute start_date { type: int, optional: true, description: "Promotion start date", },
        def attribute end_date { type: int, optional: true, description: "Promotion end date", },
        def attribute item { type: int, optional: true, description: "Featured product of the promotion", },
    ]
}

def entity brand { description: """Product brands — normalised out of the i_brand* columns of item.
""", labelPlural: "Brands",
    attributes: [
        def attribute sk { type: int, isKey: true, description: "Unique brand identifier", },
        def attribute brand_name { type: text, optional: true, description: "Brand name", search { searchable: true }, },
        def attribute class_id { type: int, optional: true, description: "Class the brand belongs to", },
        def attribute manufact_id { type: int, optional: true, description: "Manufacturer owning the brand", },
    ]
}

def entity bulk_catalog_order { description: """Marketplace order lines of at least 50 units.
""",
    attributes: [
        def attribute item { type: int, isKey: true, description: "Ordered product", },
        def attribute order_number { type: int, isKey: true, description: "Marketplace order number; one order = one basket", },
        def attribute customer { type: int, optional: true, description: "Billed customer", },
        def attribute quantity { type: int, optional: true, description: "Units ordered on this line", },
        def attribute ext_sales_price { type: decimal, optional: true, description: "Extended sales price of the line — the revenue amount", },
    ]
}

def entity call_center { description: """Seller support centers handling marketplace orders (TPC-DS call_center).
""", labelPlural: "Seller Support Centers",
    attributes: [
        def attribute sk { type: int, isKey: true, description: "Unique seller support center identifier", },
        def attribute call_center_id { type: text, optional: true, description: "Seller support center code", },
        def attribute name { type: text, optional: true, description: "Seller support center name, the human-readable label", search { searchable: true }, },
        def attribute rec_start_date { type: date, optional: true, description: "Start of validity of this record version", },
        def attribute rec_end_date { type: date, optional: true, description: "End of validity of this record version (NULL = current)", },
        def attribute open_date { type: int, optional: true, description: "Date the center opened", },
        def attribute closed_date { type: int, optional: true, description: "Date the center closed", },
        def attribute class { type: text, optional: true, description: "Size class of the center", valueLabels: { "small": { en: "small" }, "medium": { en: "medium" }, "large": { en: "large" } }, },
        def attribute employees { type: int, optional: true, description: "Number of employees", },
        def attribute hours { type: text, optional: true, description: "Operating hours", },
        def attribute manager { type: text, optional: true, description: "Center manager", },
        def attribute mkt_id { type: int, optional: true, description: "Identifier of the market served", },
        def attribute division_name { type: text, optional: true, description: "Division of the center", },
        def attribute city { type: text, optional: true, description: "City", },
        def attribute state { type: text, optional: true, description: "State", },
        def attribute country { type: text, optional: true, description: "Country", },
    ]
}

def entity catalog_page { description: """Pages of the marketplace catalogs (TPC-DS catalog_page).
""",
    attributes: [
        def attribute sk { type: int, isKey: true, description: "Unique catalog page identifier", },
        def attribute catalog_page_id { type: text, optional: true, description: "Catalog page code", },
        def attribute start_date { type: int, optional: true, description: "Start of validity of the catalog", },
        def attribute end_date { type: int, optional: true, description: "End of validity of the catalog", },
        def attribute department { type: text, optional: true, description: "Department", },
        def attribute catalog_number { type: int, optional: true, description: "Catalog number", },
        def attribute catalog_page_number { type: int, optional: true, description: "Page number within the catalog", },
        def attribute page_description { type: text, optional: true, description: "Page description", },
        def attribute catalog_type { type: text, optional: true, description: "Catalog periodicity", valueLabels: { "monthly": { en: "monthly" }, "quarterly": { en: "quarterly" }, "bi-annual": { en: "bi-annual" } }, },
    ]
}

def entity catalog_returns { description: """Marketplace-channel returns (TPC-DS catalog_returns).
Note: the amount column is cr_return_amount, not cr_return_amt like its siblings.
""", labelPlural: "Marketplace Returns",
    attributes: [
        def attribute returned_date { type: int, optional: true, description: "Return date — FK to the calendar", },
        def attribute item { type: int, isKey: true, description: "Returned product", },
        def attribute refunded_customer { type: int, optional: true, description: "Customer the amount was refunded to", },
        def attribute customer { type: int, optional: true, description: "Returning customer", },
        def attribute returning_addr { type: int, optional: true, description: "Address the goods were returned from", },
        def attribute call_center { type: int, optional: true, description: "Seller support center that handled the return", },
        def attribute catalog_page { type: int, optional: true, description: "Catalog page of the original order", },
        def attribute ship_mode { type: int, optional: true, description: "Return ship mode", },
        def attribute warehouse { type: int, optional: true, description: "Distribution center processing the return", },
        def attribute reason { type: int, optional: true, description: "Return reason", },
        def attribute order_number { type: int, isKey: true, description: "Original marketplace order number — pairs this return with its sale", },
        def attribute return_quantity { type: int, optional: true, description: "Units returned on this line", },
        def attribute return_amt { type: decimal, optional: true, description: "Refunded amount of the line, excluding tax", },
        def attribute return_ship_cost { type: decimal, optional: true, description: "Return shipping cost", },
        def attribute refunded_cash { type: decimal, optional: true, description: "Amount refunded in cash", },
        def attribute net_loss { type: decimal, optional: true, description: "Net loss of the return", },
    ]
}

def entity catalog_sales { description: """Marketplace-channel sales lines (TPC-DS catalog_sales).
An order is handled by a seller support center and shipped by a distribution center.
""", labelPlural: "Marketplace Orders", aliases: ["marketplace revenue", "third-party orders"],
    attributes: [
        def attribute sold_date { type: int, optional: true, description: "Order date — FK to the calendar", },
        def attribute sold_time { type: int, optional: true, description: "Order time of day — FK to the time dimension", },
        def attribute ship_date { type: int, optional: true, description: "Ship date — FK to the calendar", },
        def attribute customer { type: int, optional: true, description: "Billed customer", },
        def attribute bill_cdemo { type: int, optional: true, description: "Demographics of the billed customer", },
        def attribute addr { type: int, optional: true, description: "Billing address", },
        def attribute ship_customer { type: int, optional: true, description: "Customer the order is shipped to", },
        def attribute ship_addr { type: int, optional: true, description: "Shipping address", },
        def attribute call_center { type: int, optional: true, description: "Seller support center handling the order", },
        def attribute catalog_page { type: int, optional: true, description: "Catalog page the order came from", },
        def attribute ship_mode { type: int, optional: true, description: "Ship mode", },
        def attribute warehouse { type: int, optional: true, description: "Fulfilling distribution center", },
        def attribute item { type: int, isKey: true, description: "Ordered product", },
        def attribute promo { type: int, optional: true, description: "Promotion applied to this line, if any", },
        def attribute order_number { type: int, isKey: true, description: "Marketplace order number; one order = one basket", },
        def attribute quantity { type: int, optional: true, description: "Units ordered on this line", },
        def attribute list_price { type: decimal, optional: true, description: "List price per unit", },
        def attribute sales_price { type: decimal, optional: true, description: "Sales price per unit after discount", },
        def attribute ext_sales_price { type: decimal, optional: true, description: "Extended sales price of the line — the revenue amount", },
        def attribute ext_ship_cost { type: decimal, optional: true, description: "Shipping cost of the line", },
        def attribute net_paid { type: decimal, optional: true, description: "Net amount paid, excluding tax", },
        def attribute net_profit { type: decimal, optional: true, description: "Net profit of the line", },
    ]
}

def entity category { description: """Product categories — normalised out of the denormalised i_category* columns of item.
""", labelPlural: "Categories",
    attributes: [
        def attribute sk { type: int, isKey: true, description: "Unique category identifier", },
        def attribute category_code { type: text, optional: true, description: "Unique category code", },
        def attribute category_name { type: text, optional: true, description: "Category name", search { searchable: true }, },
    ]
}

def entity channel_sales { description: """All-channel sales lines — store, web and marketplace sales in one relation, labelled by channel.
Derived from store_sales, web_sales and catalog_sales; the one object on which revenue and
units sold can be compared by channel.
""", labelPlural: "Channel Sales",
    attributes: [
        def attribute channel { type: text, isKey: true, description: "Sales channel", valueLabels: { "store": { en: "store" }, "web": { en: "web" }, "marketplace": { en: "marketplace" } }, },
        def attribute sold_date { type: int, isKey: true, description: "Sale date — FK to the calendar", },
        def attribute item { type: int, isKey: true, description: "Sold product", },
        def attribute customer { type: int, isKey: true, description: "Buying customer", },
        def attribute quantity { type: int, optional: true, description: "Units sold on this line", },
        def attribute ext_sales_price { type: decimal, optional: true, description: "Extended sales price of the line — the revenue amount", },
        def attribute warehouse { type: int, optional: true, description: "Fulfilling distribution center of a web or marketplace line; NULL on a store line", },
    ]
}

def entity company { description: """Companies operating the stores — normalised out of the s_company_* columns of store.
""",
    attributes: [
        def attribute sk { type: int, isKey: true, description: "Unique company identifier", },
        def attribute company_name { type: text, optional: true, description: "Company name", },
    ]
}

def entity customer { description: """Customers of all sales channels (TPC-DS customer).
""", labelPlural: "Customers", aliases: ["buyer", "shopper"],
    attributes: [
        def attribute sk { type: int, isKey: true, description: "Unique customer identifier", },
        def attribute customer_id { type: text, optional: true, description: "Unique customer code", search { searchable method: EXACT }, },
        def attribute cdemo { type: int, optional: true, description: "Current customer demographics", },
        def attribute hdemo { type: int, optional: true, description: "Current household demographics", },
        def attribute addr { type: int, optional: true, description: "Current address", },
        def attribute first_shipto_date { type: int, optional: true, description: "Date of the first shipment", },
        def attribute first_sales_date { type: int, optional: true, description: "Date of the first purchase", },
        def attribute salutation { type: text, optional: true, description: "Salutation", },
        def attribute first_name { type: text, optional: true, description: "First name", },
        def attribute last_name { type: text, optional: true, description: "Last name", search { searchable: true, keywords: { en: ["surname", "family name"] } }, },
        def attribute preferred_cust_flag { type: text, optional: true, description: "Preferred customer flag", valueLabels: { "Y": { en: "yes" }, "N": { en: "no" } }, },
        def attribute birth_day { type: int, optional: true, description: "Day of birth", },
        def attribute birth_month { type: int, optional: true, description: "Month of birth", },
        def attribute birth_year { type: int, optional: true, description: "Year of birth; age is derived at query time", },
        def attribute birth_country { type: text, optional: true, description: "Country of birth", },
        def attribute email_address { type: text, optional: true, description: "E-mail address", },
        def attribute last_review_date { type: int, optional: true, description: "Date of the customer's last review", },
    ]
}

def entity customer_address { description: """Customer addresses (TPC-DS customer_address).
""", labelPlural: "Customer Addresses",
    attributes: [
        def attribute sk { type: int, isKey: true, description: "Unique address identifier", },
        def attribute address_id { type: text, optional: true, description: "Address code", },
        def attribute street_number { type: text, optional: true, description: "Street number", },
        def attribute street_name { type: text, optional: true, description: "Street name", },
        def attribute city { type: text, optional: true, description: "City of the address", search { searchable: true }, },
        def attribute county { type: text, optional: true, description: "County of the address", },
        def attribute state { type: text, optional: true, description: "Two-letter state code of the address", search { searchable method: EXACT }, },
        def attribute zip { type: text, optional: true, description: "ZIP code", },
        def attribute country { type: text, optional: true, description: "Country", },
        def attribute gmt_offset { type: float, optional: true, description: "Offset from GMT in hours", },
        def attribute location_type { type: text, optional: true, description: "Location type", valueLabels: { "single family": { en: "single family" }, "apartment": { en: "apartment" }, "condo": { en: "condo" } }, },
    ]
}

def entity customer_channel_summary { description: """Yearly summary of a customer's purchases by sales channel.
""",
    attributes: [
        def attribute customer { type: int, isKey: true, description: "Customer", },
        def attribute year { type: int, isKey: true, description: "Year", },
        def attribute store_sales { type: decimal, optional: true, description: "Revenue in stores", },
        def attribute web_sales { type: decimal, optional: true, description: "Revenue on the web", },
        def attribute catalog_sales { type: decimal, optional: true, description: "Revenue on the marketplace", },
        def attribute return_amt { type: decimal, optional: true, description: "Amount returned across channels", },
        def attribute orders { type: int, optional: true, description: "Number of baskets (tickets and orders)", },
    ]
}

def entity customer_demographics { description: """Customer demographic profiles (TPC-DS customer_demographics).
""",
    attributes: [
        def attribute sk { type: int, isKey: true, description: "Unique demographic profile identifier", },
        def attribute gender { type: text, optional: true, description: "Gender code", valueLabels: { "M": { en: "male" }, "F": { en: "female" } }, },
        def attribute marital_status { type: text, optional: true, description: "Marital status code", valueLabels: { "S": { en: "single" }, "M": { en: "married" }, "D": { en: "divorced" }, "W": { en: "widowed" }, "U": { en: "unknown" } }, },
        def attribute education_status { type: text, optional: true, description: "Highest education level", },
        def attribute purchase_estimate { type: int, optional: true, description: "Estimated yearly purchases", },
        def attribute credit_rating { type: text, optional: true, description: "Credit rating", },
        def attribute dep_count { type: int, optional: true, description: "Number of dependants", },
        def attribute dep_employed_count { type: int, optional: true, description: "Number of employed dependants", },
        def attribute dep_college_count { type: int, optional: true, description: "Number of dependants in college", },
    ]
}

def entity date_dim { description: """Calendar — one row per day (TPC-DS date_dim).
Every date link of a fact points here through a *_date_sk column.
""", labelPlural: "Days",
    attributes: [
        def attribute sk { type: int, isKey: true, description: "Unique day identifier", },
        def attribute date_id { type: text, optional: true, description: "Day code", },
        def attribute cal_date { type: date, optional: true, description: "Calendar date. The primary grain of the calendar", },
        def attribute month_seq { type: int, optional: true, description: "Absolute month number", },
        def attribute week_seq { type: int, optional: true, description: "Absolute week number from the beginning of the calendar", },
        def attribute quarter_seq { type: int, optional: true, description: "Absolute quarter number", },
        def attribute year { type: int, optional: true, description: "Year of the calendar date", },
        def attribute day_of_week { type: int, optional: true, description: "Day of week (0 = Sunday)", },
        def attribute month { type: int, optional: true, description: "Month of year, 1-12", },
        def attribute day_of_month { type: int, optional: true, description: "Day of month", },
        def attribute quarter { type: int, optional: true, description: "Quarter of year, 1-4", },
        def attribute fy_year { type: int, optional: true, description: "Fiscal year", },
        def attribute day_name { type: text, optional: true, description: "Name of the day of the week", },
        def attribute quarter_name { type: text, optional: true, description: "Quarter name (e.g. 2025Q1)", },
        def attribute holiday { type: text, optional: true, description: "Is this a holiday? Y/N", valueLabels: { "Y": { en: "yes" }, "N": { en: "no" } }, },
        def attribute weekend { type: text, optional: true, description: "Is this a weekend? Y/N", valueLabels: { "Y": { en: "yes" }, "N": { en: "no" } }, },
        def attribute first_dom { type: int, optional: true, description: "Day identifier of the first day of the month", },
        def attribute same_day_ly { type: int, optional: true, description: "Day identifier of the same day last year", },
    ]
}

def entity division { description: """Divisions the markets belong to — normalised out of the s_division_* columns of store.
""",
    attributes: [
        def attribute sk { type: int, isKey: true, description: "Unique division identifier", },
        def attribute division_code { type: text, optional: true, description: "Unique division code", },
        def attribute division_name { type: text, optional: true, description: "Division name", },
        def attribute company_id { type: int, optional: true, description: "Link to the company", },
    ]
}

def entity email_promotion { description: """Promotions run by e-mail.
""",
    attributes: [
        def attribute sk { type: int, isKey: true, description: "Unique promotion identifier", },
        def attribute promo_id { type: text, optional: true, description: "Promotion code", },
        def attribute promo_name { type: text, optional: true, description: "Promotion name, the human-readable label", search { searchable: true }, },
        def attribute purpose { type: text, optional: true, description: "Purpose of the promotion", },
    ]
}

def entity express_ship_mode { description: """Ship modes delivering by the next day.
""",
    attributes: [
        def attribute sk { type: int, isKey: true, description: "Unique ship mode identifier", },
        def attribute ship_type { type: text, optional: true, description: "Ship mode type", valueLabels: { "EXPRESS": { en: "express" }, "NEXT DAY": { en: "next day" }, "REGULAR": { en: "regular" }, "LIBRARY": { en: "library" } }, },
        def attribute carrier { type: text, optional: true, description: "Carrier", },
    ]
}

def entity foreign_address { description: """Customer addresses outside the home country.
""",
    attributes: [
        def attribute sk { type: int, isKey: true, description: "Unique address identifier", },
        def attribute city { type: text, optional: true, description: "City of the address", search { searchable: true }, },
        def attribute country { type: text, optional: true, description: "Country", },
    ]
}

def entity holiday { description: """Public holidays.
""",
    attributes: [
        def attribute sk { type: int, isKey: true, description: "Unique day identifier", },
        def attribute cal_date { type: date, optional: true, description: "Calendar date. The primary grain of the calendar", },
        def attribute year { type: int, optional: true, description: "Year of the calendar date", },
        def attribute month { type: int, optional: true, description: "Month of year, 1-12", },
        def attribute day_name { type: text, optional: true, description: "Name of the day of the week", },
    ]
}

def entity household_demographics { description: """Household demographic profiles (TPC-DS household_demographics).
""",
    attributes: [
        def attribute sk { type: int, isKey: true, description: "Unique household profile identifier", },
        def attribute income_band { type: int, optional: true, description: "Income band of the household", },
        def attribute buy_potential { type: text, optional: true, description: "Household buying-potential label (e.g. '>10000', 'Unknown')", },
        def attribute dep_count { type: int, optional: true, description: "Number of dependants", },
        def attribute vehicle_count { type: int, optional: true, description: "Number of vehicles in the household", },
    ]
}

def entity income_band { description: """Household income bands (TPC-DS income_band).
""",
    attributes: [
        def attribute sk { type: int, isKey: true, description: "Unique income band identifier", },
        def attribute lower_bound { type: int, optional: true, description: "Lower bound of the yearly income range (USD)", },
        def attribute upper_bound { type: int, optional: true, description: "Upper bound of the yearly income range (USD)", },
    ]
}

def entity inventory { description: """Weekly on-hand snapshots per distribution center and item (TPC-DS inventory).
Semi-additive: stock levels must not be added across snapshots.
""", labelPlural: "Inventory Snapshots",
    attributes: [
        def attribute as_of_date { type: int, isKey: true, description: "Weekly snapshot date — FK to the calendar", },
        def attribute item { type: int, isKey: true, description: "Product", },
        def attribute warehouse { type: int, isKey: true, description: "Distribution center", },
        def attribute quantity_on_hand { type: int, optional: true, description: "Quantity on hand at the time of the snapshot", },
    ]
}

def entity inventory_weekly_summary { description: """Weekly summary of stock and sales of a product in a distribution center.
""",
    attributes: [
        def attribute week_seq { type: int, isKey: true, description: "Absolute week number (d_week_seq)", },
        def attribute item { type: int, isKey: true, description: "Product", },
        def attribute warehouse { type: int, isKey: true, description: "Distribution center", },
        def attribute avg_on_hand { type: float, optional: true, description: "Average quantity on hand during the week", },
        def attribute min_on_hand { type: int, optional: true, description: "Minimum quantity on hand during the week", },
        def attribute units_sold { type: int, optional: true, description: "Units sold through the web and the marketplace", },
        def attribute days_of_cover { type: float, optional: true, description: "Days of sales the stock covers", },
    ]
}

def entity item { description: """Products (TPC-DS item), versioned by validity (i_rec_start_date / i_rec_end_date).
The item entity reads only the currently valid version of each record.
Hierarchy: category -> class -> brand -> item.
""", labelPlural: "Products", aliases: ["product", "SKU"],
    attributes: [
        def attribute sk { type: int, isKey: true, description: "Unique item identifier", },
        def attribute item_id { type: text, optional: true, description: "Unique item code; the same for every version of the record", },
        def attribute rec_start_date { type: date, optional: true, description: "Start of validity of this record version", },
        def attribute rec_end_date { type: date, optional: true, description: "End of validity of this record version (NULL = current)", },
        def attribute item_desc { type: text, optional: true, description: "Item description", },
        def attribute current_price { type: decimal, optional: true, description: "Current sales price", },
        def attribute wholesale_cost { type: decimal, optional: true, description: "Wholesale cost", },
        def attribute brand_id { type: int, optional: true, description: "Link to the brand", },
        def attribute class_id { type: int, optional: true, description: "Link to the class", },
        def attribute category_id { type: int, optional: true, description: "Link to the category", },
        def attribute manufact_id { type: int, optional: true, description: "Link to the manufacturer", },
        def attribute size { type: text, optional: true, description: "The size of this item's SKU", },
        def attribute formulation { type: text, optional: true, description: "Formulation", },
        def attribute color { type: text, optional: true, description: "Color", },
        def attribute units { type: text, optional: true, description: "Unit of measure", },
        def attribute container { type: text, optional: true, description: "The packaging of this item's SKU", },
        def attribute manager_id { type: int, optional: true, description: "Product manager", },
        def attribute product_name { type: text, optional: true, description: "Product name, the human-readable label", search { searchable method: TOKENS }, },
    ]
}

def entity item_class { description: """Product classes within a category — normalised out of the i_class* columns of item.
""", labelPlural: "Classes",
    attributes: [
        def attribute sk { type: int, isKey: true, description: "Unique class identifier", },
        def attribute class_code { type: text, optional: true, description: "Unique class code", },
        def attribute class_name { type: text, optional: true, description: "Class name", search { searchable: true }, },
        def attribute category_id { type: int, optional: true, description: "Link to the parent category", },
    ]
}

def entity item_price_history { description: """Sales price and wholesale cost history of a product.
""",
    attributes: [
        def attribute item { type: int, isKey: true, description: "Product", },
        def attribute valid_from { type: datetime, isKey: true, description: "Moment the price became valid", },
        def attribute valid_to { type: datetime, optional: true, description: "Moment the price stopped being valid (NULL = current)", },
        def attribute price { type: decimal, optional: true, description: "Sales price", },
        def attribute wholesale_cost { type: decimal, optional: true, description: "Wholesale cost", },
    ]
}

def entity large_warehouse { description: """Distribution centers with at least 500,000 square feet of floor space.
""",
    attributes: [
        def attribute sk { type: int, isKey: true, description: "Unique distribution center identifier", },
        def attribute warehouse_id { type: text, optional: true, description: "Distribution center code", },
        def attribute warehouse_name { type: text, optional: true, description: "Distribution center name, the human-readable label", search { searchable method: TOKENS }, },
        def attribute warehouse_sq_ft { type: int, optional: true, description: "Warehouse floor space in square feet", },
        def attribute state { type: text, optional: true, description: "The state the distribution center is located in", search { searchable method: EXACT }, },
    ]
}

def entity loss_making_store_return { description: """Store returns with a net loss.
""",
    attributes: [
        def attribute item { type: int, isKey: true, description: "Returned product", },
        def attribute ticket_number { type: int, isKey: true, description: "Original sales ticket number — pairs this return with its sale", },
        def attribute store { type: int, optional: true, description: "Store accepting the return", },
        def attribute reason { type: int, optional: true, description: "Return reason", },
        def attribute net_loss { type: decimal, optional: true, description: "Net loss of the return", },
    ]
}

def entity manufacturer { description: """Manufacturers — normalised out of the i_manufact* columns of item.
""",
    attributes: [
        def attribute sk { type: int, isKey: true, description: "Unique manufacturer identifier", },
