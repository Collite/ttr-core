package billing

model db schema dbo

// A TPC-DS slice of the Hartland demo database (its US world): the sales, returns and
// inventory facts with their dimensions, the item / store hierarchies normalised out of their
// denormalised TPC-DS columns, and a few TPC-DS-style derived tables (channel_sales, plans,
// summaries, assortment). Physical names are TPC-DS.

def table call_center { description: """Seller support centers handling marketplace orders (TPC-DS call_center).
""", primaryKey: ["cc_call_center_sk"],
    columns: [
        def column cc_call_center_sk { type: int, isKey: true, description: "Unique seller support center identifier", },
        def column cc_call_center_id { type: text, optional: true, description: "Seller support center code", },
        def column cc_name { type: text, optional: true, description: "Seller support center name, the human-readable label", search { searchable: true }, },
        def column cc_rec_start_date { type: date, optional: true, description: "Start of validity of this record version", },
        def column cc_rec_end_date { type: date, optional: true, description: "End of validity of this record version (NULL = current)", },
        def column cc_open_date_sk { type: int, optional: true, description: "Date the center opened", },
        def column cc_closed_date_sk { type: int, optional: true, description: "Date the center closed", },
        def column cc_class { type: text, optional: true, description: "Size class of the center", },
        def column cc_employees { type: int, optional: true, description: "Number of employees", },
        def column cc_hours { type: text, optional: true, description: "Operating hours", },
        def column cc_manager { type: text, optional: true, description: "Center manager", },
        def column cc_mkt_id { type: int, optional: true, description: "Identifier of the market served", },
        def column cc_division_name { type: text, optional: true, description: "Division of the center", },
        def column cc_city { type: text, optional: true, description: "City", },
        def column cc_state { type: text, optional: true, description: "State", },
        def column cc_country { type: text, optional: true, description: "Country", },
    ]
}

def table catalog_page { description: """Pages of the marketplace catalogs (TPC-DS catalog_page).
""", primaryKey: ["cp_catalog_page_sk"],
    columns: [
        def column cp_catalog_page_sk { type: int, isKey: true, description: "Unique catalog page identifier", },
        def column cp_catalog_page_id { type: text, optional: true, description: "Catalog page code", },
        def column cp_start_date_sk { type: int, optional: true, description: "Start of validity of the catalog", },
        def column cp_end_date_sk { type: int, optional: true, description: "End of validity of the catalog", },
        def column cp_department { type: text, optional: true, description: "Department", },
        def column cp_catalog_number { type: int, optional: true, description: "Catalog number", },
        def column cp_catalog_page_number { type: int, optional: true, description: "Page number within the catalog", },
        def column cp_description { type: text, optional: true, description: "Page description", },
        def column cp_type { type: text, optional: true, description: "Catalog periodicity", },
    ]
}

def table catalog_returns { description: """Marketplace-channel returns (TPC-DS catalog_returns).
Note: the amount column is cr_return_amount, not cr_return_amt like its siblings.
""", primaryKey: ["cr_item_sk", "cr_order_number"],
    columns: [
        def column cr_returned_date_sk { type: int, optional: true, description: "Return date — FK to the calendar", },
        def column cr_item_sk { type: int, isKey: true, description: "Returned product", },
        def column cr_refunded_customer_sk { type: int, optional: true, description: "Customer the amount was refunded to", },
        def column cr_returning_customer_sk { type: int, optional: true, description: "Returning customer", },
        def column cr_returning_addr_sk { type: int, optional: true, description: "Address the goods were returned from", },
        def column cr_call_center_sk { type: int, optional: true, description: "Seller support center that handled the return", },
        def column cr_catalog_page_sk { type: int, optional: true, description: "Catalog page of the original order", },
        def column cr_ship_mode_sk { type: int, optional: true, description: "Return ship mode", },
        def column cr_warehouse_sk { type: int, optional: true, description: "Distribution center processing the return", },
        def column cr_reason_sk { type: int, optional: true, description: "Return reason", },
        def column cr_order_number { type: int, isKey: true, description: "Original marketplace order number — pairs this return with its sale", },
        def column cr_return_quantity { type: int, optional: true, description: "Units returned on this line", },
        def column cr_return_amount { type: decimal, optional: true, description: "Refunded amount of the line, excluding tax", },
        def column cr_return_ship_cost { type: decimal, optional: true, description: "Return shipping cost", },
        def column cr_refunded_cash { type: decimal, optional: true, description: "Amount refunded in cash", },
        def column cr_net_loss { type: decimal, optional: true, description: "Net loss of the return", },
    ]
}

def table catalog_sales { description: """Marketplace-channel sales lines (TPC-DS catalog_sales).
An order is handled by a seller support center and shipped by a distribution center.
""", primaryKey: ["cs_item_sk", "cs_order_number"],
    columns: [
        def column cs_sold_date_sk { type: int, optional: true, description: "Order date — FK to the calendar", },
        def column cs_sold_time_sk { type: int, optional: true, description: "Order time of day — FK to the time dimension", },
        def column cs_ship_date_sk { type: int, optional: true, description: "Ship date — FK to the calendar", },
        def column cs_bill_customer_sk { type: int, optional: true, description: "Billed customer", },
        def column cs_bill_cdemo_sk { type: int, optional: true, description: "Demographics of the billed customer", },
        def column cs_bill_addr_sk { type: int, optional: true, description: "Billing address", },
        def column cs_ship_customer_sk { type: int, optional: true, description: "Customer the order is shipped to", },
        def column cs_ship_addr_sk { type: int, optional: true, description: "Shipping address", },
        def column cs_call_center_sk { type: int, optional: true, description: "Seller support center handling the order", },
        def column cs_catalog_page_sk { type: int, optional: true, description: "Catalog page the order came from", },
        def column cs_ship_mode_sk { type: int, optional: true, description: "Ship mode", },
        def column cs_warehouse_sk { type: int, optional: true, description: "Fulfilling distribution center", },
        def column cs_item_sk { type: int, isKey: true, description: "Ordered product", },
        def column cs_promo_sk { type: int, optional: true, description: "Promotion applied to this line, if any", },
        def column cs_order_number { type: int, isKey: true, description: "Marketplace order number; one order = one basket", },
        def column cs_quantity { type: int, optional: true, description: "Units ordered on this line", },
        def column cs_list_price { type: decimal, optional: true, description: "List price per unit", },
        def column cs_sales_price { type: decimal, optional: true, description: "Sales price per unit after discount", },
        def column cs_ext_sales_price { type: decimal, optional: true, description: "Extended sales price of the line — the revenue amount", },
        def column cs_ext_ship_cost { type: decimal, optional: true, description: "Shipping cost of the line", },
        def column cs_net_paid { type: decimal, optional: true, description: "Net amount paid, excluding tax", },
        def column cs_net_profit { type: decimal, optional: true, description: "Net profit of the line", },
    ]
}

def table channel_sales { description: """All-channel sales lines — store, web and marketplace sales in one relation, labelled by channel.
Derived from store_sales, web_sales and catalog_sales; the one object on which revenue and
units sold can be compared by channel.
""", primaryKey: ["channel", "item_sk", "sold_date_sk", "customer_sk"],
    columns: [
        def column channel { type: text, isKey: true, description: "Sales channel", },
        def column sold_date_sk { type: int, isKey: true, description: "Sale date — FK to the calendar", },
        def column item_sk { type: int, isKey: true, description: "Sold product", },
        def column customer_sk { type: int, isKey: true, description: "Buying customer", },
        def column quantity { type: int, optional: true, description: "Units sold on this line", },
        def column ext_sales_price { type: decimal, optional: true, description: "Extended sales price of the line — the revenue amount", },
        def column warehouse_sk { type: int, optional: true, description: "Fulfilling distribution center of a web or marketplace line; NULL on a store line", },
    ]
}

def table customer { description: """Customers of all sales channels (TPC-DS customer).
""", primaryKey: ["c_customer_sk"],
    columns: [
        def column c_customer_sk { type: int, isKey: true, description: "Unique customer identifier", },
        def column c_customer_id { type: text, optional: true, description: "Unique customer code", },
        def column c_current_cdemo_sk { type: int, optional: true, description: "Current customer demographics", },
        def column c_current_hdemo_sk { type: int, optional: true, description: "Current household demographics", },
        def column c_current_addr_sk { type: int, optional: true, description: "Current address", },
        def column c_first_shipto_date_sk { type: int, optional: true, description: "Date of the first shipment", },
        def column c_first_sales_date_sk { type: int, optional: true, description: "Date of the first purchase", },
        def column c_salutation { type: text, optional: true, description: "Salutation", },
        def column c_first_name { type: text, optional: true, description: "First name", },
        def column c_last_name { type: text, optional: true, description: "Last name", search { searchable: true }, },
        def column c_preferred_cust_flag { type: text, optional: true, description: "Preferred customer flag", },
        def column c_birth_day { type: int, optional: true, description: "Day of birth", },
        def column c_birth_month { type: int, optional: true, description: "Month of birth", },
        def column c_birth_year { type: int, optional: true, description: "Year of birth; age is derived at query time", },
        def column c_birth_country { type: text, optional: true, description: "Country of birth", },
        def column c_email_address { type: text, optional: true, description: "E-mail address", },
        def column c_last_review_date_sk { type: int, optional: true, description: "Date of the customer's last review", },
    ]
}

def table customer_address { description: """Customer addresses (TPC-DS customer_address).
""", primaryKey: ["ca_address_sk"],
    columns: [
        def column ca_address_sk { type: int, isKey: true, description: "Unique address identifier", },
        def column ca_address_id { type: text, optional: true, description: "Address code", },
        def column ca_street_number { type: text, optional: true, description: "Street number", },
        def column ca_street_name { type: text, optional: true, description: "Street name", },
        def column ca_city { type: text, optional: true, description: "City of the address", search { searchable: true }, },
        def column ca_county { type: text, optional: true, description: "County of the address", },
        def column ca_state { type: text, optional: true, description: "Two-letter state code of the address", },
        def column ca_zip { type: text, optional: true, description: "ZIP code", },
        def column ca_country { type: text, optional: true, description: "Country", },
        def column ca_gmt_offset { type: float, optional: true, description: "Offset from GMT in hours", },
        def column ca_location_type { type: text, optional: true, description: "Location type", },
    ]
}

def table customer_channel_summary { description: """Yearly summary of a customer's purchases by sales channel.
""", primaryKey: ["ccs_customer_sk", "ccs_year"],
    columns: [
        def column ccs_customer_sk { type: int, isKey: true, description: "Customer", },
        def column ccs_year { type: int, isKey: true, description: "Year", },
        def column ccs_store_sales { type: decimal, optional: true, description: "Revenue in stores", },
        def column ccs_web_sales { type: decimal, optional: true, description: "Revenue on the web", },
        def column ccs_catalog_sales { type: decimal, optional: true, description: "Revenue on the marketplace", },
        def column ccs_return_amt { type: decimal, optional: true, description: "Amount returned across channels", },
        def column ccs_orders { type: int, optional: true, description: "Number of baskets (tickets and orders)", },
    ]
}

def table customer_demographics { description: """Customer demographic profiles (TPC-DS customer_demographics).
""", primaryKey: ["cd_demo_sk"],
    columns: [
        def column cd_demo_sk { type: int, isKey: true, description: "Unique demographic profile identifier", },
        def column cd_gender { type: text, optional: true, description: "Gender code", },
        def column cd_marital_status { type: text, optional: true, description: "Marital status code", },
        def column cd_education_status { type: text, optional: true, description: "Highest education level", },
        def column cd_purchase_estimate { type: int, optional: true, description: "Estimated yearly purchases", },
        def column cd_credit_rating { type: text, optional: true, description: "Credit rating", },
        def column cd_dep_count { type: int, optional: true, description: "Number of dependants", },
        def column cd_dep_employed_count { type: int, optional: true, description: "Number of employed dependants", },
        def column cd_dep_college_count { type: int, optional: true, description: "Number of dependants in college", },
    ]
}

def table date_dim { description: """Calendar — one row per day (TPC-DS date_dim).
Every date link of a fact points here through a *_date_sk column.
""", primaryKey: ["d_date_sk"],
    columns: [
        def column d_date_sk { type: int, isKey: true, description: "Unique day identifier", },
        def column d_date_id { type: text, optional: true, description: "Day code", },
        def column d_date { type: date, optional: true, description: "Calendar date. The primary grain of the calendar", },
        def column d_month_seq { type: int, optional: true, description: "Absolute month number", },
        def column d_week_seq { type: int, optional: true, description: "Absolute week number from the beginning of the calendar", },
        def column d_quarter_seq { type: int, optional: true, description: "Absolute quarter number", },
        def column d_year { type: int, optional: true, description: "Year of the calendar date", },
        def column d_dow { type: int, optional: true, description: "Day of week (0 = Sunday)", },
        def column d_moy { type: int, optional: true, description: "Month of year, 1-12", },
        def column d_dom { type: int, optional: true, description: "Day of month", },
        def column d_qoy { type: int, optional: true, description: "Quarter of year, 1-4", },
        def column d_fy_year { type: int, optional: true, description: "Fiscal year", },
        def column d_day_name { type: text, optional: true, description: "Name of the day of the week", },
        def column d_quarter_name { type: text, optional: true, description: "Quarter name (e.g. 2025Q1)", },
        def column d_holiday { type: text, optional: true, description: "Is this a holiday? Y/N", },
        def column d_weekend { type: text, optional: true, description: "Is this a weekend? Y/N", },
        def column d_first_dom { type: int, optional: true, description: "Day identifier of the first day of the month", },
        def column d_same_day_ly { type: int, optional: true, description: "Day identifier of the same day last year", },
    ]
}

def table household_demographics { description: """Household demographic profiles (TPC-DS household_demographics).
""", primaryKey: ["hd_demo_sk"],
    columns: [
        def column hd_demo_sk { type: int, isKey: true, description: "Unique household profile identifier", },
        def column hd_income_band_sk { type: int, optional: true, description: "Income band of the household", },
        def column hd_buy_potential { type: text, optional: true, description: "Household buying-potential label (e.g. '>10000', 'Unknown')", },
        def column hd_dep_count { type: int, optional: true, description: "Number of dependants", },
        def column hd_vehicle_count { type: int, optional: true, description: "Number of vehicles in the household", },
    ]
}

def table income_band { description: """Household income bands (TPC-DS income_band).
""", primaryKey: ["ib_income_band_sk"],
    columns: [
        def column ib_income_band_sk { type: int, isKey: true, description: "Unique income band identifier", },
        def column ib_lower_bound { type: int, optional: true, description: "Lower bound of the yearly income range (USD)", },
        def column ib_upper_bound { type: int, optional: true, description: "Upper bound of the yearly income range (USD)", },
    ]
}

def table inventory { description: """Weekly on-hand snapshots per distribution center and item (TPC-DS inventory).
Semi-additive: stock levels must not be added across snapshots.
""", primaryKey: ["inv_date_sk", "inv_item_sk", "inv_warehouse_sk"],
    columns: [
        def column inv_date_sk { type: int, isKey: true, description: "Weekly snapshot date — FK to the calendar", },
        def column inv_item_sk { type: int, isKey: true, description: "Product", },
        def column inv_warehouse_sk { type: int, isKey: true, description: "Distribution center", },
        def column inv_quantity_on_hand { type: int, optional: true, description: "Quantity on hand at the time of the snapshot", },
    ]
}

def table inventory_weekly_summary { description: """Weekly summary of stock and sales of a product in a distribution center.
""", primaryKey: ["iws_week_seq", "iws_item_sk", "iws_warehouse_sk"],
    columns: [
        def column iws_week_seq { type: int, isKey: true, description: "Absolute week number (d_week_seq)", },
        def column iws_item_sk { type: int, isKey: true, description: "Product", },
        def column iws_warehouse_sk { type: int, isKey: true, description: "Distribution center", },
        def column iws_avg_on_hand { type: float, optional: true, description: "Average quantity on hand during the week", },
        def column iws_min_on_hand { type: int, optional: true, description: "Minimum quantity on hand during the week", },
        def column iws_units_sold { type: int, optional: true, description: "Units sold through the web and the marketplace", },
        def column iws_days_of_cover { type: float, optional: true, description: "Days of sales the stock covers", },
    ]
}

def table item { description: """Products (TPC-DS item), versioned by validity (i_rec_start_date / i_rec_end_date).
The item entity reads only the currently valid version of each record.
Hierarchy: category -> class -> brand -> item.
""", primaryKey: ["i_item_sk"],
    search { searchable: true },
    columns: [
        def column i_item_sk { type: int, isKey: true, description: "Unique item identifier", },
        def column i_item_id { type: text, optional: true, description: "Unique item code; the same for every version of the record", },
        def column i_rec_start_date { type: date, optional: true, description: "Start of validity of this record version", },
        def column i_rec_end_date { type: date, optional: true, description: "End of validity of this record version (NULL = current)", },
        def column i_item_desc { type: text, optional: true, description: "Item description", },
        def column i_current_price { type: decimal, optional: true, description: "Current sales price", },
        def column i_wholesale_cost { type: decimal, optional: true, description: "Wholesale cost", },
        def column i_brand_id { type: int, optional: true, description: "Link to the brand", },
        def column i_class_id { type: int, optional: true, description: "Link to the class", },
        def column i_category_id { type: int, optional: true, description: "Link to the category", },
        def column i_manufact_id { type: int, optional: true, description: "Link to the manufacturer", },
        def column i_size { type: text, optional: true, description: "The size of this item's SKU", },
        def column i_formulation { type: text, optional: true, description: "Formulation", },
        def column i_color { type: text, optional: true, description: "Color", },
        def column i_units { type: text, optional: true, description: "Unit of measure", },
        def column i_container { type: text, optional: true, description: "The packaging of this item's SKU", },
        def column i_manager_id { type: int, optional: true, description: "Product manager", },
        def column i_product_name { type: text, optional: true, description: "Product name, the human-readable label", search { searchable: true }, },
    ]
}

def table item_brand { description: """Product brands — normalised out of the i_brand* columns of item.
""", primaryKey: ["i_brand_id"],
    columns: [
        def column i_brand_id { type: int, isKey: true, description: "Unique brand identifier", },
        def column i_brand { type: text, optional: true, description: "Brand name", search { searchable: true }, },
        def column i_class_id { type: int, optional: true, description: "Class the brand belongs to", },
        def column i_manufact_id { type: int, optional: true, description: "Manufacturer owning the brand", },
    ]
}

def table item_category { description: """Product categories — normalised out of the denormalised i_category* columns of item.
""", primaryKey: ["i_category_id"],
    columns: [
        def column i_category_id { type: int, isKey: true, description: "Unique category identifier", },
        def column i_category_code { type: text, optional: true, description: "Unique category code", },
        def column i_category { type: text, optional: true, description: "Category name", search { searchable: true }, },
    ]
}

def table item_class { description: """Product classes within a category — normalised out of the i_class* columns of item.
""", primaryKey: ["i_class_id"],
    columns: [
        def column i_class_id { type: int, isKey: true, description: "Unique class identifier", },
        def column i_class_code { type: text, optional: true, description: "Unique class code", },
        def column i_class { type: text, optional: true, description: "Class name", search { searchable: true }, },
        def column i_category_id { type: int, optional: true, description: "Link to the parent category", },
    ]
}

def table item_manufacturer { description: """Manufacturers — normalised out of the i_manufact* columns of item.
""", primaryKey: ["i_manufact_id"],
    columns: [
        def column i_manufact_id { type: int, isKey: true, description: "Unique manufacturer identifier", },
        def column i_manufact { type: text, optional: true, description: "Manufacturer name", },
    ]
}

def table item_price_history { description: """Sales price and wholesale cost history of a product.
""", primaryKey: ["iph_item_sk", "iph_valid_from"],
    columns: [
        def column iph_item_sk { type: int, isKey: true, description: "Product", },
        def column iph_valid_from { type: datetime, isKey: true, description: "Moment the price became valid", },
        def column iph_valid_to { type: datetime, optional: true, description: "Moment the price stopped being valid (NULL = current)", },
        def column iph_current_price { type: decimal, optional: true, description: "Sales price", },
        def column iph_wholesale_cost { type: decimal, optional: true, description: "Wholesale cost", },
    ]
}

def table promotion { description: """Promotions and the media they run in (TPC-DS promotion).
""", primaryKey: ["p_promo_sk"],
    columns: [
        def column p_promo_sk { type: int, isKey: true, description: "Unique promotion identifier", },
        def column p_promo_id { type: text, optional: true, description: "Promotion code", },
        def column p_start_date_sk { type: int, optional: true, description: "Promotion start date", },
        def column p_end_date_sk { type: int, optional: true, description: "Promotion end date", },
        def column p_item_sk { type: int, optional: true, description: "Featured product of the promotion", },
        def column p_cost { type: decimal, optional: true, description: "Cost of the promotion", },
        def column p_response_target { type: int, optional: true, description: "Response target", },
        def column p_promo_name { type: text, optional: true, description: "Promotion name, the human-readable label", search { searchable: true }, },
        def column p_channel_dmail { type: text, optional: true, description: "Promoted by direct mail", },
        def column p_channel_email { type: text, optional: true, description: "Promoted by e-mail", },
        def column p_channel_catalog { type: text, optional: true, description: "Promoted in the catalog", },
        def column p_channel_tv { type: text, optional: true, description: "Promoted on TV", },
        def column p_channel_radio { type: text, optional: true, description: "Promoted on radio", },
        def column p_channel_press { type: text, optional: true, description: "Promoted in the press", },
        def column p_channel_event { type: text, optional: true, description: "Promoted at an event", },
        def column p_channel_details { type: text, optional: true, description: "Details of the promotion media", },
        def column p_purpose { type: text, optional: true, description: "Purpose of the promotion", },
        def column p_discount_active { type: text, optional: true, description: "Discount active flag", },
    ]
}

def table promotion_item { description: """Products taking part in a promotion — a bridge between promotion and item.
""", primaryKey: ["pi_promo_sk", "pi_item_sk"],
    columns: [
        def column pi_promo_sk { type: int, isKey: true, description: "Promotion", },
        def column pi_item_sk { type: int, isKey: true, description: "Product in the promotion", },
        def column pi_discount_pct { type: float, optional: true, description: "Discount in percent", },
        def column pi_start_date_sk { type: int, optional: true, description: "Date the product joined the promotion", },
    ]
}

def table reason { description: """Return reasons (TPC-DS reason). The reason text is stored in the language of the loaded data.
""", primaryKey: ["r_reason_sk"],
    columns: [
        def column r_reason_sk { type: int, isKey: true, description: "Unique reason identifier", },
        def column r_reason_id { type: text, optional: true, description: "Return reason code", },
        def column r_reason_desc { type: text, optional: true, description: "Return reason text, the human-readable label", search { searchable: true }, },
    ]
}

def table ship_mode { description: """Ship modes of web and marketplace orders (TPC-DS ship_mode).
""", primaryKey: ["sm_ship_mode_sk"],
    columns: [
        def column sm_ship_mode_sk { type: int, isKey: true, description: "Unique ship mode identifier", },
        def column sm_ship_mode_id { type: text, optional: true, description: "Ship mode code", },
        def column sm_type { type: text, optional: true, description: "Ship mode type", },
        def column sm_code { type: text, optional: true, description: "Transport code (air, surface, sea)", },
        def column sm_carrier { type: text, optional: true, description: "Carrier", },
        def column sm_contract { type: text, optional: true, description: "Carrier contract number", },
    ]
}

def table store { description: """Stores (TPC-DS store), versioned by validity (s_rec_start_date / s_rec_end_date).
The store entity reads only the currently valid version of each record.
""", primaryKey: ["s_store_sk"],
    columns: [
        def column s_store_sk { type: int, isKey: true, description: "Unique store identifier", },
        def column s_store_id { type: text, optional: true, description: "Unique store code", },
        def column s_store_name { type: text, optional: true, description: "Store name, the human-readable label", search { searchable: true }, },
        def column s_rec_start_date { type: date, optional: true, description: "Start of validity of this record version", },
        def column s_rec_end_date { type: date, optional: true, description: "End of validity of this record version (NULL = current)", },
        def column s_closed_date_sk { type: int, optional: true, description: "Date the store closed", },
        def column s_number_employees { type: int, optional: true, description: "Number of employees", },
        def column s_floor_space { type: int, optional: true, description: "Selling floor space in square feet", },
        def column s_hours { type: text, optional: true, description: "Opening hours", },
        def column s_manager { type: text, optional: true, description: "Store manager", },
        def column s_market_id { type: int, optional: true, description: "Link to the store's market", },
        def column s_geography_class { type: text, optional: true, description: "Geography class of the location", },
        def column s_city { type: text, optional: true, description: "The city the store is located in", },
        def column s_county { type: text, optional: true, description: "The county the store is located in", },
        def column s_state { type: text, optional: true, description: "The state the store is located in", },
        def column s_zip { type: text, optional: true, description: "ZIP code", },
        def column s_country { type: text, optional: true, description: "Country", },
        def column s_tax_precentage { type: float, optional: true, description: "Sales tax rate in percent", },
    ]
}

def table store_company { description: """Companies operating the stores — normalised out of the s_company_* columns of store.
""", primaryKey: ["s_company_id"],
    columns: [
        def column s_company_id { type: int, isKey: true, description: "Unique company identifier", },
        def column s_company_name { type: text, optional: true, description: "Company name", },
    ]
}

def table store_division { description: """Divisions the markets belong to — normalised out of the s_division_* columns of store.
""", primaryKey: ["s_division_id"],
    columns: [
        def column s_division_id { type: int, isKey: true, description: "Unique division identifier", },
        def column s_division_code { type: text, optional: true, description: "Unique division code", },
        def column s_division_name { type: text, optional: true, description: "Division name", },
        def column s_company_id { type: int, optional: true, description: "Link to the company", },
    ]
}

def table store_item_assortment { description: """Store assortment — which products a store carries, and since when.
""", primaryKey: ["sia_store_sk", "sia_item_sk"],
    columns: [
        def column sia_store_sk { type: int, isKey: true, description: "Store", },
        def column sia_item_sk { type: int, isKey: true, description: "Product", },
        def column sia_listed_date_sk { type: int, optional: true, description: "Date the product was listed", },
        def column sia_delisted_date_sk { type: int, optional: true, description: "Date the product was delisted", },
        def column sia_min_stock { type: int, optional: true, description: "Minimum stock level in the store", },
    ]
}

def table store_market { description: """Store markets — normalised out of the denormalised s_market_* columns of store.
""", primaryKey: ["s_market_id"],
    columns: [
        def column s_market_id { type: int, isKey: true, description: "Unique market identifier", },
        def column s_market_code { type: text, optional: true, description: "Unique market code", },
        def column s_market_desc { type: text, optional: true, description: "Market name", search { searchable: true }, },
        def column s_market_manager { type: text, optional: true, description: "Market manager", },
        def column s_division_id { type: int, optional: true, description: "Link to the division", },
    ]
}

def table store_returns { description: """Stores-channel returns (TPC-DS store_returns).
""", primaryKey: ["sr_item_sk", "sr_ticket_number"],
    columns: [
        def column sr_returned_date_sk { type: int, optional: true, description: "Return date — FK to the calendar", },
        def column sr_return_time_sk { type: int, optional: true, description: "Return time of day — FK to the time dimension", },
        def column sr_item_sk { type: int, isKey: true, description: "Returned product", },
        def column sr_customer_sk { type: int, optional: true, description: "Returning customer", },
        def column sr_cdemo_sk { type: int, optional: true, description: "Customer demographics at the time of the return", },
        def column sr_addr_sk { type: int, optional: true, description: "Customer address at the time of the return", },
        def column sr_store_sk { type: int, optional: true, description: "Store accepting the return", },
        def column sr_reason_sk { type: int, optional: true, description: "Return reason", },
        def column sr_ticket_number { type: int, isKey: true, description: "Original sales ticket number — pairs this return with its sale", },
        def column sr_return_quantity { type: int, optional: true, description: "Units returned on this line", },
        def column sr_return_amt { type: decimal, optional: true, description: "Refunded amount of the line, excluding tax", },
        def column sr_return_tax { type: decimal, optional: true, description: "Tax on the refunded amount", },
        def column sr_fee { type: decimal, optional: true, description: "Return handling fee", },
        def column sr_refunded_cash { type: decimal, optional: true, description: "Amount refunded in cash", },
        def column sr_store_credit { type: decimal, optional: true, description: "Amount refunded as store credit", },
        def column sr_net_loss { type: decimal, optional: true, description: "Net loss of the return", },
    ]
}

def table store_sales { description: """Stores-channel sales lines (TPC-DS store_sales).
One row = one line of a sales ticket; the line revenue is ss_ext_sales_price.
""", primaryKey: ["ss_item_sk", "ss_ticket_number"],
    columns: [
        def column ss_sold_date_sk { type: int, optional: true, description: "Sale date — FK to the calendar", },
        def column ss_sold_time_sk { type: int, optional: true, description: "Sale time of day — FK to the time dimension", },
        def column ss_item_sk { type: int, isKey: true, description: "Sold product", },
        def column ss_customer_sk { type: int, optional: true, description: "Buying customer", },
        def column ss_cdemo_sk { type: int, optional: true, description: "Customer demographics at the time of the sale", },
        def column ss_hdemo_sk { type: int, optional: true, description: "Household demographics at the time of the sale", },
        def column ss_addr_sk { type: int, optional: true, description: "Customer address at the time of the sale", },
        def column ss_store_sk { type: int, optional: true, description: "Selling store", },
        def column ss_promo_sk { type: int, optional: true, description: "Promotion applied to this line, if any", },
        def column ss_ticket_number { type: int, isKey: true, description: "Sales ticket number; one ticket = one basket", },
        def column ss_quantity { type: int, optional: true, description: "Units sold on this line", },
        def column ss_list_price { type: decimal, optional: true, description: "List price per unit", },
        def column ss_sales_price { type: decimal, optional: true, description: "Sales price per unit after discount", },
        def column ss_ext_discount_amt { type: decimal, optional: true, description: "Total discount of the line", },
        def column ss_ext_sales_price { type: decimal, optional: true, description: "Extended sales price of the line (unit price × quantity) — the revenue amount", },
        def column ss_ext_tax { type: decimal, optional: true, description: "Tax of the line", },
        def column ss_net_paid { type: decimal, optional: true, description: "Net amount paid, excluding tax", },
        def column ss_net_profit { type: decimal, optional: true, description: "Net profit of the line", },
    ]
}

def table store_sales_plan { description: """Planned store revenue by product category and month.
""", primaryKey: ["ssp_store_sk", "ssp_category_id", "ssp_year", "ssp_moy"],
    columns: [
        def column ssp_store_sk { type: int, isKey: true, description: "Store", },
        def column ssp_category_id { type: int, isKey: true, description: "Product category", },
        def column ssp_year { type: int, isKey: true, description: "Plan year", },
        def column ssp_moy { type: int, isKey: true, description: "Plan month, 1-12", },
        def column ssp_planned_sales { type: decimal, optional: true, description: "Planned revenue", },
        def column ssp_planned_quantity { type: int, optional: true, description: "Planned units sold", },
    ]
}

def table time_dim { description: """Time of day at one-second grain (TPC-DS time_dim).
""", primaryKey: ["t_time_sk"],
    columns: [
        def column t_time_sk { type: int, isKey: true, description: "Unique time identifier", },
        def column t_time_id { type: text, optional: true, description: "Time code", },
        def column t_time { type: int, optional: true, description: "Second of the day", },
        def column t_hour { type: int, optional: true, description: "Hour", },
        def column t_minute { type: int, optional: true, description: "Minute", },
        def column t_second { type: int, optional: true, description: "Second", },
        def column t_am_pm { type: text, optional: true, description: "AM / PM", },
        def column t_shift { type: text, optional: true, description: "Work shift", },
        def column t_sub_shift { type: text, optional: true, description: "Part of the shift", },
        def column t_meal_time { type: text, optional: true, description: "Meal time (breakfast, lunch, dinner)", },
    ]
}

def table warehouse { description: """Distribution centers fulfilling web and marketplace orders (TPC-DS warehouse).
""", primaryKey: ["w_warehouse_sk"],
    columns: [
        def column w_warehouse_sk { type: int, isKey: true, description: "Unique distribution center identifier", },
        def column w_warehouse_id { type: text, optional: true, description: "Distribution center code", },
        def column w_warehouse_name { type: text, optional: true, description: "Distribution center name, the human-readable label", search { searchable: true }, },
        def column w_warehouse_sq_ft { type: int, optional: true, description: "Warehouse floor space in square feet", },
        def column w_street_name { type: text, optional: true, description: "Street", },
        def column w_city { type: text, optional: true, description: "The city the distribution center is located in", },
        def column w_county { type: text, optional: true, description: "County", },
        def column w_state { type: text, optional: true, description: "The state the distribution center is located in", },
        def column w_zip { type: text, optional: true, description: "ZIP code", },
        def column w_country { type: text, optional: true, description: "Country", },
        def column w_gmt_offset { type: float, optional: true, description: "Offset from GMT in hours", },
    ]
}

def table web_page { description: """Pages of the web channel (TPC-DS web_page), versioned by validity.
""", primaryKey: ["wp_web_page_sk"],
    columns: [
        def column wp_web_page_sk { type: int, isKey: true, description: "Unique web page identifier", },
        def column wp_web_page_id { type: text, optional: true, description: "Web page code", },
        def column wp_rec_start_date { type: date, optional: true, description: "Start of validity of this record version", },
        def column wp_rec_end_date { type: date, optional: true, description: "End of validity of this record version (NULL = current)", },
        def column wp_creation_date_sk { type: int, optional: true, description: "Date the page was created", },
        def column wp_access_date_sk { type: int, optional: true, description: "Date of the last access", },
        def column wp_autogen_flag { type: text, optional: true, description: "Whether the page was generated automatically", },
        def column wp_customer_sk { type: int, optional: true, description: "Customer the page was created for", },
        def column wp_url { type: text, optional: true, description: "Page URL", },
        def column wp_type { type: text, optional: true, description: "Page type (e.g. welcome, order, feedback)", },
        def column wp_char_count { type: int, optional: true, description: "Number of characters on the page", },
        def column wp_link_count { type: int, optional: true, description: "Number of links on the page", },
        def column wp_image_count { type: int, optional: true, description: "Number of images on the page", },
    ]
}

def table web_returns { description: """Web-channel returns (TPC-DS web_returns).
""", primaryKey: ["wr_item_sk", "wr_order_number"],
    columns: [
        def column wr_returned_date_sk { type: int, optional: true, description: "Return date — FK to the calendar", },
        def column wr_item_sk { type: int, isKey: true, description: "Returned product", },
        def column wr_refunded_customer_sk { type: int, optional: true, description: "Customer the amount was refunded to", },
        def column wr_returning_customer_sk { type: int, optional: true, description: "Returning customer", },
        def column wr_returning_addr_sk { type: int, optional: true, description: "Address the goods were returned from", },
        def column wr_web_page_sk { type: int, optional: true, description: "Web page of the original order", },
        def column wr_reason_sk { type: int, optional: true, description: "Return reason", },
        def column wr_order_number { type: int, isKey: true, description: "Original web order number — pairs this return with its sale", },
        def column wr_return_quantity { type: int, optional: true, description: "Units returned on this line", },
        def column wr_return_amt { type: decimal, optional: true, description: "Refunded amount of the line, excluding tax", },
        def column wr_account_credit { type: decimal, optional: true, description: "Amount credited to the customer account", },
        def column wr_net_loss { type: decimal, optional: true, description: "Net loss of the return", },
    ]
}

def table web_sales { description: """Web-channel sales lines (TPC-DS web_sales).
""", primaryKey: ["ws_item_sk", "ws_order_number"],
    columns: [
        def column ws_sold_date_sk { type: int, optional: true, description: "Order date — FK to the calendar", },
        def column ws_sold_time_sk { type: int, optional: true, description: "Order time of day — FK to the time dimension", },
        def column ws_ship_date_sk { type: int, optional: true, description: "Ship date — FK to the calendar", },
        def column ws_item_sk { type: int, isKey: true, description: "Ordered product", },
        def column ws_bill_customer_sk { type: int, optional: true, description: "Billed customer", },
        def column ws_bill_addr_sk { type: int, optional: true, description: "Billing address", },
        def column ws_ship_customer_sk { type: int, optional: true, description: "Customer the order is shipped to", },
        def column ws_ship_addr_sk { type: int, optional: true, description: "Shipping address", },
        def column ws_web_page_sk { type: int, optional: true, description: "Web page the order was placed on", },
        def column ws_web_site_sk { type: int, optional: true, description: "Web site the order was placed on", },
        def column ws_ship_mode_sk { type: int, optional: true, description: "Ship mode", },
        def column ws_warehouse_sk { type: int, optional: true, description: "Fulfilling distribution center", },
        def column ws_promo_sk { type: int, optional: true, description: "Promotion applied to this line, if any", },
        def column ws_order_number { type: int, isKey: true, description: "Web order number; one order = one basket", },
        def column ws_quantity { type: int, optional: true, description: "Units ordered on this line", },
        def column ws_list_price { type: decimal, optional: true, description: "List price per unit", },
        def column ws_sales_price { type: decimal, optional: true, description: "Sales price per unit after discount", },
        def column ws_ext_sales_price { type: decimal, optional: true, description: "Extended sales price of the line — the revenue amount", },
        def column ws_ext_ship_cost { type: decimal, optional: true, description: "Shipping cost of the line", },
        def column ws_net_paid { type: decimal, optional: true, description: "Net amount paid, excluding tax", },
        def column ws_net_profit { type: decimal, optional: true, description: "Net profit of the line", },
    ]
}

def table web_site { description: """Web sites of the web channel (TPC-DS web_site), versioned by validity.
""", primaryKey: ["web_site_sk"],
    columns: [
        def column web_site_sk { type: int, isKey: true, description: "Unique web site identifier", },
        def column web_site_id { type: text, optional: true, description: "Web site code", },
        def column web_name { type: text, optional: true, description: "Web site name", },
        def column web_rec_start_date { type: date, optional: true, description: "Start of validity of this record version", },
        def column web_rec_end_date { type: date, optional: true, description: "End of validity of this record version (NULL = current)", },
        def column web_open_date_sk { type: int, optional: true, description: "Date the site went live", },
        def column web_close_date_sk { type: int, optional: true, description: "Date the site was shut down", },
        def column web_class { type: text, optional: true, description: "Web site class", },
        def column web_manager { type: text, optional: true, description: "Web site manager", },
        def column web_mkt_id { type: int, optional: true, description: "Identifier of the market served", },
        def column web_company_name { type: text, optional: true, description: "Operating company", },
        def column web_country { type: text, optional: true, description: "Country", },
    ]
}

def fk fk_brand_class { description: "A brand belongs to a class", from: [db.dbo.item_brand.i_class_id], to: [db.dbo.item_class.i_class_id],
}

def fk fk_brand_manufact { description: "A brand is owned by a manufacturer", from: [db.dbo.item_brand.i_manufact_id], to: [db.dbo.item_manufacturer.i_manufact_id],
}

def fk fk_c_addr { description: "Current address of a customer", from: [db.dbo.customer.c_current_addr_sk], to: [db.dbo.customer_address.ca_address_sk],
}

def fk fk_c_cdemo { description: "Current demographics of a customer", from: [db.dbo.customer.c_current_cdemo_sk], to: [db.dbo.customer_demographics.cd_demo_sk],
}

def fk fk_c_first_sales_date { description: "First purchase of a customer", from: [db.dbo.customer.c_first_sales_date_sk], to: [db.dbo.date_dim.d_date_sk],
}

def fk fk_c_first_shipto_date { description: "First shipment to a customer", from: [db.dbo.customer.c_first_shipto_date_sk], to: [db.dbo.date_dim.d_date_sk],
}

def fk fk_c_hdemo { description: "Current household demographics of a customer", from: [db.dbo.customer.c_current_hdemo_sk], to: [db.dbo.household_demographics.hd_demo_sk],
}

def fk fk_c_last_review_date { description: "Last review by a customer", from: [db.dbo.customer.c_last_review_date_sk], to: [db.dbo.date_dim.d_date_sk],
}

def fk fk_cc_closed_date { description: "A seller support center closed on a calendar day", from: [db.dbo.call_center.cc_closed_date_sk], to: [db.dbo.date_dim.d_date_sk],
}

def fk fk_cc_open_date { description: "A seller support center opened on a calendar day", from: [db.dbo.call_center.cc_open_date_sk], to: [db.dbo.date_dim.d_date_sk],
}

def fk fk_ccs_customer { description: "A purchase summary of a customer", from: [db.dbo.customer_channel_summary.ccs_customer_sk], to: [db.dbo.customer.c_customer_sk],
}

def fk fk_chs_customer { description: "A channel sale was bought by a customer", from: [db.dbo.channel_sales.customer_sk], to: [db.dbo.customer.c_customer_sk],
}

def fk fk_chs_date { description: "A channel sale happened on a calendar day", from: [db.dbo.channel_sales.sold_date_sk], to: [db.dbo.date_dim.d_date_sk],
}

def fk fk_chs_item { description: "A channel sales line sells a product", from: [db.dbo.channel_sales.item_sk], to: [db.dbo.item.i_item_sk],
}

def fk fk_chs_warehouse { description: "A web or marketplace line was fulfilled by a distribution center", from: [db.dbo.channel_sales.warehouse_sk], to: [db.dbo.warehouse.w_warehouse_sk],
}

def fk fk_class_category { description: "A class belongs to its parent category", from: [db.dbo.item_class.i_category_id], to: [db.dbo.item_category.i_category_id],
}

def fk fk_cp_end_date { description: "A catalog is valid until a calendar day", from: [db.dbo.catalog_page.cp_end_date_sk], to: [db.dbo.date_dim.d_date_sk],
}

def fk fk_cp_start_date { description: "A catalog is valid from a calendar day", from: [db.dbo.catalog_page.cp_start_date_sk], to: [db.dbo.date_dim.d_date_sk],
}

def fk fk_cr_addr { description: "Address a marketplace return came from", from: [db.dbo.catalog_returns.cr_returning_addr_sk], to: [db.dbo.customer_address.ca_address_sk],
}

def fk fk_cr_callcenter { description: "A marketplace return was handled by a seller support center", from: [db.dbo.catalog_returns.cr_call_center_sk], to: [db.dbo.call_center.cc_call_center_sk],
}

def fk fk_cr_catalog_page { description: "Catalog page of the original marketplace order", from: [db.dbo.catalog_returns.cr_catalog_page_sk], to: [db.dbo.catalog_page.cp_catalog_page_sk],
}

def fk fk_cr_customer { description: "A marketplace return was made by a customer", from: [db.dbo.catalog_returns.cr_returning_customer_sk], to: [db.dbo.customer.c_customer_sk],
}

def fk fk_cr_date { description: "A marketplace return was accepted on a calendar day", from: [db.dbo.catalog_returns.cr_returned_date_sk], to: [db.dbo.date_dim.d_date_sk],
}

def fk fk_cr_item { description: "A marketplace return concerns a product", from: [db.dbo.catalog_returns.cr_item_sk], to: [db.dbo.item.i_item_sk],
}

def fk fk_cr_reason { description: "A marketplace return has a reason", from: [db.dbo.catalog_returns.cr_reason_sk], to: [db.dbo.reason.r_reason_sk],
}

def fk fk_cr_refunded_customer { description: "The amount of a marketplace return was refunded to a customer", from: [db.dbo.catalog_returns.cr_refunded_customer_sk], to: [db.dbo.customer.c_customer_sk],
}

def fk fk_cr_sale { description: "A marketplace return returns a line of the original order", from: [db.dbo.catalog_returns.cr_item_sk, db.dbo.catalog_returns.cr_order_number], to: [db.dbo.catalog_sales.cs_item_sk, db.dbo.catalog_sales.cs_order_number],
}

