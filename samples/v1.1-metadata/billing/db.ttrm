}

def fk fk_cs_addr { description: "Billing address of a marketplace order", from: [db.dbo.catalog_sales.cs_bill_addr_sk], to: [db.dbo.customer_address.ca_address_sk],
}

def fk fk_cs_callcenter { description: "A marketplace order is handled by a seller support center", from: [db.dbo.catalog_sales.cs_call_center_sk], to: [db.dbo.call_center.cc_call_center_sk],
}

def fk fk_cs_catalog_page { description: "A marketplace order came from a catalog page", from: [db.dbo.catalog_sales.cs_catalog_page_sk], to: [db.dbo.catalog_page.cp_catalog_page_sk],
}

def fk fk_cs_cdemo { description: "Demographics of the billed customer", from: [db.dbo.catalog_sales.cs_bill_cdemo_sk], to: [db.dbo.customer_demographics.cd_demo_sk],
}

def fk fk_cs_customer { description: "A marketplace order is billed to a customer", from: [db.dbo.catalog_sales.cs_bill_customer_sk], to: [db.dbo.customer.c_customer_sk],
}

def fk fk_cs_date { description: "A marketplace order was placed on a calendar day", from: [db.dbo.catalog_sales.cs_sold_date_sk], to: [db.dbo.date_dim.d_date_sk],
}

def fk fk_cs_item { description: "A marketplace order line sells a product", from: [db.dbo.catalog_sales.cs_item_sk], to: [db.dbo.item.i_item_sk],
}

def fk fk_cs_promo { description: "A promotion was applied to a marketplace order line", from: [db.dbo.catalog_sales.cs_promo_sk], to: [db.dbo.promotion.p_promo_sk],
}

def fk fk_cs_ship_addr { description: "Shipping address of a marketplace order", from: [db.dbo.catalog_sales.cs_ship_addr_sk], to: [db.dbo.customer_address.ca_address_sk],
}

def fk fk_cs_ship_customer { description: "A marketplace order is shipped to a customer", from: [db.dbo.catalog_sales.cs_ship_customer_sk], to: [db.dbo.customer.c_customer_sk],
}

def fk fk_cs_ship_date { description: "A marketplace order was shipped on a calendar day", from: [db.dbo.catalog_sales.cs_ship_date_sk], to: [db.dbo.date_dim.d_date_sk],
}

