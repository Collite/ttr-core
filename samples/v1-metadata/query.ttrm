model query schema query

def query active_items { description: "List of currently valid items", sourceText: """sql
SELECT
  i_item_sk,
  i_item_id,
  i_product_name,
  i_current_price
FROM item
WHERE i_rec_end_date IS NULL
ORDER BY i_product_name;
""", search { patterns: ["(list of |)(all |)(active|current) (items|products)"], examples: ["List all active products"], }}

def query active_promotion__filter { description: "Synthetic query materialising the row filter of entity active_promotion.", sourceText: "SELECT * FROM promotion WHERE p_discount_active = 'Y'", tags: ["synthetic", "where-filter"],}

def query basket_size_by_store { description: "Average basket size and value per store in a year", sourceText: """sql
SELECT
  s.s_store_name,
  COUNT(DISTINCT ss.ss_ticket_number) AS baskets,
  SUM(ss.ss_quantity) * 1.0 / COUNT(DISTINCT ss.ss_ticket_number) AS avg_units_per_basket,
  SUM(ss.ss_ext_sales_price) / COUNT(DISTINCT ss.ss_ticket_number) AS avg_basket_value
FROM store_sales ss
JOIN store s ON s.s_store_sk = ss.ss_store_sk
JOIN date_dim d ON d.d_date_sk = ss.ss_sold_date_sk
WHERE d.d_year = {year}
GROUP BY s.s_store_name
ORDER BY avg_basket_value DESC;
""", search { patterns: ["(average |)basket (size|value) (by|per) store (in |)({year}|)"], }
    parameters: [
        { name: year, type: int, label: "Year" },
    ]
}

def query brand_revenue_by_year { description: "Store revenue of a brand by year, read through the item's denormalised brand column", sourceText: """sql
-- TPC-DS keeps the brand name on item itself (i_brand); the model normalises it into item_brand.
SELECT
  d.d_year,
  i.i_brand,
  SUM(ss.ss_ext_sales_price) AS revenue
FROM store_sales ss
JOIN item i ON i.i_item_sk = ss.ss_item_sk
JOIN date_dim d ON d.d_date_sk = ss.ss_sold_date_sk
WHERE i.i_brand COLLATE Latin1_General_CI_AI LIKE CONCAT('%', {brand_name}, '%')
GROUP BY d.d_year, i.i_brand
ORDER BY d.d_year;
""", search { patterns: ["(yearly |)revenue of (the |)brand {brand_name} (by|per) year"], }
    parameters: [
        { name: brand_name, type: varchar, label: "Brand name" },
    ]
}

def query brands_per_class { description: "Classes carried under more than one brand", sourceText: """sql
SELECT
  cl.i_class,
  COUNT(DISTINCT b.i_brand_id) AS brand_count
FROM item_class cl
JOIN item_brand b ON b.i_class_id = cl.i_class_id
GROUP BY cl.i_class
HAVING COUNT(DISTINCT b.i_brand_id) > 1
ORDER BY brand_count DESC;
""", search { patterns: ["(classes|class) with (more than one|several|multiple) brands"], }}

def query bulk_catalog_order__filter { description: "Synthetic query materialising the row filter of entity bulk_catalog_order.", sourceText: "SELECT * FROM catalog_sales WHERE cs_quantity >= 50", tags: ["synthetic", "where-filter"],}

def query bulk_marketplace_orders { description: "The 50 largest marketplace order lines of at least 50 units", sourceText: """sql
SELECT TOP 50
  cs.cs_order_number,
  i.i_product_name,
  c.c_customer_id,
  cs.cs_quantity,
  cs.cs_ext_sales_price
FROM catalog_sales cs
JOIN item i ON i.i_item_sk = cs.cs_item_sk
LEFT JOIN customer c ON c.c_customer_sk = cs.cs_bill_customer_sk
WHERE cs.cs_quantity >= 50
ORDER BY cs.cs_quantity DESC, cs.cs_ext_sales_price DESC;
""", search { patterns: ["(largest|bulk) marketplace order(s| lines)"], }}

def query call_center__filter { description: "Synthetic query materialising the row filter of entity call_center.", sourceText: "SELECT * FROM call_center WHERE cc_rec_end_date IS NULL", tags: ["synthetic", "where-filter"],}

def query call_centers_by_state { description: "Current seller support centers in a state", sourceText: """sql
SELECT
  cc_call_center_id,
  cc_name,
  cc_class,
  cc_employees,
  cc_city
FROM call_center
WHERE cc_rec_end_date IS NULL
  AND ({state} = '' OR cc_state = {state})
ORDER BY cc_name;
""", search { patterns: ["(seller |)support centers (in|of) {state}"], }
    parameters: [
        { name: state, type: varchar, label: "State" },
    ]
}

def query catalog_pages { description: "Pages of a marketplace catalog", sourceText: """sql
SELECT
  cp_catalog_page_number,
  cp_department,
  cp_description,
  cp_type
FROM catalog_page
WHERE cp_catalog_number = {catalog_number}
ORDER BY cp_catalog_page_number;
""", search { patterns: ["pages (of|in) (the |)catalog {catalog_number}"], }
    parameters: [
        { name: catalog_number, type: int, label: "Catalog number" },
    ]
}

def query category_class_tree { description: "Product categories with their classes and the number of items in each", sourceText: """sql
SELECT
  c.i_category,
  cl.i_class,
  COUNT(i.i_item_sk) AS item_count
FROM item_category c
JOIN item_class cl ON cl.i_category_id = c.i_category_id
LEFT JOIN item i ON i.i_class_id = cl.i_class_id AND i.i_rec_end_date IS NULL
GROUP BY c.i_category, cl.i_class
ORDER BY c.i_category, cl.i_class;
""", search { patterns: ["(product |)(category|categories) (and|with) (their |)class(es|)"], examples: ["Show the product categories with their classes"], }}

def query channel_revenue_monthly { description: "Monthly revenue by channel for a range of years; channel is store, web, marketplace, or all", sourceText: """sql
WITH monthly AS (
    SELECT CAST('store' AS VARCHAR(16)) AS channel, d.d_year, d.d_moy, SUM(ss.ss_ext_sales_price) AS revenue
    FROM store_sales ss JOIN date_dim d ON ss.ss_sold_date_sk = d.d_date_sk
    WHERE d.d_year BETWEEN {year_from} AND {year_to}
    GROUP BY d.d_year, d.d_moy
    UNION ALL
    SELECT CAST('web' AS VARCHAR(16)), d.d_year, d.d_moy, SUM(ws.ws_ext_sales_price)
    FROM web_sales ws JOIN date_dim d ON ws.ws_sold_date_sk = d.d_date_sk
    WHERE d.d_year BETWEEN {year_from} AND {year_to}
    GROUP BY d.d_year, d.d_moy
    UNION ALL
    SELECT CAST('marketplace' AS VARCHAR(16)), d.d_year, d.d_moy, SUM(cs.cs_ext_sales_price)
    FROM catalog_sales cs JOIN date_dim d ON cs.cs_sold_date_sk = d.d_date_sk
    WHERE d.d_year BETWEEN {year_from} AND {year_to}
    GROUP BY d.d_year, d.d_moy
)
SELECT channel, d_year, d_moy, revenue
FROM monthly
WHERE {channel} = 'all' OR channel = {channel}
ORDER BY d_year, d_moy, channel;
""", search { patterns: ["(monthly|month by month) revenue (per|by) channel", "revenue by channel over time"], examples: ["Monthly revenue by channel"], }
    parameters: [
        { name: channel, type: varchar, label: "Channel" },
        { name: year_from, type: int, label: "From year" },
        { name: year_to, type: int, label: "To year" },
    ]
}

def query channel_revenue_yoy { description: "Year-over-year revenue by channel, with the change in percent", sourceText: """sql
WITH cur AS (
    SELECT channel, SUM(ext_sales_price) AS revenue
    FROM channel_sales cs JOIN date_dim d ON d.d_date_sk = cs.sold_date_sk
    WHERE d.d_year = {year}
    GROUP BY channel
), prior AS (
    SELECT channel, SUM(ext_sales_price) AS revenue
    FROM channel_sales cs JOIN date_dim d ON d.d_date_sk = cs.sold_date_sk
    WHERE d.d_year = {prior_year}
    GROUP BY channel
)
SELECT cur.channel,
       cur.revenue AS revenue_current,
       prior.revenue AS revenue_prior,
       (cur.revenue - prior.revenue) / NULLIF(prior.revenue, 0) * 100 AS yoy_pct
FROM cur
JOIN prior ON cur.channel = prior.channel
ORDER BY cur.channel;
""", search { patterns: ["(year over year|year-over-year|yoy) revenue (per|by) channel", "compare revenue {prior_year} (vs|versus|and) {year}"], examples: ["Compare web and marketplace revenue, 2024 vs 2025"], }
    parameters: [
        { name: year, type: int, label: "Year" },
        { name: prior_year, type: int, label: "Prior year" },
    ]
}

def query channel_sales_by_category { description: "Revenue by channel and product category in a year", sourceText: """sql
SELECT
  cs.channel,
  c.i_category,
  SUM(cs.ext_sales_price) AS revenue,
  SUM(cs.quantity) AS units_sold
FROM channel_sales cs
JOIN item i ON i.i_item_sk = cs.item_sk
JOIN item_category c ON c.i_category_id = i.i_category_id
JOIN date_dim d ON d.d_date_sk = cs.sold_date_sk
WHERE d.d_year = {year}
GROUP BY cs.channel, c.i_category
ORDER BY cs.channel, revenue DESC;
""", search { patterns: ["revenue by channel and category (in |)({year}|)"], }
    parameters: [
        { name: year, type: int, label: "Year" },
    ]
}

def query closed_stores { description: "Stores that have closed, with the closing date", sourceText: """sql
SELECT
  s.s_store_id,
  s.s_store_name,
  s.s_city,
  d.d_date AS closed_on,
  DATEDIFF(day, d.d_date, GETDATE()) AS days_closed
FROM store s
JOIN date_dim d ON d.d_date_sk = s.s_closed_date_sk
WHERE s.s_closed_date_sk IS NOT NULL
ORDER BY d.d_date DESC;
""", search { patterns: ["(closed|shut) stores", "which stores (have |)closed"], }}

def query customer_channel_overlap { description: "How many customers buy in one, two or all three channels in a year", sourceText: """sql
SELECT
  channels_used,
  COUNT(*) AS customers
FROM (
    SELECT
      ccs_customer_sk,
      CASE WHEN ccs_store_sales > 0 THEN 1 ELSE 0 END
        + CASE WHEN ccs_web_sales > 0 THEN 1 ELSE 0 END
        + CASE WHEN ccs_catalog_sales > 0 THEN 1 ELSE 0 END AS channels_used
    FROM customer_channel_summary
    WHERE ccs_year = {year}
) t
GROUP BY channels_used
ORDER BY channels_used;
""", search { patterns: ["(customer |)channel overlap (in |)({year}|)", "customers buying in (several|more) channels"], }
    parameters: [
        { name: year, type: int, label: "Year" },
    ]
}

def query customer_detail { description: "Detail of a customer with the current address and demographics", sourceText: """sql
SELECT
  c.c_customer_id,
  c.c_salutation,
  c.c_first_name,
  c.c_last_name,
  c.c_email_address,
  c.c_birth_year,
  ca.ca_city,
  ca.ca_state,
  cd.cd_gender,
  cd.cd_marital_status,
  cd.cd_education_status
FROM customer c
LEFT JOIN customer_address ca ON ca.ca_address_sk = c.c_current_addr_sk
LEFT JOIN customer_demographics cd ON cd.cd_demo_sk = c.c_current_cdemo_sk
WHERE c.c_customer_id = {customer_code};
""", search { patterns: ["(detail|details|profile) (of|for) (the |)customer {customer_code}"], }
    parameters: [
        { name: customer_code, type: varchar, label: "Customer code" },
    ]
}

def query customer_logins { description: "Customers with a web login whose e-mail domain matches", sourceText: """sql
SELECT
  c_customer_id,
  c_login,
  c_email_address
FROM customer
WHERE c_login IS NOT NULL
  AND c_email_address LIKE CONCAT('%@', {email_domain})
ORDER BY c_login;
""", search { patterns: ["customers with (an |)e-?mail (at|on|from) {email_domain}"], }
    parameters: [
        { name: email_domain, type: varchar, label: "E-mail domain" },
    ]
}

def query customer_names_unicode { description: "Customers whose last name matches a national-character pattern", sourceText: """sql
SELECT
  c_customer_id,
  UPPER(LTRIM(RTRIM(c_last_name))) AS last_name,
  LEN(c_first_name) AS first_name_length,
  SUBSTRING(c_email_address, CHARINDEX('@', c_email_address) + 1, 100) AS email_domain
FROM customer
WHERE c_last_name LIKE N'%' + {last_name_part} + N'%'
  AND COALESCE(c_birth_country, N'UNKNOWN') <> N'UNKNOWN'
ORDER BY last_name;
""", search { patterns: ["customers (whose|with) last name (containing|like) {last_name_part}"], }
    parameters: [
        { name: last_name_part, type: varchar, label: "Part of the last name" },
    ]
}

def query customer_purchases { description: "All purchases of a customer across the store, web and marketplace channels", sourceText: """sql
-- Store purchases
SELECT CAST('store' AS VARCHAR(16)) AS channel,
       ss.ss_ticket_number AS basket_number,
       d.d_date AS purchase_date,
       i.i_product_name AS product,
       ss.ss_quantity AS quantity,
       ss.ss_ext_sales_price AS amount
FROM store_sales ss
JOIN date_dim d ON d.d_date_sk = ss.ss_sold_date_sk
JOIN item i ON i.i_item_sk = ss.ss_item_sk
JOIN customer c ON c.c_customer_sk = ss.ss_customer_sk
WHERE ({customer_sk} = '' OR c.c_customer_sk = {customer_sk})
  AND c.c_customer_id = {customer_code}
UNION ALL
-- Web purchases (billed customer)
SELECT CAST('web' AS VARCHAR(16)),
       ws.ws_order_number,
       d.d_date,
       i.i_product_name,
       ws.ws_quantity,
       ws.ws_ext_sales_price
FROM web_sales ws
JOIN date_dim d ON d.d_date_sk = ws.ws_sold_date_sk
JOIN item i ON i.i_item_sk = ws.ws_item_sk
JOIN customer c ON c.c_customer_sk = ws.ws_bill_customer_sk
WHERE ({customer_sk} = '' OR c.c_customer_sk = {customer_sk})
  AND c.c_customer_id = {customer_code}
UNION ALL
-- Marketplace purchases (billed customer)
SELECT CAST('marketplace' AS VARCHAR(16)),
       cs.cs_order_number,
       d.d_date,
       i.i_product_name,
       cs.cs_quantity,
       cs.cs_ext_sales_price
FROM catalog_sales cs
JOIN date_dim d ON d.d_date_sk = cs.cs_sold_date_sk
JOIN item i ON i.i_item_sk = cs.cs_item_sk
JOIN customer c ON c.c_customer_sk = cs.cs_bill_customer_sk
WHERE ({customer_sk} = '' OR c.c_customer_sk = {customer_sk})
  AND c.c_customer_id = {customer_code}
ORDER BY purchase_date DESC;
""", search { patterns: ["(all |)purchases of (the |)customer {customer_code}", "what did (the |)customer {customer_code} buy"], }
    parameters: [
        { name: customer_sk, type: varchar },
        { name: customer_code, type: varchar, label: "Customer code" },
    ]
}

def query customer_returns { description: "All returns of a customer across channels", sourceText: """sql
-- Store returns
SELECT 'store' AS channel, sr.sr_ticket_number AS basket_number, d.d_date AS returned_on,
       r.r_reason_desc AS reason, sr.sr_return_amt AS amount
FROM store_returns sr
JOIN date_dim d ON d.d_date_sk = sr.sr_returned_date_sk
LEFT JOIN reason r ON r.r_reason_sk = sr.sr_reason_sk
JOIN customer c ON c.c_customer_sk = sr.sr_customer_sk
WHERE c.c_customer_id = {customer_code}
UNION ALL
-- Web returns
SELECT 'web', wr.wr_order_number, d.d_date, r.r_reason_desc, wr.wr_return_amt
FROM web_returns wr
JOIN date_dim d ON d.d_date_sk = wr.wr_returned_date_sk
LEFT JOIN reason r ON r.r_reason_sk = wr.wr_reason_sk
JOIN customer c ON c.c_customer_sk = wr.wr_returning_customer_sk
WHERE c.c_customer_id = {customer_code}
UNION ALL
-- Marketplace returns
SELECT 'marketplace', cr.cr_order_number, d.d_date, r.r_reason_desc, cr.cr_return_amount
FROM catalog_returns cr
JOIN date_dim d ON d.d_date_sk = cr.cr_returned_date_sk
LEFT JOIN reason r ON r.r_reason_sk = cr.cr_reason_sk
JOIN customer c ON c.c_customer_sk = cr.cr_returning_customer_sk
WHERE c.c_customer_id = {customer_code}
ORDER BY returned_on DESC;
""", search { patterns: ["(all |)returns of (the |)customer {customer_code}"], }
    parameters: [
        { name: customer_code, type: varchar, label: "Customer code" },
    ]
}

def query customers_by_birth_decade { description: "Number of customers by decade of birth", sourceText: """sql
SELECT
  CASE
    WHEN c_birth_year IS NULL THEN 'unknown'
    WHEN c_birth_year < 1950 THEN 'before 1950'
    ELSE CONCAT(CAST((c_birth_year / 10) * 10 AS VARCHAR(4)), 's')
  END AS birth_decade,
  COUNT(*) AS customers
FROM customer
GROUP BY CASE
    WHEN c_birth_year IS NULL THEN 'unknown'
    WHEN c_birth_year < 1950 THEN 'before 1950'
    ELSE CONCAT(CAST((c_birth_year / 10) * 10 AS VARCHAR(4)), 's')
  END
ORDER BY birth_decade;
""", search { patterns: ["customers by (decade of birth|birth decade|age group)"], }}

def query customers_by_city { description: "Customers living in a city", sourceText: """sql
SELECT
  c.c_customer_id,
  c.c_first_name,
  c.c_last_name,
  ca.ca_city,
  ca.ca_state
FROM customer c
JOIN customer_address ca ON ca.ca_address_sk = c.c_current_addr_sk
WHERE ca.ca_city COLLATE Latin1_General_CI_AI LIKE CONCAT('%', {city}, '%')
  AND ca.ca_gmt_offset IN (-5.00, -6.00)
ORDER BY c.c_last_name, c.c_first_name;
""", search { patterns: ["customers (in|from|living in) {city}"], examples: ["Customers living in Fairview"], }
    parameters: [
        { name: city, type: varchar, label: "City" },
    ]
}

def query customers_by_income_band { description: "Number of customers per household income band", sourceText: """sql
SELECT
  ib.ib_lower_bound,
  ib.ib_upper_bound,
  COUNT(c.c_customer_sk) AS customers
FROM income_band ib
LEFT JOIN household_demographics hd ON hd.hd_income_band_sk = ib.ib_income_band_sk
LEFT JOIN customer c ON c.c_current_hdemo_sk = hd.hd_demo_sk
GROUP BY ib.ib_lower_bound, ib.ib_upper_bound
ORDER BY ib.ib_lower_bound;
""", search { patterns: ["customers (by|per) income band"], }}

def query customers_by_last_name { description: "Customers whose last name contains a text", sourceText: """sql
SELECT
  c_customer_id,
  c_first_name,
  c_last_name,
  c_email_address
FROM customer
WHERE ('{last_name}' = '' OR c_last_name LIKE '%{last_name}%')
ORDER BY c_last_name, c_first_name;
""", search { patterns: ["customers (named|called|with (the |)last name) {last_name}"], }
    parameters: [
        { name: last_name, type: varchar, label: "Last name" },
    ]
}

def query daily_revenue_running_total { description: "Daily store revenue with a running total for a month", sourceText: """sql
SELECT
  d.d_date,
  SUM(ss.ss_ext_sales_price) AS revenue,
  SUM(SUM(ss.ss_ext_sales_price)) OVER (ORDER BY d.d_date ROWS BETWEEN UNBOUNDED PRECEDING AND CURRENT ROW) AS running_total
FROM store_sales ss
JOIN date_dim d ON d.d_date_sk = ss.ss_sold_date_sk
WHERE d.d_year = {year}
  AND d.d_moy = {month}
GROUP BY d.d_date
ORDER BY d.d_date;
""", search { patterns: ["(daily revenue|running total) (for|in) {month}/{year}"], }
    parameters: [
        { name: year, type: int, label: "Year" },
        { name: month, type: int, label: "Month" },
    ]
}

def query email_promotion__filter { description: "Synthetic query materialising the row filter of entity email_promotion.", sourceText: "SELECT * FROM promotion WHERE p_channel_email = 'Y'", tags: ["synthetic", "where-filter"],}

def query express_ship_mode__filter { description: "Synthetic query materialising the row filter of entity express_ship_mode.", sourceText: "SELECT * FROM ship_mode WHERE sm_type IN ('EXPRESS', 'NEXT DAY')", tags: ["synthetic", "where-filter"],}

def query fiscal_quarters { description: "Quarters of a year with their first and last day", sourceText: """sql
SELECT DISTINCT
  d_quarter_name,
  MIN(d_date) OVER (PARTITION BY d_quarter_name) AS first_day,
  MAX(d_date) OVER (PARTITION BY d_quarter_name) AS last_day
FROM date_dim
WHERE d_fy_year = {year}
ORDER BY d_quarter_name;
""", search { patterns: ["(fiscal |)quarters (of|in) {year}"], }
    parameters: [
        { name: year, type: int, label: "Year" },
    ]
}

def query foreign_address__filter { description: "Synthetic query materialising the row filter of entity foreign_address.", sourceText: "SELECT * FROM customer_address WHERE ca_country <> 'United States'", tags: ["synthetic", "where-filter"],}

def query holiday__filter { description: "Synthetic query materialising the row filter of entity holiday.", sourceText: "SELECT * FROM date_dim WHERE d_holiday = 'Y'", tags: ["synthetic", "where-filter"],}

def query holiday_sales { description: "Store revenue on public holidays in a year", sourceText: """sql
SELECT
  d.d_date,
  d.d_day_name,
  SUM(ss.ss_ext_sales_price) AS revenue
FROM store_sales ss
JOIN date_dim d ON d.d_date_sk = ss.ss_sold_date_sk
WHERE d.d_year = {year}
  AND d.d_holiday = 'Y'
GROUP BY d.d_date, d.d_day_name
ORDER BY d.d_date;
""", search { patterns: ["(sales|revenue) on (public |)holidays (in |)({year}|)"], }
    parameters: [
        { name: year, type: int, label: "Year" },
    ]
}

def query holidays_in_year { description: "Public holidays of a year", sourceText: """sql
SELECT
  d_date,
  d_day_name,
  d_quarter_name
FROM date_dim
WHERE d_year = {year}
  AND d_holiday = 'Y'
ORDER BY d_date;
""", search { patterns: ["(public |)holidays (in|of) {year}"], }
    parameters: [
        { name: year, type: int, label: "Year" },
    ]
}

def query income_bands { description: "List of household income bands", sourceText: """sql
SELECT
  ib_income_band_sk,
  ib_lower_bound,
  ib_upper_bound
FROM income_band
ORDER BY ib_lower_bound;
""", search { patterns: ["(list of |)income bands"], }}

def query inventory_trend { description: "Weekly on-hand stock of an item summed over all distribution centers", sourceText: """sql
SELECT
  d.d_week_seq,
  MIN(d.d_date) AS week_start,
  SUM(inv.inv_quantity_on_hand) AS quantity_on_hand
FROM inventory inv
JOIN item i ON i.i_item_sk = inv.inv_item_sk
JOIN date_dim d ON d.d_date_sk = inv.inv_date_sk
WHERE i.i_item_id = {item_code}
GROUP BY d.d_week_seq
ORDER BY d.d_week_seq;
""", search { patterns: ["(stock|inventory) trend (of|for) (the |)(item|product) {item_code}"], }
    parameters: [
        { name: item_code, type: varchar, label: "Item code" },
    ]
}

def query item__filter { description: "Synthetic query materialising the row filter of entity item.", sourceText: "SELECT * FROM item WHERE i_rec_end_date IS NULL", tags: ["synthetic", "where-filter"],}

def query item_detail { description: "Detail of an item with its category, class and brand", sourceText: """sql
SELECT
  i.i_item_id,
  i.i_product_name,
  i.i_item_desc,
  i.i_size,
  i.i_color,
  i.i_container,
  i.i_current_price,
  c.i_category,
  cl.i_class,
  b.i_brand
FROM item i
LEFT JOIN item_category c ON c.i_category_id = i.i_category_id
LEFT JOIN item_class cl ON cl.i_class_id = i.i_class_id
LEFT JOIN item_brand b ON b.i_brand_id = i.i_brand_id
WHERE i.i_rec_end_date IS NULL
  AND i.i_item_id = {item_code};
""", search { patterns: ["(detail|details|everything) (of|about) (the |)(item|product) {item_code}"], }
    parameters: [
        { name: item_code, type: varchar, label: "Item code" },
    ]
}

def query item_margin { description: "Price margin of current items within a category", sourceText: """sql
-- Margin = (price - wholesale cost) / price, in percent, one decimal
SELECT
  i.i_item_id,
  i.i_product_name,
  i.i_current_price,
  i.i_wholesale_cost,
  CAST(ROUND((i.i_current_price - i.i_wholesale_cost) * 100.0
    / NULLIF(i.i_current_price, 0), 1) AS DECIMAL(18,1)) AS margin_pct
FROM item i
JOIN item_category c ON c.i_category_id = i.i_category_id
WHERE i.i_rec_end_date IS NULL
  AND c.i_category COLLATE Latin1_General_CI_AI LIKE CONCAT('%', {category_name}, '%')
ORDER BY margin_pct DESC;
""", search { patterns: ["(price |)margin of (items|products) in (the |)category {category_name}"], }
    parameters: [
        { name: category_name, type: varchar, label: "Category name" },
    ]
}

def query item_price_history_for_item { description: "Price history of an item", sourceText: """sql
SELECT
  i.i_item_id,
  i.i_product_name,
  ph.iph_valid_from,
  ph.iph_valid_to,
  ph.iph_current_price,
  ph.iph_wholesale_cost
FROM item_price_history ph
JOIN item i ON i.i_item_sk = ph.iph_item_sk
WHERE i.i_item_id = {item_code}
ORDER BY ph.iph_valid_from DESC;
""", search { patterns: ["price history (of|for) (the |)(item|product) {item_code}"], }
    parameters: [
        { name: item_code, type: varchar, label: "Item code" },
    ]
}

def query items_by_manufacturer { description: "Items made by a manufacturer, with their brand", sourceText: """sql
SELECT
  m.i_manufact,
  b.i_brand,
  i.i_item_id,
  i.i_product_name
FROM item i
JOIN item_manufacturer m ON m.i_manufact_id = i.i_manufact_id
LEFT JOIN item_brand b ON b.i_brand_id = i.i_brand_id
WHERE ({manufact_id} = '' OR m.i_manufact_id = {manufact_id})
  AND m.i_manufact COLLATE Latin1_General_CI_AI LIKE CONCAT('%', {manufacturer_name}, '%')
ORDER BY b.i_brand, i.i_product_name;
""", search { patterns: ["(items|products) (made by|from) (the |)manufacturer {manufacturer_name}"], }
    parameters: [
        { name: manufact_id, type: varchar },
        { name: manufacturer_name, type: varchar, label: "Manufacturer name" },
    ]
}

def query items_in_category { description: "Items in a product category", sourceText: """sql
SELECT
  i.i_item_sk,
  i.i_item_id,
  i.i_product_name,
  c.i_category
FROM item i
JOIN item_category c ON c.i_category_id = i.i_category_id
WHERE i.i_rec_end_date IS NULL
  AND c.i_category COLLATE Latin1_General_CI_AI LIKE CONCAT('%', {category_name}, '%')
ORDER BY i.i_product_name;
""", search { patterns: ["(which|what) (items|products) (are in|belong to) (the |)category {category_name}"], examples: ["Which products belong to the category Electronics?"], }
    parameters: [
        { name: category_name, type: varchar, label: "Category name" },
    ]
}

def query items_in_class { description: "Items in a product class", sourceText: """sql
SELECT
  i.i_item_sk,
  i.i_item_id,
  i.i_product_name,
  cl.i_class,
  c.i_category
FROM item i
JOIN item_class cl ON cl.i_class_id = i.i_class_id
JOIN item_category c ON c.i_category_id = cl.i_category_id
WHERE ({class_id} = '' OR i.i_class_id = {class_id})
  AND cl.i_class COLLATE Latin1_General_CI_AI LIKE CONCAT('%', {class_name}, '%')
ORDER BY c.i_category, i.i_product_name;
""", search { patterns: ["(items|products) (in|of) (the |)class {class_name}"], }
    parameters: [
        { name: class_id, type: varchar },
        { name: class_name, type: varchar, label: "Class name" },
    ]
}

def query items_of_brand { description: "Items sold under a brand", sourceText: """sql
SELECT
  i.i_item_sk,
  i.i_item_id,
  i.i_product_name,
  b.i_brand,
  i.i_current_price
FROM item i
JOIN item_brand b ON b.i_brand_id = i.i_brand_id
WHERE i.i_rec_end_date IS NULL
  AND b.i_brand COLLATE Latin1_General_CI_AI LIKE CONCAT('%', {brand_name}, '%')
ORDER BY i.i_product_name;
""", search { patterns: ["(items|products) (of|from|by) (the |)brand {brand_name}"], examples: ["Products of the brand amalgamalg #1"], }
    parameters: [
        { name: brand_name, type: varchar, label: "Brand name" },
    ]
}

def query items_without_sales { description: "Current items with no store or web sale in a year", sourceText: """sql
SELECT
  i.i_item_id,
  i.i_product_name
FROM item i
WHERE i.i_rec_end_date IS NULL
  AND NOT EXISTS (
    SELECT 1 FROM store_sales ss
    JOIN date_dim d ON d.d_date_sk = ss.ss_sold_date_sk
    WHERE ss.ss_item_sk = i.i_item_sk
      AND d.d_year = {year}
  )
  AND NOT EXISTS (
    SELECT 1 FROM web_sales ws
    JOIN date_dim d ON d.d_date_sk = ws.ws_sold_date_sk
    WHERE ws.ws_item_sk = i.i_item_sk
      AND d.d_year = {year}
  )
ORDER BY i.i_product_name;
""", search { patterns: ["(items|products) (with no|without) (sales|a sale) in {year}"], }
    parameters: [
        { name: year, type: int, label: "Year" },
    ]
}

def query large_warehouse__filter { description: "Synthetic query materialising the row filter of entity large_warehouse.", sourceText: "SELECT * FROM warehouse WHERE w_warehouse_sq_ft >= 500000", tags: ["synthetic", "where-filter"],}

def query loss_making_store_return__filter { description: "Synthetic query materialising the row filter of entity loss_making_store_return.", sourceText: "SELECT * FROM store_returns WHERE sr_net_loss > 0", tags: ["synthetic", "where-filter"],}

def query loss_making_store_returns { description: "The ten store returns with the highest net loss", sourceText: """sql
SELECT TOP 10
  sr.sr_ticket_number,
  s.s_store_name,
  i.i_product_name,
  sr.sr_net_loss,
  sr.sr_fee,
  sr.sr_refunded_cash,
  sr.sr_store_credit
FROM store_returns sr
JOIN store s ON s.s_store_sk = sr.sr_store_sk
JOIN item i ON i.i_item_sk = sr.sr_item_sk
WHERE sr.sr_net_loss > 0
ORDER BY sr.sr_net_loss DESC;
""", search { patterns: ["(top |)store returns with the (highest|largest) (net |)loss"], }}

def query low_days_of_cover { description: "Items whose stock covers less than a week of sales in the latest week", sourceText: """sql
SELECT
  w.w_warehouse_name,
  i.i_item_id,
  i.i_product_name,
  iws.iws_avg_on_hand,
  iws.iws_days_of_cover
FROM inventory_weekly_summary iws
JOIN item i ON i.i_item_sk = iws.iws_item_sk
JOIN warehouse w ON w.w_warehouse_sk = iws.iws_warehouse_sk
WHERE iws.iws_days_of_cover < 7.0
  AND iws.iws_week_seq = (SELECT MAX(iws_week_seq) FROM inventory_weekly_summary)
ORDER BY iws.iws_days_of_cover;
""", search { patterns: ["(items|products) with (low|less than a week of) (stock |)cover"], }}

def query marketplace_orders_by_catalog_page { description: "Marketplace orders by catalog page of a catalog", sourceText: """sql
SELECT
  cp.cp_catalog_page_number,
  cp.cp_department,
  COUNT(DISTINCT cs.cs_order_number) AS orders,
  SUM(cs.cs_quantity) AS units
FROM catalog_sales cs
JOIN catalog_page cp ON cp.cp_catalog_page_sk = cs.cs_catalog_page_sk
WHERE cp.cp_catalog_number = {catalog_number}
GROUP BY cp.cp_catalog_page_number, cp.cp_department
ORDER BY cp.cp_catalog_page_number;
""", search { patterns: ["(marketplace |)orders (by|per) (catalog |)page (of|in) catalog {catalog_number}"], }
    parameters: [
        { name: catalog_number, type: int, label: "Catalog number" },
    ]
}

def query marketplace_returns_by_warehouse { description: "Marketplace returns processed by a distribution center", sourceText: """sql
SELECT
  w.w_warehouse_name,
  r.r_reason_desc,
  COUNT(*) AS return_lines,
  SUM(cr.cr_return_amount) AS amount_returned,
  SUM(cr.cr_return_ship_cost) AS return_shipping
FROM catalog_returns cr
JOIN warehouse w ON w.w_warehouse_sk = cr.cr_warehouse_sk
LEFT JOIN reason r ON r.r_reason_sk = cr.cr_reason_sk
WHERE w.w_warehouse_name COLLATE Latin1_General_CI_AI LIKE CONCAT('%', {warehouse_name}, '%')
GROUP BY w.w_warehouse_name, r.r_reason_desc
ORDER BY amount_returned DESC;
""", search { patterns: ["marketplace returns (processed |)(by|at|in) (the |)(distribution center|DC|warehouse) {warehouse_name}"], }
    parameters: [
        { name: warehouse_name, type: varchar, label: "Distribution center" },
    ]
}

def query marketplace_revenue_by_call_center { description: "Marketplace revenue handled by each seller support center in a year", sourceText: """sql
SELECT
  cc.cc_call_center_id,
  cc.cc_name,
  cc.cc_class,
  SUM(cs.cs_ext_sales_price) AS revenue,
  SUM(cs.cs_net_profit) AS net_profit
FROM catalog_sales cs
JOIN call_center cc ON cc.cc_call_center_sk = cs.cs_call_center_sk
JOIN date_dim d ON d.d_date_sk = cs.cs_sold_date_sk
WHERE d.d_year = {year}
GROUP BY cc.cc_call_center_id, cc.cc_name, cc.cc_class
ORDER BY revenue DESC;
""", search { patterns: ["marketplace revenue (by|per) (seller |)support center (in |)({year}|)"], }
    parameters: [
        { name: year, type: int, label: "Year" },
    ]
}

def query most_expensive_items { description: "The 20 most expensive current items", sourceText: """sql
SELECT TOP 20
  i_item_id,
  i_product_name,
  i_current_price
FROM item
WHERE i_rec_end_date IS NULL
ORDER BY i_current_price DESC;
""", search { patterns: ["(top |)(20 |)most expensive (items|products)"], }}

def query new_customers_by_month { description: "Number of customers by month of their first purchase", sourceText: """sql
SELECT
  d.d_year,
  d.d_moy,
  COUNT(*) AS new_customers
FROM customer c
JOIN date_dim d ON d.d_date_sk = c.c_first_sales_date_sk
WHERE d.d_year = {year}
GROUP BY d.d_year, d.d_moy
ORDER BY d.d_moy;
""", search { patterns: ["new customers (by|per) month (in |)({year}|)"], }
    parameters: [
        { name: year, type: int, label: "Year" },
    ]
}

def query orders_by_ship_mode { description: "Marketplace order lines and shipping cost by ship mode type in a year", sourceText: """sql
SELECT
  sm.sm_type,
  sm.sm_carrier,
  COUNT(*) AS order_lines,
  SUM(cs.cs_ext_ship_cost) AS shipping_cost
FROM catalog_sales cs
JOIN ship_mode sm ON sm.sm_ship_mode_sk = cs.cs_ship_mode_sk
JOIN date_dim d ON d.d_date_sk = cs.cs_sold_date_sk
WHERE d.d_year = {year}
GROUP BY sm.sm_type, sm.sm_carrier
ORDER BY shipping_cost DESC;
""", search { patterns: ["(orders|shipping cost) (by|per) ship mode (in |)({year}|)"], }
    parameters: [
        { name: year, type: int, label: "Year" },
    ]
}

def query orders_shipped_late { description: "Web orders shipped more than a number of days after they were placed", sourceText: """sql
SELECT
  ws.ws_order_number,
  sold.d_date AS ordered_on,
  shipped.d_date AS shipped_on,
  DATEDIFF(day, sold.d_date, shipped.d_date) AS days_to_ship,
  sm.sm_type,
  w.w_warehouse_name
FROM web_sales ws
JOIN date_dim sold ON sold.d_date_sk = ws.ws_sold_date_sk
JOIN date_dim shipped ON shipped.d_date_sk = ws.ws_ship_date_sk
JOIN ship_mode sm ON sm.sm_ship_mode_sk = ws.ws_ship_mode_sk
JOIN warehouse w ON w.w_warehouse_sk = ws.ws_warehouse_sk
WHERE DATEDIFF(day, sold.d_date, shipped.d_date) > {days}
  AND sm.sm_type NOT IN ('LIBRARY')
ORDER BY days_to_ship DESC;
""", search { patterns: ["(web |)orders shipped (late|more than {days} days after ordering)"], }
    parameters: [
        { name: days, type: int, label: "Days" },
    ]
}

def query preferred_customer__filter { description: "Synthetic query materialising the row filter of entity preferred_customer.", sourceText: "SELECT * FROM customer WHERE c_preferred_cust_flag = 'Y'", tags: ["synthetic", "where-filter"],}

def query preferred_customers_by_state { description: "Preferred customers whose current address is in a state", sourceText: """sql
SELECT
  c.c_customer_id,
  c.c_first_name,
  c.c_last_name,
  ca.ca_city
FROM customer c
JOIN customer_address ca ON ca.ca_address_sk = c.c_current_addr_sk
WHERE c.c_preferred_cust_flag = 'Y'
  and ca.ca_state = {state}
ORDER BY ca.ca_city, c.c_last_name;
""", search { patterns: ["preferred customers in {state}"], }
    parameters: [
        { name: state, type: varchar, label: "State" },
    ]
}

def query promotion_items { description: "Items taking part in a promotion, with their discount", sourceText: """sql
SELECT
  p.p_promo_id,
  p.p_promo_name,
  i.i_item_id,
  i.i_product_name,
  pi.pi_discount_pct
FROM promotion_item pi
JOIN promotion p ON p.p_promo_sk = pi.pi_promo_sk
JOIN item i ON i.i_item_sk = pi.pi_item_sk
WHERE p.p_promo_id = {promo_code}
ORDER BY pi.pi_discount_pct DESC;
""", search { patterns: ["(items|products) in (the |)promotion {promo_code}"], }
    parameters: [
        { name: promo_code, type: varchar, label: "Promotion code" },
    ]
}

def query promotion_lift { description: "Store revenue of a promotion's featured item with and without the promotion", sourceText: """sql
/* Lift = revenue on lines carrying the promotion vs. lines of the same item without it. */
SELECT
  p.p_promo_name,
  i.i_product_name,
  SUM(CASE WHEN ss.ss_promo_sk = p.p_promo_sk THEN ss.ss_ext_sales_price ELSE 0 END) AS revenue_with_promo,
  SUM(CASE WHEN ss.ss_promo_sk IS NULL THEN ss.ss_ext_sales_price ELSE 0 END) AS revenue_without_promo
FROM promotion p
JOIN item i ON i.i_item_sk = p.p_item_sk
JOIN store_sales ss ON ss.ss_item_sk = p.p_item_sk
WHERE p.p_promo_name COLLATE Latin1_General_CI_AI LIKE CONCAT('%', {promo_name}, '%')
GROUP BY p.p_promo_name, i.i_product_name;
""", search { patterns: ["(lift|effect) of (the |)promotion {promo_name}"], }
    parameters: [
        { name: promo_name, type: varchar, label: "Promotion name" },
    ]
}

def query promotions_by_media { description: "Number of promotions run in each medium", sourceText: """sql
SELECT
  SUM(CASE WHEN p_channel_dmail = 'Y' THEN 1 ELSE 0 END) AS direct_mail,
  SUM(CASE WHEN p_channel_email = 'Y' THEN 1 ELSE 0 END) AS email,
  SUM(CASE WHEN p_channel_catalog = 'Y' THEN 1 ELSE 0 END) AS catalog,
  SUM(CASE WHEN p_channel_tv = 'Y' THEN 1 ELSE 0 END) AS tv,
  SUM(CASE WHEN p_channel_radio = 'Y' THEN 1 ELSE 0 END) AS radio,
  SUM(CASE WHEN p_channel_press = 'Y' THEN 1 ELSE 0 END) AS press,
  SUM(CASE WHEN p_channel_event = 'Y' THEN 1 ELSE 0 END) AS event
FROM promotion;
""", search { patterns: ["promotions (by|per) (medium|media|channel)"], }}

def query promotions_running_today { description: "Promotions running today", sourceText: """sql
SELECT
  p.p_promo_id,
  p.p_promo_name,
  ds.d_date AS starts_on,
  de.d_date AS ends_on
FROM promotion p
JOIN date_dim ds ON ds.d_date_sk = p.p_start_date_sk
JOIN date_dim de ON de.d_date_sk = p.p_end_date_sk
WHERE CAST(GETDATE() AS DATE) BETWEEN ds.d_date AND de.d_date
ORDER BY de.d_date;
""", search { patterns: ["(which |)promotions (are |)running (today|now)"], examples: ["Which promotions are running today?"], }}

def query quarterly_catalog_page__filter { description: "Synthetic query materialising the row filter of entity quarterly_catalog_page.", sourceText: "SELECT * FROM catalog_page WHERE cp_type = 'quarterly'", tags: ["synthetic", "where-filter"],}

def query return_rate_by_category { description: "Store return rate by product category in a year", sourceText: """sql
SELECT
  c.i_category,
  SUM(ss.ss_ext_sales_price) AS revenue,
  SUM(ISNULL(sr.sr_return_amt, 0)) AS returned,
  ROUND(SUM(ISNULL(sr.sr_return_amt, 0)) * 100.0 / NULLIF(SUM(ss.ss_ext_sales_price), 0), 2) AS return_rate_pct
FROM store_sales ss
LEFT JOIN store_returns sr ON sr.sr_item_sk = ss.ss_item_sk AND sr.sr_ticket_number = ss.ss_ticket_number
JOIN item i ON i.i_item_sk = ss.ss_item_sk
JOIN item_category c ON c.i_category_id = i.i_category_id
JOIN date_dim d ON d.d_date_sk = ss.ss_sold_date_sk
WHERE d.d_year = {year}
GROUP BY c.i_category
ORDER BY return_rate_pct DESC;
""", search { patterns: ["return rate (by|per) (product |)category (in |)({year}|)"], }
    parameters: [
        { name: year, type: int, label: "Year" },
    ]
}

def query return_reasons { description: "List of all return reasons", sourceText: """sql
SELECT
  r_reason_sk,
  r_reason_id,
  r_reason_desc
FROM reason
ORDER BY r_reason_id;
""", search { patterns: ["(list of |)(all |)return reasons"], examples: ["List of all return reasons"], }}

def query returns_by_reason { description: "Returned amount by return reason across channels in a year", sourceText: """sql
SELECT reason, SUM(amount) AS amount_returned, SUM(units) AS units_returned
FROM (
    SELECT r.r_reason_desc AS reason, sr.sr_return_amt AS amount, sr.sr_return_quantity AS units
    FROM store_returns sr
    JOIN reason r ON r.r_reason_sk = sr.sr_reason_sk
    JOIN date_dim d ON d.d_date_sk = sr.sr_returned_date_sk
    WHERE d.d_year = {year}
    UNION ALL
    SELECT r.r_reason_desc, wr.wr_return_amt, wr.wr_return_quantity
    FROM web_returns wr
    JOIN reason r ON r.r_reason_sk = wr.wr_reason_sk
    JOIN date_dim d ON d.d_date_sk = wr.wr_returned_date_sk
    WHERE d.d_year = {year}
    UNION ALL
    SELECT r.r_reason_desc, cr.cr_return_amount, cr.cr_return_quantity
    FROM catalog_returns cr
    JOIN reason r ON r.r_reason_sk = cr.cr_reason_sk
    JOIN date_dim d ON d.d_date_sk = cr.cr_returned_date_sk
    WHERE d.d_year = {year}
) all_returns
GROUP BY reason
ORDER BY amount_returned DESC;
""", search { patterns: ["returns (by|per) reason (in |)({year}|)", "why (do|did) customers return (goods|items)"], }
    parameters: [
        { name: year, type: int, label: "Year" },
    ]
}

def query revenue_by_customer_age { description: "Store revenue by customer age band in a year; age derived from the birth year", sourceText: """sql
SELECT
  CASE
    WHEN {year} - c.c_birth_year < 30 THEN 'under 30'
    WHEN {year} - c.c_birth_year < 50 THEN '30-49'
    WHEN {year} - c.c_birth_year < 70 THEN '50-69'
    ELSE '70 and over'
  END AS age_band,
  SUM(ss.ss_ext_sales_price) AS revenue
FROM store_sales ss
JOIN customer c ON c.c_customer_sk = ss.ss_customer_sk
JOIN date_dim d ON d.d_date_sk = ss.ss_sold_date_sk
WHERE d.d_year = {year}
  AND c.c_birth_year IS NOT NULL
GROUP BY CASE
    WHEN {year} - c.c_birth_year < 30 THEN 'under 30'
    WHEN {year} - c.c_birth_year < 50 THEN '30-49'
    WHEN {year} - c.c_birth_year < 70 THEN '50-69'
    ELSE '70 and over'
  END
ORDER BY age_band;
""", search { patterns: ["revenue by (customer |)age (band|group) (in |)({year}|)"], }
    parameters: [
        { name: year, type: int, label: "Year" },
    ]
}

def query revenue_by_demographics { description: "Store revenue by gender and marital status in a year", sourceText: """sql
SELECT
  cd.cd_gender,
  cd.cd_marital_status,
  COUNT(DISTINCT ss.ss_customer_sk) AS customers,
  SUM(ss.ss_ext_sales_price) AS revenue
FROM store_sales ss
JOIN customer_demographics cd ON cd.cd_demo_sk = ss.ss_cdemo_sk
JOIN date_dim d ON d.d_date_sk = ss.ss_sold_date_sk
WHERE d.d_year = {year}
GROUP BY cd.cd_gender, cd.cd_marital_status
ORDER BY revenue DESC;
""", search { patterns: ["revenue by (gender|marital status|demographics) (in |)({year}|)"], }
    parameters: [
        { name: year, type: int, label: "Year" },
    ]
}

def query revenue_by_state { description: "Web and marketplace revenue by the billing state of the customer in a year", sourceText: """sql
SELECT
  ca.ca_state,
  SUM(cs.ext_sales_price) AS revenue
FROM channel_sales cs
JOIN customer c ON c.c_customer_sk = cs.customer_sk
JOIN customer_address ca ON ca.ca_address_sk = c.c_current_addr_sk
JOIN date_dim d ON d.d_date_sk = cs.sold_date_sk
WHERE d.d_year = {year}
  AND cs.channel IN ('web', 'marketplace')
GROUP BY ca.ca_state
ORDER BY revenue DESC;
""", search { patterns: ["revenue (by|per) (customer |)state (in |)({year}|)"], }
    parameters: [
        { name: year, type: int, label: "Year" },
    ]
}

def query sales_by_hour { description: "Store revenue by hour of the day in a year", sourceText: """sql
SELECT
  t.t_hour,
  t.t_am_pm,
  COUNT(DISTINCT ss.ss_ticket_number) AS baskets,
  SUM(ss.ss_ext_sales_price) AS revenue
FROM store_sales ss
JOIN time_dim t ON t.t_time_sk = ss.ss_sold_time_sk
JOIN date_dim d ON d.d_date_sk = ss.ss_sold_date_sk
WHERE d.d_year = {year}
GROUP BY t.t_hour, t.t_am_pm
ORDER BY t.t_hour;
""", search { patterns: ["(store |)(sales|revenue) by hour (of (the |)day|) (in |)({year}|)"], }
    parameters: [
        { name: year, type: int, label: "Year" },
    ]
}

def query ship_modes { description: "List of ship modes", sourceText: """sql
SELECT
  sm_ship_mode_sk,
  sm_type,
  sm_code,
  sm_carrier
FROM ship_mode
ORDER BY sm_type, sm_carrier;
""", search { patterns: ["(list of |)ship(ping|) modes"], }}

def query stock_on_hand { description: "Latest on-hand stock of an item in a distribution center", sourceText: """sql
SELECT
  i.i_item_id,
  i.i_product_name,
  w.w_warehouse_name,
  inv.inv_quantity_on_hand,
  d.d_date AS as_of
FROM inventory inv
JOIN item i ON i.i_item_sk = inv.inv_item_sk
JOIN warehouse w ON w.w_warehouse_sk = inv.inv_warehouse_sk
JOIN date_dim d ON d.d_date_sk = inv.inv_date_sk
WHERE i.i_item_id = {item_code}
  AND w.w_warehouse_name COLLATE Latin1_General_CI_AI LIKE CONCAT('%', {warehouse_name}, '%')
  AND inv.inv_date_sk = (
    SELECT MAX(inv2.inv_date_sk)
    FROM inventory inv2
    WHERE inv2.inv_item_sk = inv.inv_item_sk
      AND inv2.inv_warehouse_sk = inv.inv_warehouse_sk
  );
""", search { patterns: ["(stock|stock on hand|how many) (of |)(the |)(item|product) {item_code} (in|at) {warehouse_name}"], }
    parameters: [
        { name: item_code, type: varchar, label: "Item code" },
        { name: warehouse_name, type: varchar, label: "Distribution center" },
    ]
}

def query stockout_weeks { description: "Weeks in which an item ran out of stock in a distribution center", sourceText: """sql
SELECT
  iws.iws_week_seq,
  i.i_item_id,
  i.i_product_name,
  iws.iws_avg_on_hand,
  iws.iws_units_sold
FROM inventory_weekly_summary iws
JOIN item i ON i.i_item_sk = iws.iws_item_sk
JOIN warehouse w ON w.w_warehouse_sk = iws.iws_warehouse_sk
WHERE iws.iws_min_on_hand = 0
  AND w.w_warehouse_name COLLATE Latin1_General_CI_AI LIKE CONCAT('%', {warehouse_name}, '%')
ORDER BY iws.iws_week_seq DESC, i.i_item_id;
""", search { patterns: ["stock[- ]?outs (in|at) (the |)(distribution center|DC|warehouse) {warehouse_name}", "(which |)(items|products) ran out of stock (in|at) {warehouse_name}"], }
    parameters: [
        { name: warehouse_name, type: varchar, label: "Distribution center" },
    ]
}

def query store__filter { description: "Synthetic query materialising the row filter of entity store.", sourceText: "SELECT * FROM store WHERE s_rec_end_date IS NULL", tags: ["synthetic", "where-filter"],}

def query store_assortment { description: "Items currently listed in a store's assortment", sourceText: """sql
SELECT
  i.i_item_id,
  i.i_product_name,
  d.d_date AS listed_on,
  sia.sia_min_stock
FROM store_item_assortment sia
JOIN store s ON s.s_store_sk = sia.sia_store_sk
JOIN item i ON i.i_item_sk = sia.sia_item_sk
JOIN date_dim d ON d.d_date_sk = sia.sia_listed_date_sk
WHERE sia.sia_delisted_date_sk IS NULL
  AND s.s_store_name COLLATE Latin1_General_CI_AI LIKE CONCAT('%', {store_name}, '%')
ORDER BY i.i_product_name;
""", search { patterns: ["(assortment|items listed) (of|in) (the |)store {store_name}"], }
    parameters: [
        { name: store_name, type: varchar, label: "Store name" },
    ]
}

def query store_plan_vs_actual { description: "Store revenue against plan, by category, for a year", sourceText: """sql
WITH actual AS (
    SELECT ss.ss_store_sk AS store_sk, i.i_category_id AS category_id, SUM(ss.ss_ext_sales_price) AS revenue
    FROM store_sales ss
    JOIN item i ON i.i_item_sk = ss.ss_item_sk
    JOIN date_dim d ON d.d_date_sk = ss.ss_sold_date_sk
    WHERE d.d_year = {year}
    GROUP BY ss.ss_store_sk, i.i_category_id
), plan_total AS (
    SELECT ssp_store_sk AS store_sk, ssp_category_id AS category_id, SUM(ssp_planned_sales) AS planned
    FROM store_sales_plan
    WHERE ssp_year = {year}
    GROUP BY ssp_store_sk, ssp_category_id
)
SELECT
  s.s_store_name,
  c.i_category,
  p.planned,
  a.revenue,
  CASE WHEN p.planned > 0
       THEN ROUND(a.revenue * 100.0 / p.planned, 1)
  END AS plan_fulfilment_pct
FROM plan_total p
LEFT JOIN actual a ON a.store_sk = p.store_sk AND a.category_id = p.category_id
JOIN store s ON s.s_store_sk = p.store_sk
JOIN item_category c ON c.i_category_id = p.category_id
ORDER BY s.s_store_name, c.i_category;
""", search { patterns: ["(store |)(revenue |)plan (vs|versus|against) actual (in |for |)({year}|)"], }
    parameters: [
        { name: year, type: int, label: "Year" },
    ]
}

def query store_return_rate { description: "Return rate of each store in a year", sourceText: """sql
WITH sales AS (
    SELECT ss_store_sk AS store_sk, SUM(ss_ext_sales_price) AS revenue
    FROM store_sales ss JOIN date_dim d ON d.d_date_sk = ss.ss_sold_date_sk
    WHERE d.d_year = {year}
    GROUP BY ss_store_sk
), returned AS (
    SELECT sr_store_sk AS store_sk, SUM(sr_return_amt) AS amount
    FROM store_returns sr JOIN date_dim d ON d.d_date_sk = sr.sr_returned_date_sk
    WHERE d.d_year = {year}
    GROUP BY sr_store_sk
)
SELECT
  s.s_store_name,
  sales.revenue,
  ISNULL(returned.amount, 0) AS returned_amount,
  CAST(ISNULL(returned.amount, 0) * 100.0 / NULLIF(sales.revenue, 0) AS DECIMAL(18,2)) AS return_rate_pct
FROM sales
JOIN store s ON s.s_store_sk = sales.store_sk
LEFT JOIN returned ON returned.store_sk = sales.store_sk
ORDER BY return_rate_pct DESC;
""", search { patterns: ["return rate (of|by|per) store(s|) (in |)({year}|)"], }
    parameters: [
        { name: year, type: int, label: "Year" },
    ]
}

def query store_returns_by_reason { description: "Store returns of a store by return reason", sourceText: """sql
SELECT
  r.r_reason_desc,
  COUNT(*) AS return_lines,
  SUM(sr.sr_return_quantity) AS units_returned,
  SUM(sr.sr_return_amt) AS amount_returned
FROM store_returns sr
JOIN reason r ON r.r_reason_sk = sr.sr_reason_sk
JOIN store s ON s.s_store_sk = sr.sr_store_sk
WHERE s.s_store_name COLLATE Latin1_General_CI_AI LIKE CONCAT('%', {store_name}, '%')
GROUP BY r.r_reason_desc
ORDER BY amount_returned DESC;
""", search { patterns: ["returns (of|in|at) (the |)store {store_name} by reason"], }
    parameters: [
        { name: store_name, type: varchar, label: "Store name" },
    ]
}

def query store_revenue_by_month { description: "Monthly revenue of a store in a year", sourceText: """sql
SELECT
  d.d_year,
  d.d_moy,
  SUM(ss.ss_ext_sales_price) AS revenue,
  SUM(ss.ss_quantity) AS units_sold
FROM store_sales ss
JOIN date_dim d ON d.d_date_sk = ss.ss_sold_date_sk
JOIN store s ON s.s_store_sk = ss.ss_store_sk
WHERE d.d_year = {year}
  AND s.s_store_name COLLATE Latin1_General_CI_AI LIKE CONCAT('%', {store_name}, '%')
GROUP BY d.d_year, d.d_moy
ORDER BY d.d_moy;
""", search { patterns: ["(monthly revenue|revenue by month) (of|for) (the |)store {store_name} in {year}"], }
    parameters: [
        { name: store_name, type: varchar, label: "Store name" },
        { name: year, type: int, label: "Year" },
    ]
}

def query store_sales_with_coupons { description: "Store sales lines paid partly with a coupon in a year", sourceText: """sql
SELECT
  ss.ss_ticket_number,
  i.i_product_name,
  ss.ss_ext_sales_price,
  ss.ss_coupon_amt,
  ss.ss_net_paid_inc_tax
FROM store_sales ss
JOIN item i ON i.i_item_sk = ss.ss_item_sk
JOIN date_dim d ON d.d_date_sk = ss.ss_sold_date_sk
WHERE d.d_year = {year}
  AND ss.ss_coupon_amt > 0
ORDER BY ss.ss_coupon_amt DESC;
""", search { patterns: ["(store |)sales (paid |)with (a |)coupon(s|) (in |)({year}|)"], }
    parameters: [
        { name: year, type: int, label: "Year" },
    ]
}

def query stores_by_state { description: "Open stores in a state", sourceText: """sql
SELECT
  [s].[s_store_id] AS [Store code],
  [s].[s_store_name] AS [Store name],
  [s].[s_city] AS [City],
  [s].[s_floor_space] AS [Floor space]
FROM [store] AS [s]
WHERE [s].[s_rec_end_date] IS NULL
  AND [s].[s_closed_date_sk] IS NULL
  AND [s].[s_state] = {state}
ORDER BY [s].[s_city];
""", search { patterns: ["(open |)stores in {state}"], examples: ["Open stores in TN"], }
    parameters: [
        { name: state, type: varchar, label: "State" },
    ]
}

def query stores_in_division { description: "Stores of a division, through their markets", sourceText: """sql
SELECT
  dv.s_division_name,
  m.s_market_desc,
  s.s_store_name,
  s.s_state
FROM store s
JOIN store_market m ON m.s_market_id = s.s_market_id
JOIN store_division dv ON dv.s_division_id = m.s_division_id
WHERE s.s_rec_end_date IS NULL
  AND dv.s_division_name COLLATE Latin1_General_CI_AI LIKE CONCAT('%', {division_name}, '%')
ORDER BY m.s_market_desc, s.s_store_name;
""", search { patterns: ["stores (in|of) (the |)division {division_name}"], }
    parameters: [
        { name: division_name, type: varchar, label: "Division name" },
    ]
}

def query stores_in_market { description: "Stores serving a market", sourceText: """sql
SELECT
  s.s_store_sk,
  s.s_store_id,
  s.s_store_name,
  s.s_city,
  m.s_market_desc
FROM store s
JOIN store_market m ON m.s_market_id = s.s_market_id
WHERE s.s_rec_end_date IS NULL
  AND ({market_id} = '' OR m.s_market_id = {market_id})
  AND m.s_market_desc COLLATE Latin1_General_CI_AI LIKE CONCAT('%', {market_name}, '%')
ORDER BY s.s_store_name;
""", search { patterns: ["stores (in|of|serving) (the |)market {market_name}"], }
    parameters: [
        { name: market_id, type: varchar },
        { name: market_name, type: varchar, label: "Market name" },
    ]
}

def query top_customers_by_revenue { description: "The 25 customers with the highest revenue across channels in a year", sourceText: """sql
SELECT TOP 25
  c.c_customer_id,
  c.c_first_name,
  c.c_last_name,
  s.ccs_store_sales + s.ccs_web_sales + s.ccs_catalog_sales AS total_revenue,
  ROW_NUMBER() OVER (ORDER BY s.ccs_store_sales + s.ccs_web_sales + s.ccs_catalog_sales DESC) AS revenue_rank
FROM customer_channel_summary s
JOIN customer c ON c.c_customer_sk = s.ccs_customer_sk
WHERE s.ccs_year = {year}
ORDER BY revenue_rank;
""", search { patterns: ["top (25 |)customers (by revenue|) (in |)({year}|)", "best customers (in |)({year}|)"], examples: ["Top 25 customers in 2025"], }
    parameters: [
        { name: year, type: int, label: "Year" },
    ]
}

def query top_items_page { description: "One page of current items ordered by price", sourceText: """sql
SELECT
  i_item_id,
  i_product_name,
  i_current_price
FROM item
WHERE i_rec_end_date IS NULL
ORDER BY i_current_price DESC
OFFSET {page_offset} ROWS FETCH NEXT 25 ROWS ONLY;
""", search { patterns: ["(next |)page of (items|products) (by price|)"], }
    parameters: [
        { name: page_offset, type: int, label: "Offset" },
    ]
}

def query top_items_per_category { description: "The five best-selling items of each category in a year", sourceText: """sql
WITH item_revenue AS (
    SELECT
      c.i_category,
      i.i_product_name,
      SUM(cs.ext_sales_price) AS revenue,
      ROW_NUMBER() OVER (PARTITION BY c.i_category ORDER BY SUM(cs.ext_sales_price) DESC) AS rn
    FROM channel_sales cs
    JOIN item i ON i.i_item_sk = cs.item_sk
    JOIN item_category c ON c.i_category_id = i.i_category_id
    JOIN date_dim d ON d.d_date_sk = cs.sold_date_sk
    WHERE d.d_year = {year}
    GROUP BY c.i_category, i.i_product_name
)
SELECT i_category, i_product_name, revenue, rn
FROM item_revenue
WHERE rn <= 5
ORDER BY i_category, rn;
""", search { patterns: ["(top|best[- ]selling) (5 |five |)(items|products) (per|of each|in each) category (in |)({year}|)"], examples: ["Top 5 products per category in 2025"], }
    parameters: [
        { name: year, type: int, label: "Year" },
    ]
}

def query top_stores_by_revenue { description: "The ten stores with the highest revenue in a year", sourceText: """sql
SELECT TOP 10
  s.s_store_id,
  s.s_store_name,
  SUM(ss.ss_ext_sales_price) AS revenue
FROM store_sales ss
JOIN store s ON s.s_store_sk = ss.ss_store_sk
JOIN date_dim d ON d.d_date_sk = ss.ss_sold_date_sk
WHERE d.d_year = {year}
GROUP BY s.s_store_id, s.s_store_name
ORDER BY revenue DESC;
""", search { patterns: ["top (10 |ten |)stores (by|with the highest) revenue (in |)({year}|)"], examples: ["Top 10 stores by revenue in 2025"], }
    parameters: [
        { name: year, type: int, label: "Year" },
    ]
}

def query warehouse_fulfilment_volume { description: "Units shipped by each distribution center for the web and the marketplace in a year", sourceText: """sql
SELECT w.w_warehouse_name, x.channel, SUM(x.units) AS units_shipped
FROM (
    SELECT ws_warehouse_sk AS warehouse_sk, 'web' AS channel, ws_quantity AS units, ws_sold_date_sk AS date_sk
    FROM web_sales
    UNION ALL
    SELECT cs_warehouse_sk, 'marketplace', cs_quantity, cs_sold_date_sk
    FROM catalog_sales
) x
JOIN warehouse w ON w.w_warehouse_sk = x.warehouse_sk
JOIN date_dim d ON d.d_date_sk = x.date_sk
WHERE d.d_year = {year}
GROUP BY w.w_warehouse_name, x.channel
ORDER BY w.w_warehouse_name, x.channel;
""", search { patterns: ["(units shipped|fulfilment volume) (by|per) (distribution center|DC|warehouse) (in |)({year}|)"], }
    parameters: [
        { name: year, type: int, label: "Year" },
    ]
}

def query warehouses { description: "List of distribution centers", sourceText: """sql
SELECT
  w_warehouse_sk,
  w_warehouse_id,
  w_warehouse_name,
  w_warehouse_sq_ft,
  w_city,
  w_state
FROM warehouse
ORDER BY w_warehouse_name;
""", search { patterns: ["(list of |)(all |)(distribution centers|DCs|warehouses)"], examples: ["List all distribution centers"], }}

def query web_clickstream_sessions { description: "Web page views per session of a day", sourceText: """sql
SELECT
  wcs_user_sk,
  COUNT(*) AS page_views
FROM web_clickstreams
WHERE wcs_click_date_sk = {date_sk}
GROUP BY wcs_user_sk
ORDER BY page_views DESC;
""", search { patterns: ["web (sessions|page views) on {date_sk}"], }
    parameters: [
        { name: date_sk, type: int, label: "Day" },
    ]
}

def query web_orders_by_page_type { description: "Web orders by the type of page they were placed on", sourceText: """sql
SELECT
  wp.wp_type,
  COUNT(DISTINCT ws.ws_order_number) AS orders,
  AVG(ws.ws_ext_sales_price) AS avg_line_amount
FROM web_sales ws
JOIN web_page wp ON wp.wp_web_page_sk = ws.ws_web_page_sk
JOIN date_dim d ON d.d_date_sk = ws.ws_sold_date_sk
WHERE d.d_year = {year}
  AND wp.wp_autogen_flag = 'N'
GROUP BY wp.wp_type
ORDER BY orders DESC;
""", search { patterns: ["web orders (by|per) page type (in |)({year}|)"], }
    parameters: [
        { name: year, type: int, label: "Year" },
    ]
}

def query web_page__filter { description: "Synthetic query materialising the row filter of entity web_page.", sourceText: "SELECT * FROM web_page WHERE wp_rec_end_date IS NULL", tags: ["synthetic", "where-filter"],}

def query web_returns_for_reason { description: "Web returns with a given reason", sourceText: """sql
SELECT
  wr.wr_order_number,
  i.i_product_name,
  d.d_date AS returned_on,
  wr.wr_return_quantity,
  wr.wr_return_amt,
  wr.wr_account_credit
FROM web_returns wr
JOIN reason r ON r.r_reason_sk = wr.wr_reason_sk
JOIN item i ON i.i_item_sk = wr.wr_item_sk
JOIN date_dim d ON d.d_date_sk = wr.wr_returned_date_sk
WHERE ({reason_id} = '' OR r.r_reason_id = {reason_id})
  AND r.r_reason_desc COLLATE Latin1_General_CI_AI LIKE CONCAT('%', {reason}, '%')
ORDER BY d.d_date DESC;
""", search { patterns: ["web returns (because of|for|with (the |)reason) {reason}"], }
    parameters: [
        { name: reason_id, type: varchar },
        { name: reason, type: varchar, label: "Return reason" },
    ]
}

def query web_revenue_by_site { description: "Web revenue by web site in a year", sourceText: """sql
SELECT
  w.web_site_id,
  w.web_name,
  COUNT(DISTINCT ws.ws_order_number) AS orders,
  SUM(ws.ws_ext_sales_price) AS revenue
FROM web_sales ws
JOIN web_site w ON w.web_site_sk = ws.ws_web_site_sk
JOIN date_dim d ON d.d_date_sk = ws.ws_sold_date_sk
WHERE d.d_year = {year}
GROUP BY w.web_site_id, w.web_name
ORDER BY revenue DESC;
""", search { patterns: ["web revenue (by|per) (web |)site (in |)({year}|)"], }
    parameters: [
        { name: year, type: int, label: "Year" },
    ]
}

def query web_site__filter { description: "Synthetic query materialising the row filter of entity web_site.", sourceText: "SELECT * FROM web_site WHERE web_rec_end_date IS NULL", tags: ["synthetic", "where-filter"],}

def query weekend_day__filter { description: "Synthetic query materialising the row filter of entity weekend_day.", sourceText: "SELECT * FROM date_dim WHERE d_weekend = 'Y'", tags: ["synthetic", "where-filter"],}

def query weekend_vs_weekday_sales { description: "Store revenue on weekend days versus weekdays in a year", sourceText: """sql
SELECT
  CASE WHEN d.d_weekend = 'Y' THEN 'weekend' ELSE 'weekday' END AS day_type,
  COUNT(DISTINCT d.d_date_sk) AS days,
  SUM(ss.ss_ext_sales_price) AS revenue,
  SUM(ss.ss_ext_sales_price) / COUNT(DISTINCT d.d_date_sk) AS revenue_per_day
FROM store_sales ss
JOIN date_dim d ON d.d_date_sk = ss.ss_sold_date_sk
WHERE d.d_year = {year}
GROUP BY CASE WHEN d.d_weekend = 'Y' THEN 'weekend' ELSE 'weekday' END;
""", search { patterns: ["weekend (vs|versus) weekday (sales|revenue) (in |)({year}|)"], }
    parameters: [
        { name: year, type: int, label: "Year" },
    ]
}
