// CN-P8 portable AM-45…49 diagnostic corpus; every negative is intentional.
model cn
def subkind TemporalTicket { of: Ticket, definition: """created < :as_of""" }
def subkind DuplicateWeb { of: Ticket, definition: """code = 'web'""" }
def kind OtherTicket { grounds: er.entity.ticket }
def quality other_code { of: OtherTicket, value_space: Channel, grounds: er.entity.ticket.channel }
def subkind OnlyWeb { of: OtherTicket, definition: """other_code = 'web'""" }
def kind LegacyWeb { is_a: Ticket, members: """code = 'web'""" }
def event Duration { extent: durative, period: { start: created, end: closed } }
def event Instant { extent: instantaneous, period: { at: created } }
def phase BrokenBounds { of: Ticket, from: Started }
def phase WrongParticipant { of: Warehouse, from: Started, until: Finished }
def phase MissingSubject { of: Item, grounds: er.entity.outage, period: { start: since, end: until } }
def quality InvalidProjection { of: Item, per: Channel, from: ListPrice.amount }
def quality MissingQuality { of: Item, valued_state: true, from: ListPrice.absent }
def kind InvalidLifetime { period: { at: created } }
// review-175 F6 (⚑C): a per-less projection of a two-participant relator reads one row per (Item, Channel).
def quality flat_price { of: Item, valued_state: true, from: ListPrice.amount }
// review-175 F15: a subkind specializes a rigid bearer; a phase is not one.
def subkind OpenWeb { of: OpenTicket, definition: """code = 'web'""" }
// review-175 R4 (⚑R4): coverage is counted by participant — two an Item can be is ambiguous, with or without `per: Item`.
def kind Twin { grounds: er.entity.price, involves: [Item as left, Item as right], qualities: [gap] }
def quality gap { of: Twin, grounds: er.entity.price.amount }
def quality twin_gap { of: Item, valued_state: true, from: Twin.gap }
def quality twin_gap_per { of: Item, valued_state: true, per: Item, from: Twin.gap }
// review-175 re-review 2 N1 (⚑N1): an event bound has one participant its bearer can be — `Reopened` has two.
def event Reopened { involves: [Ticket, Ticket as parent], period: { at: occurred } }
def phase Reopening { of: Ticket, from: Reopened, until: Finished }
