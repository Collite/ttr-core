package hartland.stores
model lexicon locale en

def term customer     { for: cn.Customer,       forms: ["customer"] }
def term party        { for: cn.Party,          forms: ["party"] }
def term debtor       { for: cn.DebtorCustomer, forms: ["debtor", "customer"], default: true }
def term debtor_party { for: cn.DebtorCustomer, forms: ["party in debt", "party"], default: true }
def term lapsed_party { for: cn.LapsedParty,    forms: ["party"] }
def term lapsed       { for: cn.LapsedParty,    forms: ["lapsed"], default: true }
