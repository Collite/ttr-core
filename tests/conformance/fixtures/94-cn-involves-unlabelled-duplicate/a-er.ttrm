// 0.17 (CN-P2 S2.3) — `cn/involves-unlabelled-duplicate` (error, AM-19 companion): two participants
// of one event whose labels coincide — a label defaults to the concept name lower-cased.
// Expected (sem): cn/involves-unlabelled-duplicate ×2 — the second `Warehouse` of `StockTransfer`
// (both unlabelled) and `Warehouse as warehouse` of `Rebalance` (the first one's default label).
// Near-miss: `Restock` labels both (`as from`, `as to`).
package hartland.stores
model er

def entity item      { attributes: [ def attribute sku { type: text, isKey: true } ] }
def entity warehouse { attributes: [ def attribute warehouse_code { type: text, isKey: true } ] }
def entity transfer {
    attributes: [
        def attribute transfer_id { type: int, isKey: true },
        def attribute shipped_at  { type: timestamp }
    ]
}
