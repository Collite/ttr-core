model db schema dbo

def table t_single_bare {
    primaryKey: S_STORE_SK
    columns: [
        def column S_STORE_SK { type: int, isKey: true }
    ]
}

def table t_bare_list {
    primaryKey: [ID]
    columns: [
        def column ID { type: int, isKey: true }
    ]
}

def table t_bare_multi {
    primaryKey: [ID, CODE]
    columns: [
        def column ID { type: int, isKey: true },
        def column CODE { type: text }
    ]
}

def table t_quoted_legacy {
    primaryKey: ["ID"]
    columns: [
        def column ID { type: int, isKey: true }
    ]
}
