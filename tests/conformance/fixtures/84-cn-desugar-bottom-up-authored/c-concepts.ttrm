// Every concept the blocks of `83-cn-desugar-bottom-up/` declare, with the properties they state.
package hartland.stores
model cn

def kind Party         { label: { en: "Party" } }
def role Buyer         { of: Party, event: Purchase }
def kind Shop          { }
def kind Channel       { }
def event Purchase     { involves: [Buyer, Shop], qualities: [amount] }
def quality amount     { of: Purchase }
def kind Item          { label: { en: "Product" } }
def quality color      { of: Item }
def role Shopper       { of: Party, event: StoreSale }
def kind Brand         { }
def quality net_sales  { of: StoreSale }
def event StoreSale    { involves: [Shopper, Item] }
